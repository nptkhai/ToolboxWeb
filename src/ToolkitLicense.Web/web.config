<?xml version="1.0" encoding="utf-8"?>
<!-- IIS: allow uploads of the desktop installer and update packages (up to 1 GB) on the Releases
     page. The publish step adds the ASP.NET Core handler to this file. -->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="1073741824" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
