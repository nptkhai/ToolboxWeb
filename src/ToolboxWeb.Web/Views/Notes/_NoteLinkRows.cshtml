@model NoteLinkRowsModel
@{
    // One row per address. The rows post as two lists in screen order, so a name and an address
    // stay together by position; notes.js clones the template below for "add a link".
    var rows = Model.Rows.Count > 0 ? Model.Rows : [new NoteLinkRow(string.Empty, string.Empty)];
}
<div class="nv-slot nv-slot-link@(Model.Conditional ? " is-conditional" : null)" data-slot="link">
    <fieldset class="nv-rows" data-rows="link">
        <legend class="tbx-field-label">@T["Notes.Link.Rows"]</legend>

        @foreach (var row in rows)
        {
            <div class="nv-row nv-link-row">
                <input class="form-control nv-row-name" name="LinkNames" value="@row.Name" maxlength="80"
                       placeholder="@T["Notes.Link.NamePlaceholder"]" aria-label="@T["Notes.Link.NameLabel"]"
                       autocomplete="off" />
                @* Not type="url": a line typed before this editor existed may not be an address,
                   and the browser would then refuse to save the whole note. *@
                <input class="form-control nv-row-url" name="LinkUrls" value="@row.Url" maxlength="2000"
                       placeholder="https://" aria-label="@T["Notes.Link.UrlLabel"]" inputmode="url"
                       autocomplete="off" spellcheck="false" data-row-url />
                <span class="nv-row-actions">
                    <a class="btn btn-sm tbx-icon-button" data-row-open href="@(row.IsWeb ? row.Url : null)"
                       target="_blank" rel="noopener noreferrer" title="@T["Notes.Link.Open"]">
                        <tbx-icon name="external-link" />
                        <span class="visually-hidden">@T["Notes.Link.Open"]</span>
                    </a>
                    <button class="btn btn-sm tbx-icon-button" type="button" data-row-copy data-row-field="url" title="@T["Notes.Link.Copy"]">
                        <tbx-icon name="copy" />
                        <span class="visually-hidden">@T["Notes.Link.Copy"]</span>
                    </button>
                    <button class="btn btn-sm tbx-icon-button is-danger" type="button" data-row-remove title="@T["Notes.Row.Remove"]">
                        <tbx-icon name="x" />
                        <span class="visually-hidden">@T["Notes.Row.Remove"]</span>
                    </button>
                </span>
            </div>
        }

        <template data-row-template>
            <div class="nv-row nv-link-row">
                <input class="form-control nv-row-name" name="LinkNames" value="" maxlength="80"
                       placeholder="@T["Notes.Link.NamePlaceholder"]" aria-label="@T["Notes.Link.NameLabel"]"
                       autocomplete="off" />
                <input class="form-control nv-row-url" name="LinkUrls" value="" maxlength="2000"
                       placeholder="https://" aria-label="@T["Notes.Link.UrlLabel"]" inputmode="url"
                       autocomplete="off" spellcheck="false" data-row-url />
                <span class="nv-row-actions">
                    <a class="btn btn-sm tbx-icon-button" data-row-open target="_blank" rel="noopener noreferrer" title="@T["Notes.Link.Open"]">
                        <tbx-icon name="external-link" />
                        <span class="visually-hidden">@T["Notes.Link.Open"]</span>
                    </a>
                    <button class="btn btn-sm tbx-icon-button" type="button" data-row-copy data-row-field="url" title="@T["Notes.Link.Copy"]">
                        <tbx-icon name="copy" />
                        <span class="visually-hidden">@T["Notes.Link.Copy"]</span>
                    </button>
                    <button class="btn btn-sm tbx-icon-button is-danger" type="button" data-row-remove title="@T["Notes.Row.Remove"]">
                        <tbx-icon name="x" />
                        <span class="visually-hidden">@T["Notes.Row.Remove"]</span>
                    </button>
                </span>
            </div>
        </template>

        <div class="nv-rows-foot">
            <button class="btn btn-sm btn-outline-secondary" type="button" data-add-row>
                <tbx-icon name="plus" />
                @T["Notes.Link.Add"]
            </button>
        </div>
    </fieldset>
</div>
