@using System.Text.Json
@using ToolboxWeb.Web.Constants
@model NotesIndexViewModel
@{
    ViewData["Title"] = T["Notes.Title"];

    var formatSlug = Model.ActiveFormat?.Slug;
    string ListUrl(string? format, string? search, int? id = null) =>
        Url.RouteUrl(ToolboxRouteSlugs.RouteNames.NotesHtml, new { format, search, id }) ?? "/notes.html";

    // A phone swaps the list for the detail only when the user actually picked a note.
    var rootClass = "nv-page" + (Model.HasExplicitSelection ? " nv-has-selection" : string.Empty);

    var configJson = JsonSerializer.Serialize(new
    {
        urls = new { reveal = Url.Action("RevealSecret", "Notes") },
        messages = new
        {
            copied = T["Action.Copied"].Value,
            copyFailed = T["Notes.CopyFailed"].Value,
            jsonValid = T["Notes.Tool.JsonValid"].Value,
            jsonInvalid = T["Notes.Tool.JsonInvalid"].Value,
            xmlValid = T["Notes.Tool.XmlValid"].Value,
            xmlInvalid = T["Notes.Tool.XmlInvalid"].Value,
            unsaved = T["Notes.UnsavedWarning"].Value,
            reveal = T["Notes.Server.Reveal"].Value,
            hide = T["Notes.Server.Hide"].Value,
            passwordCopied = T["Notes.Server.PasswordCopied"].Value,
            connectionCopied = T["Notes.Server.ConnectionCopied"].Value,
            hostMissing = T["Notes.Server.HostRequired"].Value,
            networkError = T["Notes.NetworkError"].Value
        }
    }, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
}

@section Styles {
    <link rel="stylesheet" href="~/css/notes.css" asp-append-version="true" />
}

<div class="@rootClass" id="nv-root">
    @Html.AntiForgeryToken()

    <header class="nv-head">
        @* The layout already shows the page title "Ghi chú"; this line only adds the totals. *@
        <p class="nv-summary">
            <strong>@Model.TotalCount</strong> @T["Notes.Summary.Notes"]
            @if (Model.PinnedCount > 0)
            {
                <span class="nv-sep" aria-hidden="true">·</span>
                <strong>@Model.PinnedCount</strong> @T["Notes.Summary.Pinned"]
            }
        </p>

        <form class="nv-search" method="get" action="@ListUrl(null, null)" role="search">
            @if (formatSlug is not null)
            {
                <input type="hidden" name="format" value="@formatSlug" />
            }
            <tbx-icon name="search" class="nv-search-icon" />
            <input class="form-control" type="search" name="search" value="@Model.Search"
                   placeholder="@T["Notes.SearchNotesPlaceholder"]" aria-label="@T["Notes.SearchNotesPlaceholder"]"
                   autocomplete="off" data-shortcut-target="search" />
        </form>

        <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#nv-create" data-shortcut-target="new">
            <tbx-icon name="plus" />
            @T["Notes.New"]
        </button>
    </header>

    @if (!Model.HasAnyNotes)
    {
        <partial name="_EmptyState" model="@(new EmptyStateViewModel(T["Notes.Empty.Hint"].Value, "file-text") { ActionText = T["Notes.Empty.Create"].Value, ActionTarget = "#nv-create" })" />
    }
    else
    {
        <div class="nv-filter-bar">
        <nav class="nv-formats tbx-filter-chips" aria-label="@T["Notes.Format.Label"]">
            <a class="tbx-chip@(Model.ActiveFormat is null ? " is-selected" : null)" href="@ListUrl(null, Model.Search)"
               aria-current="@(Model.ActiveFormat is null ? "page" : null)">
                @T["Notes.FilterAll"]
                <span class="tbx-chip-count">@Model.MatchingCount</span>
            </a>
            @foreach (var entry in Model.FormatCounts)
            {
                var active = Model.ActiveFormat?.Format == entry.Format.Format;
                <a class="tbx-chip @entry.Format.CssClass@(active ? " is-selected" : null)@(entry.Count == 0 ? " is-empty" : null)"
                   href="@ListUrl(entry.Format.Slug, Model.Search)" aria-current="@(active ? "page" : null)">
                    <span class="nv-dot" aria-hidden="true"></span>
                    @T[entry.Format.LabelKey]
                    <span class="tbx-chip-count">@entry.Count</span>
                </a>
            }
        </nav>
        <form class="nv-sort" method="get" action="@ListUrl(null, null)" data-nv-sort>
            @if (formatSlug is not null)
            {
                <input type="hidden" name="format" value="@formatSlug" />
            }
            @if (!string.IsNullOrWhiteSpace(Model.Search))
            {
                <input type="hidden" name="search" value="@Model.Search" />
            }
            <label class="tbx-field-label" for="nv-sort">@T["Notes.Sort.Label"]</label>
            <select class="form-select form-select-sm" id="nv-sort" name="sort">
                <option value="updated" selected="@(Model.Sort == "updated")">@T["Notes.Sort.Updated"]</option>
                <option value="title" selected="@(Model.Sort == "title")">@T["Notes.Sort.Title"]</option>
                <option value="created" selected="@(Model.Sort == "created")">@T["Notes.Sort.Created"]</option>
            </select>
            <noscript><button type="submit" class="btn btn-sm btn-outline-secondary">@T["Checklist.Sort.Apply"]</button></noscript>
        </form>
        </div>

        <div class="nv-body">
            <section class="nv-list" aria-label="@T["Notes.AllNotes"]">
                @if (Model.Items.Count == 0)
                {
                    <div class="tbx-empty" role="status">
                        <span class="tbx-empty-icon"><tbx-icon name="search" size="20" /></span>
                        <p class="tbx-empty-text">@T["Notes.NoMatch.Title"]</p>
                        <a class="btn btn-sm btn-outline-secondary" href="@ListUrl(null, null)">
                            <tbx-icon name="x" />
                            @T["Notes.NoMatch.Clear"]
                        </a>
                    </div>
                }
                else
                {
                    <ul class="nv-items" data-nv-items>
                        @foreach (var item in Model.Items)
                        {
                            <li class="nv-item-row@(item.IsPinned ? " is-pinned" : null)">
                                <a class="nv-item @item.Format.CssClass@(item.IsSelected ? " is-selected" : null)"
                                   href="@ListUrl(formatSlug, Model.Search, item.Id)" aria-current="@(item.IsSelected ? "true" : null)">
                                    <span class="nv-item-head">
                                        <span class="nv-badge">@item.Format.Badge</span>
                                        <span class="nv-item-title">@item.Title</span>
                                        @if (item.ChildCount > 0)
                                        {
                                            <span class="nv-count-pill">@(item.Format.Format == NoteFormat.Server
                                                ? T["Notes.Server.ConnectionCount", item.ChildCount]
                                                : T["Notes.ChildCount", item.ChildCount])</span>
                                        }
                                    </span>
                                    @if (!string.IsNullOrEmpty(item.Preview))
                                    {
                                        <span class="nv-item-preview">@item.Preview</span>
                                    }
                                    <span class="nv-item-foot">
                                        <time datetime="@item.UpdatedUtc.ToString("o")" title="@item.UpdatedUtc.ToDisplayAppDateTime()" data-relative>@item.UpdatedUtc.ToDisplayAppDateTime()</time>
                                        @if (item.MatchedInChild)
                                        {
                                            <span class="nv-match-note">@T["Notes.MatchedInChild"]</span>
                                        }
                                    </span>
                                </a>
                                @* Outside the link: pinning from the list keeps the note that is open. *@
                                <form method="post" asp-action="TogglePin" class="nv-row-pin">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="returnId" value="@Model.Selected?.Id" />
                                    <partial name="_NoteReturnState" model="Model" />
                                    <button class="btn btn-sm tbx-icon-button@(item.IsPinned ? " is-on" : null)" type="submit" aria-pressed="@(item.IsPinned ? "true" : "false")"
                                            title="@(item.IsPinned ? T["Notes.Unpin"] : T["Notes.Pin"])">
                                        <tbx-icon name="pin" label="@(item.IsPinned ? T["Notes.UnpinItem", item.Title] : T["Notes.PinItem", item.Title])" />
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                }
                <p class="nv-hint nv-shortcuts">@T["Notes.Shortcuts"]</p>
            </section>

            <section class="nv-detail">
                @if (Model.Selected is not null)
                {
                    <partial name="_NoteDetail" model="Model" />
                }
                else
                {
                    <div class="tbx-empty" role="status">
                        <span class="tbx-empty-icon"><tbx-icon name="file-text" size="20" /></span>
                        <p class="tbx-empty-text">@T["Notes.NoSelection"]</p>
                    </div>
                }
            </section>
        </div>
    }
</div>

<partial name="_NoteCreateModal" model="Model" />

<script id="nv-config" type="application/json">@Html.Raw(configJson)</script>

@section Scripts {
    <script src="~/js/notes.js" asp-append-version="true"></script>
}
