@model QuickLinksIndexViewModel
@{
    ViewData["Title"] = T["QuickLinks.Title"];
}

<div class="tool-grid">
    <section class="panel span-4">
        <div class="panel-header"><h2>@T["QuickLinks.AddLink"]</h2></div>
        <form asp-action="Create" method="post" class="form-grid">
            <div class="d-grid gap-1">
                <label class="form-label mb-0" for="ql-title">@T["QuickLinks.LabelTitle"]</label>
                <input asp-for="Form.Title" id="ql-title" name="Title" class="form-control" placeholder="@T["QuickLinks.LinkTitlePlaceholder"]" />
            </div>
            <div class="d-grid gap-1">
                <label class="form-label mb-0" for="ql-url">@T["QuickLinks.LabelUrl"]</label>
                <input asp-for="Form.Url" id="ql-url" name="Url" class="form-control" placeholder="@T["QuickLinks.LinkUrlPlaceholder"]" />
            </div>
            <div class="d-grid gap-1">
                <label class="form-label mb-0" for="ql-group">@T["QuickLinks.LabelGroup"]</label>
                <input asp-for="Form.GroupName" id="ql-group" name="GroupName" class="form-control" placeholder="@T["QuickLinks.LinkGroupPlaceholder"]" />
            </div>
            <div class="d-grid gap-1">
                <label class="form-label mb-0" for="ql-sort">@T["QuickLinks.LabelSortOrder"]</label>
                <input asp-for="Form.SortOrder" id="ql-sort" name="SortOrder" class="form-control" placeholder="@T["QuickLinks.LinkSortOrderPlaceholder"]" />
            </div>
            <button class="btn btn-primary" type="submit">@T["Action.Create"]</button>
        </form>
    </section>

    <section class="panel span-8">
        <div class="panel-header"><h2>@T["QuickLinks.Links"]</h2></div>
        <div class="stack">
            @foreach (var link in Model.Links)
            {
                <div class="item-row">
                    <div>
                        <a class="item-title" href="@link.Url" target="_blank" rel="noopener">@link.Title</a>
                        <div class="item-meta">
                            @if (!string.IsNullOrWhiteSpace(link.GroupName))
                            {
                                @($"{link.GroupName} · ")
                            }
                            @link.Url
                        </div>
                    </div>
                    <form asp-action="Delete" method="post">
                        <input type="hidden" name="id" value="@link.Id" />
                        <button class="btn btn-sm btn-outline-danger" type="submit" data-confirm="@T["Confirm.DeleteMessage", link.Title]" data-confirm-title="@T["Confirm.DeleteTitle"]" data-confirm-ok="@T["Action.Delete"]">@T["Action.Delete"]</button>
                    </form>
                </div>
            }
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
