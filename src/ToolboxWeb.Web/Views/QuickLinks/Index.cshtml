@model QuickLinksIndexViewModel
@{
    ViewData["Title"] = T["QuickLinks.Title"];
}

<div class="tool-grid">
    <section class="panel span-4">
        <div class="panel-header"><h2>@T["QuickLinks.AddLink"]</h2></div>
        <form asp-action="Create" method="post" class="form-grid">
            <input asp-for="Form.Title" name="Title" class="form-control" placeholder="@T["QuickLinks.LinkTitlePlaceholder"]" />
            <input asp-for="Form.Url" name="Url" class="form-control" placeholder="@T["QuickLinks.LinkUrlPlaceholder"]" />
            <input asp-for="Form.GroupName" name="GroupName" class="form-control" placeholder="@T["QuickLinks.LinkGroupPlaceholder"]" />
            <input asp-for="Form.SortOrder" name="SortOrder" class="form-control" placeholder="@T["QuickLinks.LinkSortOrderPlaceholder"]" />
            <button class="btn btn-primary" type="submit">@T["Action.Create"]</button>
        </form>
    </section>

    <section class="panel span-8">
        <div class="panel-header"><h2>@T["QuickLinks.Links"]</h2></div>
        <div class="stack">
            @foreach (var link in Model.Links)
            {
                <div class="item-row">
                    <div>
                        <a class="item-title" href="@link.Url" target="_blank" rel="noopener">@link.Title</a>
                        <div class="item-meta">
                            @if (!string.IsNullOrWhiteSpace(link.GroupName))
                            {
                                @link.GroupName <text>&middot; </text>
                            }
                            @link.Url
                        </div>
                    </div>
                    <form asp-action="Delete" method="post">
                        <input type="hidden" name="id" value="@link.Id" />
                        <button class="btn btn-sm btn-outline-danger" type="submit">@T["Action.Delete"]</button>
                    </form>
                </div>
            }
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
