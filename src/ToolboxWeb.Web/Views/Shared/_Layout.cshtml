@using System.Text.Json
@using ToolboxWeb.Web.Constants
@using ToolboxWeb.Web.Services
@inject ICurrentUserService CurrentUser
@{
    var flashSuccessMessage = TempData["SuccessMessage"] as string;
    var flashErrorMessage = TempData["ErrorMessage"] as string;
    var flashNotifications = new List<object>();
    if (!string.IsNullOrEmpty(flashSuccessMessage))
    {
        flashNotifications.Add(new { type = "success", message = flashSuccessMessage });
    }
    if (!string.IsNullOrEmpty(flashErrorMessage))
    {
        flashNotifications.Add(new { type = "error", message = flashErrorMessage });
    }
    var hasFlashNotification = flashNotifications.Count > 0;
}
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b1730" />
    <title>@ViewData["Title"] - @T["App.Name"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/adaptive-background.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (hasFlashNotification)
    {
        <link rel="stylesheet" href="~/vendor/kendo/icons/index.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/vendor/kendo/theme/default-main.css" asp-append-version="true" />
    }
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/vendor-sync.css" asp-append-version="true" />
    <script>
        (function () {
            const theme = localStorage.getItem('toolbox.theme') || 'light';
            document.documentElement.dataset.theme = theme;
        })();
    </script>
</head>
<body>
    <partial name="_AdaptiveBackground" />
    @if (hasFlashNotification)
    {
        <div id="tbx-notification-host" class="tbx-notification-host" aria-hidden="true"></div>
        <script id="tbx-flash-data" type="application/json">@Html.Raw(JsonSerializer.Serialize(flashNotifications))</script>
    }
    @{
        var currentCulture = CultureInfo.CurrentUICulture.Name;
        var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
        var dashboardHref = Url.RouteUrl(ToolboxRouteSlugs.RouteNames.DashboardHtml) ?? "/dashboard.html";
        var jiraDashboardHref = Url.RouteUrl(ToolboxRouteSlugs.RouteNames.JiraDashboardHtml) ?? "/jira-dashboard.html";
        var jiraWorklistHref = Url.RouteUrl(ToolboxRouteSlugs.RouteNames.JiraWorklistHtml) ?? "/jira-worklist.html";
        var notesHref = Url.RouteUrl(ToolboxRouteSlugs.RouteNames.NotesHtml) ?? "/notes.html";
        var checklistHref = Url.RouteUrl(ToolboxRouteSlugs.RouteNames.ChecklistHtml) ?? "/checklist.html";
        var focusTimerHref = Url.RouteUrl(ToolboxRouteSlugs.RouteNames.FocusTimerHtml) ?? "/focus-timer.html";
        var quickLinksHref = Url.RouteUrl(ToolboxRouteSlugs.RouteNames.QuickLinksHtml) ?? "/quick-links.html";
        var componentsHref = Url.RouteUrl(ToolboxRouteSlugs.RouteNames.ComponentsHtml) ?? "/component.html";
        var schemaCompareHref = Url.RouteUrl(ToolboxRouteSlugs.RouteNames.SchemaCompareHtml) ?? "/schema-compare.html";
        var sqlProfilerHref = Url.RouteUrl(ToolboxRouteSlugs.RouteNames.SqlProfilerHtml) ?? "/sql-profiler.html";
        var brandHref = CurrentUser.IsJiraUser ? jiraDashboardHref : dashboardHref;

        // Current sidebar item, by controller/action so it also holds after a POST round-trip
        // and on sub-routes such as /component/{tab}.html.
        var navController = ViewContext.RouteData.Values["controller"] as string ?? string.Empty;
        var navAction = ViewContext.RouteData.Values["action"] as string ?? string.Empty;
        bool IsNav(params string[] controllers) => controllers.Any(c => string.Equals(c, navController, StringComparison.OrdinalIgnoreCase));
        var jiraDashboardActive = IsNav("Jira") && string.Equals(navAction, "DashboardPage", StringComparison.OrdinalIgnoreCase);
        var jiraWorklistActive = IsNav("Jira") && !jiraDashboardActive;
        string? NavClass(bool active) => active ? "active" : null;
        string? NavCurrent(bool active) => active ? "page" : null;
    }
    <div class="app-shell">
        <aside class="app-sidebar">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="brand" href="@brandHref">@T["App.Name"]</a>
                <nav class="side-nav">
                    @if (CurrentUser.IsJiraUser)
                    {
                        <a href="@jiraDashboardHref" class="@NavClass(jiraDashboardActive)" aria-current="@NavCurrent(jiraDashboardActive)">@T["Nav.JiraDashboard"]</a>
                        <a href="@jiraWorklistHref" class="@NavClass(jiraWorklistActive)" aria-current="@NavCurrent(jiraWorklistActive)">@T["Nav.JiraWorklist"]</a>
                    }

                    <a href="@dashboardHref" class="@NavClass(IsNav("Dashboard"))" aria-current="@NavCurrent(IsNav("Dashboard"))">@T["Nav.Dashboard"]</a>
                    <a href="@notesHref" class="@NavClass(IsNav("Notes"))" aria-current="@NavCurrent(IsNav("Notes"))">@T["Nav.Notes"]</a>
                    <a href="@checklistHref" class="@NavClass(IsNav("Checklist"))" aria-current="@NavCurrent(IsNav("Checklist"))">@T["Nav.Checklist"]</a>
                    <a href="@focusTimerHref" class="@NavClass(IsNav("FocusTimer"))" aria-current="@NavCurrent(IsNav("FocusTimer"))">@T["Nav.FocusTimer"]</a>
                    <a href="@quickLinksHref" class="@NavClass(IsNav("QuickLinks"))" aria-current="@NavCurrent(IsNav("QuickLinks"))">@T["Nav.QuickLinks"]</a>
                    <a href="@schemaCompareHref" class="@NavClass(IsNav("SchemaCompare"))" aria-current="@NavCurrent(IsNav("SchemaCompare"))">@T["Nav.SchemaCompare"]</a>
                    <a href="@sqlProfilerHref" class="@NavClass(IsNav("SqlProfiler"))" aria-current="@NavCurrent(IsNav("SqlProfiler"))">@T["Nav.SqlProfiler"]</a>
                    <a href="@componentsHref" class="@NavClass(IsNav("Components", "DemoKendo", "TabulatorDemo"))" aria-current="@NavCurrent(IsNav("Components", "DemoKendo", "TabulatorDemo"))">@T["Nav.Components"]</a>
                </nav>
            }
            else
            {
                <a class="brand" asp-controller="Home" asp-action="Index">@T["App.Name"]</a>
            }
        </aside>
        <div class="app-main">
            <header class="topbar">
                <button class="icon-button" type="button" data-sidebar-toggle aria-label="@T["Action.ToggleSidebar"]">&#9776;</button>
                <div>
                    <div class="page-kicker">@T["App.Tagline"]</div>
                    <h1>@(ViewData["Title"] ?? T["Dashboard.Title"].Value)</h1>
                </div>
                <div class="topbar-environment"
                     data-environment-summary
                     data-weather-loading="@T["Environment.Weather.Loading"]"
                     data-weather-unavailable="@T["Environment.Weather.Unavailable"]"
                     data-weather-clear="@T["Environment.Weather.Clear"]"
                     data-weather-cloudy="@T["Environment.Weather.Cloudy"]"
                     data-weather-fog="@T["Environment.Weather.Fog"]"
                     data-weather-rain="@T["Environment.Weather.Rain"]"
                     data-weather-snow="@T["Environment.Weather.Snow"]"
                     data-weather-storm="@T["Environment.Weather.Storm"]"
                     aria-live="polite">
                    <div class="topbar-clock">
                        <time class="topbar-clock-time" data-current-time datetime="">--:--</time>
                        <span class="topbar-clock-date" data-current-date>--/--/----</span>
                    </div>
                    <div class="topbar-weather">
                        <span class="topbar-weather-indicator" aria-hidden="true"></span>
                        <span class="topbar-weather-text" data-current-weather>@T["Environment.Weather.Loading"]</span>
                    </div>
                </div>
                <div class="topbar-actions">
                    <button class="icon-button" type="button" data-theme-toggle aria-label="@T["Action.ToggleTheme"]">&#9681;</button>
                    <form asp-controller="Culture" asp-action="Set" method="post" class="language-switcher">
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button class="language-button @(currentCulture == "vi-VN" ? "active" : null)" type="submit" name="culture" value="vi-VN">@T["Language.VietnameseShort"]</button>
                        <button class="language-button @(currentCulture == "en-US" ? "active" : null)" type="submit" name="culture" value="en-US">@T["Language.EnglishShort"]</button>
                    </form>
                    <partial name="_LoginPartial" />
                </div>
            </header>
            <main class="content-area @(ViewData["ContentAreaClass"] as string)" role="main">
                @RenderBody()
            </main>
        </div>
    </div>
    <partial name="_ConfirmModal" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/adaptive-background.js" asp-append-version="true"></script>
    @if (hasFlashNotification)
    {
        <partial name="_KendoScripts" />
    }
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
