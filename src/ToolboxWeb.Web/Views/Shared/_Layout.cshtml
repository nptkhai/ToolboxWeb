@using System.Text.Json
@using ToolboxWeb.Web.Constants
@using Microsoft.Extensions.Hosting
@using ToolboxWeb.Web.Services
@inject ICurrentUserService CurrentUser
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@{
    var flashSuccessMessage = TempData["SuccessMessage"] as string;
    var flashErrorMessage = TempData["ErrorMessage"] as string;
    var flashNotifications = new List<object>();
    if (!string.IsNullOrEmpty(flashSuccessMessage))
    {
        flashNotifications.Add(new { type = "success", message = flashSuccessMessage });
    }
    if (!string.IsNullOrEmpty(flashErrorMessage))
    {
        flashNotifications.Add(new { type = "error", message = flashErrorMessage });
    }
    var hasFlashNotification = flashNotifications.Count > 0;
    // Pages before sign-in (sign-in, register, …) have no sidebar, always show the animated
    // weather background, and show the clock and weather in the header.
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name" data-background-mode="@(isAuthenticated ? "app" : "auth")" data-time-zone="@ToolboxWeb.Web.Infrastructure.Time.AppClock.TimeZoneId">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] - @T["App.Name"]</title>
    <script type="importmap"></script>
    <link rel="preload" href="~/vendor/fonts/inter/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/vendor/fonts/inter/inter.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/adaptive-background.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    @if (isAuthenticated)
    {
        <link rel="stylesheet" href="~/css/shortcuts.css" asp-append-version="true" />
    }
    @if (hasFlashNotification)
    {
        <link rel="stylesheet" href="~/vendor/kendo/icons/index.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/vendor/kendo/theme/default-main.css" asp-append-version="true" />
    }
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/vendor-sync.css" asp-append-version="true" />
    <script>
        // First visit follows the OS preference; after the user picks a theme it is remembered.
        (function () {
            let theme = null;
            try { theme = localStorage.getItem('toolbox.theme'); } catch (e) { }
            if (theme !== 'light' && theme !== 'dark') {
                theme = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            }
            document.documentElement.dataset.theme = theme;
            // Inside the app the background is opt-in; before sign-in it is always on.
            let background = null;
            try { background = localStorage.getItem('toolbox.background'); } catch (e) { }
            const authPage = document.documentElement.dataset.backgroundMode === 'auth';
            document.documentElement.dataset.background = authPage || background === 'on' ? 'on' : 'off';
            // Applied before first paint so the sidebar does not jump on wide screens.
            let sidebar = null;
            try { sidebar = localStorage.getItem('toolbox.sidebar'); } catch (e) { }
            if (sidebar === 'collapsed') document.documentElement.dataset.sidebar = 'collapsed';
        })();
    </script>
    <script src="~/js/format.js" asp-append-version="true"></script>
</head>
<body>
    <partial name="_AdaptiveBackground" />
    @if (hasFlashNotification)
    {
        <div id="tbx-notification-host" class="tbx-notification-host" aria-hidden="true"></div>
        <script id="tbx-flash-data" type="application/json">@Html.Raw(JsonSerializer.Serialize(flashNotifications))</script>
    }
    @{
        var dashboardHref = Url.RouteUrl(ToolboxRouteSlugs.RouteNames.DashboardHtml) ?? "/dashboard.html";
        var jiraDashboardHref = Url.RouteUrl(ToolboxRouteSlugs.RouteNames.JiraDashboardHtml) ?? "/jira-dashboard.html";
        var brandHref = CurrentUser.IsJiraUser ? jiraDashboardHref : dashboardHref;
        // The DEV group (component hub and demos) is a developer tool, not part of the product.
        var showDevGroup = ToolboxWeb.Web.Infrastructure.Security.DevToolsAccess.IsAllowed(HostEnvironment, User);
        // One list of pages (ViewModels/AppNavigation.cs) feeds the sidebar, the command palette
        // and the "G then letter" shortcuts.
        var navGroups = AppNavigation.Build(Url, T, CurrentUser.IsJiraUser, showDevGroup);

        // Current sidebar item, by controller/action so it also holds after a POST round-trip
        // and on sub-routes such as /component/{tab}.html.
        var navController = ViewContext.RouteData.Values["controller"] as string ?? string.Empty;
        var navAction = ViewContext.RouteData.Values["action"] as string ?? string.Empty;
        var navArea = ViewContext.RouteData.Values["area"] as string ?? string.Empty;

        // Breadcrumb: the menu group of the current page, then the page title.
        var breadcrumbGroup = navGroups.FirstOrDefault(g => g.Items.Any(i => i.IsActive(navController, navAction)))?.Label;
        if (breadcrumbGroup is null && string.Equals(navArea, "Identity", StringComparison.OrdinalIgnoreCase) && isAuthenticated)
        {
            breadcrumbGroup = T["Nav.Group.Account"].Value;
        }
        var pageTitle = ViewData["Title"]?.ToString() ?? T["Dashboard.Title"].Value;
    }
    @functions {
        // One sidebar link: icon + text. The text stays in the accessibility tree when the
        // sidebar is collapsed to icons; site.js adds a title tooltip in that state.
        private async Task NavItem(string href, string icon, string label, bool active)
        {
            <li>
                <a href="@href" class="side-nav-link@(active ? " active" : null)" aria-current="@(active ? "page" : null)">
                    <tbx-icon name="@icon" />
                    <span class="nav-text">@label</span>
                </a>
            </li>
        }
    }
    <div class="app-shell@(isAuthenticated ? null : " app-shell--guest")" data-shell>
        @if (isAuthenticated)
        {
            <aside class="app-sidebar" id="app-sidebar">
                <div class="sidebar-head">
                    <a class="brand" href="@brandHref">
                        <span class="brand-mark" aria-hidden="true">TW</span>
                        <span class="brand-name">@T["App.Name"]</span>
                    </a>
                    <button class="icon-button sidebar-close" type="button" data-sidebar-close aria-label="@T["Action.CloseMenu"]">
                        <tbx-icon name="x" />
                    </button>
                </div>
                <nav class="side-nav" aria-label="@T["Nav.Label"]">
                    @foreach (var group in navGroups)
                    {
                        var sidebarItems = group.Items.Where(i => i.InSidebar).ToList();
                        if (sidebarItems.Count == 0)
                        {
                            continue;
                        }

                        <div class="nav-group">
                            <p class="nav-group-label" id="nav-group-@group.Key">@group.Label</p>
                            <ul aria-labelledby="nav-group-@group.Key">
                                @foreach (var item in sidebarItems)
                                {
                                    await NavItem(item.Href, item.Icon, item.Label, item.IsActive(navController, navAction));
                                }
                            </ul>
                        </div>
                    }
                </nav>
            </aside>
            <div class="sidebar-scrim" data-sidebar-close aria-hidden="true"></div>
        }
        <div class="app-main">
            <header class="topbar">
                @if (!isAuthenticated)
                {
                    <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">
                        <span class="brand-mark" aria-hidden="true">TW</span>
                        <span class="brand-name">@T["App.Name"]</span>
                    </a>
                }
                else
                {
                    <button class="icon-button" type="button" data-sidebar-toggle aria-controls="app-sidebar" aria-expanded="true" aria-label="@T["Action.ToggleSidebar"]">
                        <tbx-icon name="panel-left" class="toggle-icon-wide" />
                        <tbx-icon name="menu" class="toggle-icon-narrow" />
                    </button>
                }
                <nav class="topbar-breadcrumb" aria-label="@T["Nav.Breadcrumb"]">
                    @if (breadcrumbGroup is not null)
                    {
                        <span class="topbar-crumb">@breadcrumbGroup</span>
                        <tbx-icon name="chevron-right" class="topbar-crumb-sep" />
                    }
                    @* Before sign-in the page itself shows a heading on the sign-in card. *@
                    <h1 class="topbar-title@(isAuthenticated ? null : " tbx-visually-hidden")">@pageTitle</h1>
                </nav>
                <div class="topbar-actions">
                    @if (isAuthenticated)
                    {
                        @* Opens the command palette (Ctrl/⌘+K): pages, quick commands, search in my data. *@
                        <button class="topbar-command" type="button" data-palette-open aria-haspopup="dialog" aria-controls="tbx-palette">
                            <tbx-icon name="search" />
                            <span class="topbar-command-text">@T["Palette.Trigger"]</span>
                        </button>
                        @* The focus timer keeps running on every page (Content/js/focus-clock.js); while it
                           runs, this shows the time left and leads back to the timer. *@
                        <a class="focus-chip" href="@(Url.RouteUrl(ToolboxRouteSlugs.RouteNames.FocusTimerHtml) ?? "/focus-timer.html")" data-focus-chip hidden
                           data-complete-url="@Url.Action("Complete", "FocusTimer")"
                           data-text-focus="@T["FocusTimer.Phase.Focus"]" data-text-short="@T["FocusTimer.Phase.Short"]" data-text-long="@T["FocusTimer.Phase.Long"]"
                           data-text-focus-done="@T["FocusTimer.Done.Focus"]" data-text-break-done="@T["FocusTimer.Done.Break"]"
                           data-text-saved="@T["FocusTimer.Done.Saved"]" data-text-save-failed="@T["FocusTimer.Done.SaveFailed"]">
                            <tbx-icon name="timer" />
                            <span data-focus-chip-time></span>
                            <span class="visually-hidden" data-focus-chip-phase></span>
                        </a>
                        <span hidden data-focus-token>@Html.AntiForgeryToken()</span>
                    }
                    <partial name="_EnvironmentSummary" />
                    @if (!isAuthenticated)
                    {
                        <form asp-area="" asp-controller="Culture" asp-action="Set" method="post" class="guest-language" role="group" aria-label="@T["Account.Language"]">
                            <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                            <button type="submit" name="culture" value="vi-VN" lang="vi" title="@T["Language.Vietnamese"]" aria-pressed="@(CultureInfo.CurrentUICulture.Name == "vi-VN" ? "true" : "false")">VI</button>
                            <button type="submit" name="culture" value="en-US" lang="en" title="@T["Language.English"]" aria-pressed="@(CultureInfo.CurrentUICulture.Name == "en-US" ? "true" : "false")">EN</button>
                        </form>
                        <button class="icon-button" type="button" data-theme-toggle aria-label="@T["Action.ToggleTheme"]">
                            <tbx-icon name="moon" class="theme-icon-light" />
                            <tbx-icon name="sun" class="theme-icon-dark" />
                        </button>
                    }
                    @await RenderSectionAsync("PageActions", required: false)
                    <partial name="_LoginPartial" />
                </div>
            </header>
            <main class="content-area @(ViewData["ContentAreaClass"] as string)" role="main">
                @RenderBody()
            </main>
        </div>
    </div>
    <partial name="_ConfirmModal" />
    @if (isAuthenticated)
    {
        <partial name="_CommandPalette" model="navGroups" />
    }
    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/adaptive-background.js" asp-append-version="true"></script>
    @if (hasFlashNotification)
    {
        <partial name="_KendoScripts" />
    }
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (isAuthenticated)
    {
        <script src="~/js/shortcuts.js" asp-append-version="true"></script>
        <script src="~/js/command-palette.js" asp-append-version="true"></script>
        <script src="~/js/focus-clock.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
