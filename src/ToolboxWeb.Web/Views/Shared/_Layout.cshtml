@using System.Text.Json
@using ToolboxWeb.Web.Constants
@using Microsoft.Extensions.Hosting
@using ToolboxWeb.Web.Services
@inject ICurrentUserService CurrentUser
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@{
    var flashSuccessMessage = TempData["SuccessMessage"] as string;
    var flashErrorMessage = TempData["ErrorMessage"] as string;
    var flashNotifications = new List<object>();
    if (!string.IsNullOrEmpty(flashSuccessMessage))
    {
        flashNotifications.Add(new { type = "success", message = flashSuccessMessage });
    }
    if (!string.IsNullOrEmpty(flashErrorMessage))
    {
        flashNotifications.Add(new { type = "error", message = flashErrorMessage });
    }
    var hasFlashNotification = flashNotifications.Count > 0;
}
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] - @T["App.Name"]</title>
    <script type="importmap"></script>
    <link rel="preload" href="~/vendor/fonts/inter/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/vendor/fonts/inter/inter.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/adaptive-background.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    @if (hasFlashNotification)
    {
        <link rel="stylesheet" href="~/vendor/kendo/icons/index.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/vendor/kendo/theme/default-main.css" asp-append-version="true" />
    }
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/vendor-sync.css" asp-append-version="true" />
    <script>
        // First visit follows the OS preference; after the user picks a theme it is remembered.
        (function () {
            let theme = null;
            try { theme = localStorage.getItem('toolbox.theme'); } catch (e) { }
            if (theme !== 'light' && theme !== 'dark') {
                theme = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            }
            document.documentElement.dataset.theme = theme;
            let background = null;
            try { background = localStorage.getItem('toolbox.background'); } catch (e) { }
            document.documentElement.dataset.background = background === 'on' ? 'on' : 'off';
            // Applied before first paint so the sidebar does not jump on wide screens.
            let sidebar = null;
            try { sidebar = localStorage.getItem('toolbox.sidebar'); } catch (e) { }
            if (sidebar === 'collapsed') document.documentElement.dataset.sidebar = 'collapsed';
        })();
    </script>
</head>
<body>
    <partial name="_AdaptiveBackground" />
    @if (hasFlashNotification)
    {
        <div id="tbx-notification-host" class="tbx-notification-host" aria-hidden="true"></div>
        <script id="tbx-flash-data" type="application/json">@Html.Raw(JsonSerializer.Serialize(flashNotifications))</script>
    }
    @{
        var dashboardHref = Url.RouteUrl(ToolboxRouteSlugs.RouteNames.DashboardHtml) ?? "/dashboard.html";
        var jiraDashboardHref = Url.RouteUrl(ToolboxRouteSlugs.RouteNames.JiraDashboardHtml) ?? "/jira-dashboard.html";
        var jiraWorklistHref = Url.RouteUrl(ToolboxRouteSlugs.RouteNames.JiraWorklistHtml) ?? "/jira-worklist.html";
        var notesHref = Url.RouteUrl(ToolboxRouteSlugs.RouteNames.NotesHtml) ?? "/notes.html";
        var checklistHref = Url.RouteUrl(ToolboxRouteSlugs.RouteNames.ChecklistHtml) ?? "/checklist.html";
        var focusTimerHref = Url.RouteUrl(ToolboxRouteSlugs.RouteNames.FocusTimerHtml) ?? "/focus-timer.html";
        var quickLinksHref = Url.RouteUrl(ToolboxRouteSlugs.RouteNames.QuickLinksHtml) ?? "/quick-links.html";
        var promptTemplatesHref = Url.RouteUrl(ToolboxRouteSlugs.RouteNames.PromptTemplatesHtml) ?? "/prompt-templates.html";
        var componentsHref = Url.RouteUrl(ToolboxRouteSlugs.RouteNames.ComponentsHtml) ?? "/component.html";
        var schemaCompareHref = Url.RouteUrl(ToolboxRouteSlugs.RouteNames.SchemaCompareHtml) ?? "/schema-compare.html";
        var sqlProfilerHref = Url.RouteUrl(ToolboxRouteSlugs.RouteNames.SqlProfilerHtml) ?? "/sql-profiler.html";
        var brandHref = CurrentUser.IsJiraUser ? jiraDashboardHref : dashboardHref;
        var isAuthenticated = User.Identity?.IsAuthenticated == true;
        // The DEV group (component hub and demos) is a developer tool, not part of the product.
        var showDevGroup = HostEnvironment.IsDevelopment();

        // Current sidebar item, by controller/action so it also holds after a POST round-trip
        // and on sub-routes such as /component/{tab}.html.
        var navController = ViewContext.RouteData.Values["controller"] as string ?? string.Empty;
        var navAction = ViewContext.RouteData.Values["action"] as string ?? string.Empty;
        var navArea = ViewContext.RouteData.Values["area"] as string ?? string.Empty;
        bool IsNav(params string[] controllers) => controllers.Any(c => string.Equals(c, navController, StringComparison.OrdinalIgnoreCase));
        var jiraDashboardActive = IsNav("Jira") && string.Equals(navAction, "DashboardPage", StringComparison.OrdinalIgnoreCase);
        var jiraWorklistActive = IsNav("Jira") && !jiraDashboardActive;
        var personalControllers = new[] { "Dashboard", "Notes", "Checklist", "FocusTimer", "QuickLinks", "PromptTemplates" };
        var devControllers = new[] { "Components", "DemoKendo", "TabulatorDemo" };

        // Breadcrumb: the sidebar group of the current page, then the page title.
        string? breadcrumbGroup = null;
        if (IsNav("Jira")) breadcrumbGroup = T["Nav.Group.Jira"].Value;
        else if (IsNav(personalControllers)) breadcrumbGroup = T["Nav.Group.Personal"].Value;
        else if (IsNav("SchemaCompare", "SqlProfiler")) breadcrumbGroup = T["Nav.Group.Database"].Value;
        else if (IsNav(devControllers)) breadcrumbGroup = T["Nav.Group.Dev"].Value;
        else if (string.Equals(navArea, "Identity", StringComparison.OrdinalIgnoreCase) && isAuthenticated) breadcrumbGroup = T["Nav.Group.Account"].Value;
        var pageTitle = ViewData["Title"]?.ToString() ?? T["Dashboard.Title"].Value;
    }
    @functions {
        // One sidebar link: icon + text. The text stays in the accessibility tree when the
        // sidebar is collapsed to icons; site.js adds a title tooltip in that state.
        private async Task NavItem(string href, string icon, string label, bool active)
        {
            <li>
                <a href="@href" class="side-nav-link@(active ? " active" : null)" aria-current="@(active ? "page" : null)">
                    <tbx-icon name="@icon" />
                    <span class="nav-text">@label</span>
                </a>
            </li>
        }
    }
    <div class="app-shell" data-shell>
        <aside class="app-sidebar" id="app-sidebar">
            <div class="sidebar-head">
                <a class="brand" href="@(isAuthenticated ? brandHref : Url.Action("Index", "Home", new { area = "" }))">
                    <span class="brand-mark" aria-hidden="true">TW</span>
                    <span class="brand-name">@T["App.Name"]</span>
                </a>
                <button class="icon-button sidebar-close" type="button" data-sidebar-close aria-label="@T["Action.CloseMenu"]">
                    <tbx-icon name="x" />
                </button>
            </div>
            @if (isAuthenticated)
            {
                <nav class="side-nav" aria-label="@T["Nav.Label"]">
                    @if (CurrentUser.IsJiraUser)
                    {
                        <div class="nav-group">
                            <p class="nav-group-label" id="nav-group-jira">@T["Nav.Group.Jira"]</p>
                            <ul aria-labelledby="nav-group-jira">
                                @{ await NavItem(jiraDashboardHref, "gauge", T["Nav.JiraDashboard"].Value, jiraDashboardActive); }
                                @{ await NavItem(jiraWorklistHref, "kanban", T["Nav.JiraWorklist"].Value, jiraWorklistActive); }
                            </ul>
                        </div>
                    }
                    <div class="nav-group">
                        <p class="nav-group-label" id="nav-group-personal">@T["Nav.Group.Personal"]</p>
                        <ul aria-labelledby="nav-group-personal">
                            @{ await NavItem(dashboardHref, "layout-dashboard", T["Nav.Dashboard"].Value, IsNav("Dashboard")); }
                            @{ await NavItem(notesHref, "sticky-note", T["Nav.Notes"].Value, IsNav("Notes")); }
                            @{ await NavItem(checklistHref, "list-checks", T["Nav.Checklist"].Value, IsNav("Checklist")); }
                            @{ await NavItem(focusTimerHref, "timer", T["Nav.FocusTimer"].Value, IsNav("FocusTimer")); }
                            @{ await NavItem(quickLinksHref, "link", T["Nav.QuickLinks"].Value, IsNav("QuickLinks")); }
                            @{ await NavItem(promptTemplatesHref, "message-square-text", T["Nav.PromptTemplates"].Value, IsNav("PromptTemplates")); }
                        </ul>
                    </div>
                    <div class="nav-group">
                        <p class="nav-group-label" id="nav-group-database">@T["Nav.Group.Database"]</p>
                        <ul aria-labelledby="nav-group-database">
                            @{ await NavItem(schemaCompareHref, "git-compare", T["Nav.SchemaCompare"].Value, IsNav("SchemaCompare")); }
                            @{ await NavItem(sqlProfilerHref, "activity", T["Nav.SqlProfiler"].Value, IsNav("SqlProfiler")); }
                        </ul>
                    </div>
                    @if (showDevGroup)
                    {
                        <div class="nav-group">
                            <p class="nav-group-label" id="nav-group-dev">@T["Nav.Group.Dev"]</p>
                            <ul aria-labelledby="nav-group-dev">
                                @{ await NavItem(componentsHref, "blocks", T["Nav.Components"].Value, IsNav(devControllers)); }
                            </ul>
                        </div>
                    }
                </nav>
            }
        </aside>
        <div class="sidebar-scrim" data-sidebar-close aria-hidden="true"></div>
        <div class="app-main">
            <header class="topbar">
                @if (isAuthenticated)
                {
                    <button class="icon-button" type="button" data-sidebar-toggle aria-controls="app-sidebar" aria-expanded="true" aria-label="@T["Action.ToggleSidebar"]">
                        <tbx-icon name="panel-left" class="toggle-icon-wide" />
                        <tbx-icon name="menu" class="toggle-icon-narrow" />
                    </button>
                }
                <nav class="topbar-breadcrumb" aria-label="@T["Nav.Breadcrumb"]">
                    @if (breadcrumbGroup is not null)
                    {
                        <span class="topbar-crumb">@breadcrumbGroup</span>
                        <tbx-icon name="chevron-right" class="topbar-crumb-sep" />
                    }
                    <h1 class="topbar-title">@pageTitle</h1>
                </nav>
                <div class="topbar-actions">
                    @await RenderSectionAsync("PageActions", required: false)
                    <partial name="_LoginPartial" />
                </div>
            </header>
            <main class="content-area @(ViewData["ContentAreaClass"] as string)" role="main">
                @RenderBody()
            </main>
        </div>
    </div>
    <partial name="_ConfirmModal" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/adaptive-background.js" asp-append-version="true"></script>
    @if (hasFlashNotification)
    {
        <partial name="_KendoScripts" />
    }
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
