@* Show/hide button for a password input. Put it inside the element with class "tbx-password"
   that also holds the input; site.js does the switching. *@
<button type="button" class="tbx-password-toggle" data-password-toggle aria-pressed="false"
        aria-label="@T["Account.ShowPassword"]"
        data-label-show="@T["Account.ShowPassword"]"
        data-label-hide="@T["Account.HidePassword"]">
    <tbx-icon name="eye" class="is-show" />
    <tbx-icon name="eye-off" class="is-hide" />
</button>
