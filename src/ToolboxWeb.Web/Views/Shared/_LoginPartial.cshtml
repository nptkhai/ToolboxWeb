@using Microsoft.AspNetCore.Identity
@using System.Globalization
@using System.Linq
@using ToolboxWeb.Web.Domain
@using ToolboxWeb.Web.Services
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IUserProfileService UserProfileService
@inject ICurrentUserService CurrentUser
@{
    static string BuildInitials(string? value)
    {
        var source = string.IsNullOrWhiteSpace(value)
            ? string.Empty
            : value.Split('@', 2, StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)[0];

        var parts = source
            .Split(new[] { ' ', '.', '_', '-' }, StringSplitOptions.RemoveEmptyEntries)
            .Where(part => !string.IsNullOrWhiteSpace(part))
            .ToArray();

        if (parts.Length >= 2)
        {
            return string.Concat(parts[0][0], parts[1][0]).ToUpperInvariant();
        }

        if (parts.Length == 1)
        {
            return string.Concat(parts[0].Take(2)).ToUpperInvariant();
        }

        return "TW";
    }
}

@if (SignInManager.IsSignedIn(User))
{
    var userId = UserManager.GetUserId(User);
    var profile = !string.IsNullOrWhiteSpace(userId)
        ? await UserProfileService.GetProfileAsync(userId)
        : null;
    var accountLabel = CurrentUser.DisplayName ?? profile?.DisplayName ?? profile?.Email ?? profile?.UserName ?? User.Identity?.Name ?? T["Auth.ManageAccount"].Value;
    var accountDetail = profile?.Email is { Length: > 0 } email && !string.Equals(email, accountLabel, StringComparison.OrdinalIgnoreCase) ? email : null;
    var avatarUrl = profile?.AvatarUrl;
    var initials = BuildInitials(accountLabel);
    var currentCulture = CultureInfo.CurrentUICulture.Name;
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";

    <div class="dropdown account-menu">
        <button class="account-trigger" type="button" data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false" aria-label="@T["Account.Menu"]: @accountLabel">
            @* Initials are always rendered underneath; site.js removes the image if it fails to load. *@
            <span class="account-avatar">
                <span aria-hidden="true">@initials</span>
                @if (!string.IsNullOrWhiteSpace(avatarUrl))
                {
                    <img src="@Url.Content(avatarUrl)" alt="" data-avatar-image />
                }
            </span>
            <tbx-icon name="chevron-down" class="account-trigger-caret" size="14" />
        </button>
        <div class="dropdown-menu dropdown-menu-end account-dropdown">
            <div class="account-dropdown-head">
                <span class="account-dropdown-name">@accountLabel</span>
                @if (accountDetail is not null)
                {
                    <span class="account-dropdown-detail">@accountDetail</span>
                }
            </div>
            <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">
                <tbx-icon name="user" />@T["Auth.ManageAccount"]
            </a>
            <div class="dropdown-divider"></div>

            <p class="account-dropdown-label" id="account-theme-label">@T["Account.Theme"]</p>
            <div class="account-segmented" role="group" aria-labelledby="account-theme-label" data-theme-options>
                <button type="button" data-theme-set="light" aria-pressed="false"><tbx-icon name="sun" />@T["Account.Theme.Light"]</button>
                <button type="button" data-theme-set="dark" aria-pressed="false"><tbx-icon name="moon" />@T["Account.Theme.Dark"]</button>
                <button type="button" data-theme-set="system" aria-pressed="false"><tbx-icon name="monitor" />@T["Account.Theme.System"]</button>
            </div>

            <p class="account-dropdown-label" id="account-language-label">@T["Account.Language"]</p>
            <form asp-area="" asp-controller="Culture" asp-action="Set" method="post" class="account-segmented" role="group" aria-labelledby="account-language-label">
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <button type="submit" name="culture" value="vi-VN" lang="vi" aria-pressed="@(currentCulture == "vi-VN" ? "true" : "false")">@T["Language.Vietnamese"]</button>
                <button type="submit" name="culture" value="en-US" lang="en" aria-pressed="@(currentCulture == "en-US" ? "true" : "false")">@T["Language.English"]</button>
            </form>

            <div class="dropdown-divider"></div>
            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit" class="dropdown-item"><tbx-icon name="log-out" />@T["Auth.Logout"]</button>
            </form>
        </div>
    </div>
}
else
{
    // The button for the page already open is left out (the sign-in card is right below).
    var currentPage = ViewContext.RouteData.Values["page"] as string;
    <div class="account-menu account-menu--guest">
        @if (!string.Equals(currentPage, "/Account/Register", StringComparison.OrdinalIgnoreCase))
        {
            <a class="btn btn-sm btn-outline-secondary" asp-area="Identity" asp-page="/Account/Register">@T["Auth.Register"]</a>
        }
        @if (!string.Equals(currentPage, "/Account/Login", StringComparison.OrdinalIgnoreCase))
        {
            <a class="btn btn-sm btn-primary" asp-area="Identity" asp-page="/Account/Login">@T["Auth.Login"]</a>
        }
    </div>
}
