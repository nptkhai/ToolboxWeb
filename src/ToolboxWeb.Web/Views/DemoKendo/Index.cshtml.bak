@{
    ViewData["Title"] = T["Nav.KendoDemo"];
}

@section Styles {
    <link rel="stylesheet" href="~/vendor/kendo/icons/index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/vendor/kendo/theme/default-main.css" asp-append-version="true" />
    <style>
        .kendo-demo-page {
            --demo-bg: linear-gradient(135deg, rgba(37, 99, 235, .12), rgba(15, 118, 110, .10));
            --demo-card: color-mix(in srgb, var(--surface) 94%, #ffffff 6%);
            --demo-soft: color-mix(in srgb, var(--surface-2) 86%, #ffffff 14%);
            --demo-strong: #0f172a;
            color: var(--text);
        }

        :root[data-theme="dark"] .kendo-demo-page {
            --demo-bg: linear-gradient(135deg, rgba(96, 165, 250, .16), rgba(94, 234, 212, .10));
            --demo-card: color-mix(in srgb, var(--surface) 92%, #0f172a 8%);
            --demo-soft: color-mix(in srgb, var(--surface-2) 88%, #0f172a 12%);
            --demo-strong: #f8fafc;
        }

        .kendo-demo-hero {
            background:
                radial-gradient(circle at 18% 10%, rgba(37, 99, 235, .18), transparent 32%),
                radial-gradient(circle at 86% 0%, rgba(15, 118, 110, .16), transparent 30%),
                var(--demo-bg);
            border: 1px solid var(--line);
            border-radius: 18px;
            overflow: hidden;
            padding: clamp(20px, 4vw, 34px);
            position: relative;
        }

        .kendo-demo-hero h2 {
            font-size: clamp(1.45rem, 3vw, 2.25rem);
            letter-spacing: -.03em;
            margin: 0 0 8px;
        }

        .kendo-demo-hero p {
            color: var(--muted);
            margin: 0;
            max-width: 860px;
        }

        .kendo-meta-row,
        .kendo-toolbar-row,
        .demo-card-grid,
        .summary-grid {
            display: grid;
            gap: 12px;
        }

        .kendo-meta-row {
            grid-template-columns: repeat(4, minmax(0, 1fr));
            margin-top: 18px;
        }

        .kendo-meta-pill,
        .core-warning,
        .demo-card {
            background: var(--demo-card);
            border: 1px solid var(--line);
            border-radius: 14px;
        }

        .kendo-meta-pill {
            padding: 12px 14px;
        }

        .kendo-meta-pill span {
            color: var(--muted);
            display: block;
            font-size: .78rem;
            font-weight: 700;
            text-transform: uppercase;
        }

        .kendo-meta-pill strong {
            display: block;
            margin-top: 4px;
        }

        .core-warning {
            color: var(--muted);
            margin-top: 16px;
            padding: 14px 16px;
        }

        .core-warning strong {
            color: var(--text);
        }

        .demo-tab-shell {
            background: var(--demo-card);
            border: 1px solid var(--line);
            border-radius: 16px;
            overflow: hidden;
        }

        .demo-tab-nav {
            border-bottom: 1px solid var(--line);
            gap: 8px;
            padding: 14px 14px 0;
        }

        .demo-tab-nav .nav-link {
            border: 1px solid transparent;
            border-top-left-radius: 12px;
            border-top-right-radius: 12px;
            color: var(--muted);
            font-weight: 750;
        }

        .demo-tab-nav .nav-link:hover,
        .demo-tab-nav .nav-link:focus {
            border-color: transparent transparent var(--line);
            color: var(--text);
        }

        .demo-tab-nav .nav-link.active {
            background: var(--demo-card);
            border-color: var(--line) var(--line) var(--demo-card);
            color: var(--text);
        }

        .demo-tab-content {
            padding: 18px;
        }

        .demo-card-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .demo-card {
            padding: 16px;
        }

        .demo-card h3 {
            font-size: 1rem;
            margin: 0 0 12px;
        }

        .demo-card label {
            color: var(--muted);
            display: block;
            font-size: .82rem;
            font-weight: 750;
            margin-bottom: 7px;
            text-transform: uppercase;
        }

        .demo-card .hint {
            color: var(--muted);
            font-size: .86rem;
            margin-top: 8px;
        }

        .color-inline-preview {
            border: 1px solid var(--line);
            border-radius: 999px;
            display: inline-block;
            height: 14px;
            margin-left: 8px;
            vertical-align: middle;
            width: 14px;
        }

        .kendo-toolbar-row {
            align-items: end;
            grid-template-columns: 1.3fr .85fr .9fr auto;
            margin-bottom: 16px;
        }

        .summary-grid {
            grid-template-columns: repeat(4, minmax(0, 1fr));
            margin-bottom: 16px;
        }

        .summary-card {
            background: var(--demo-soft);
            border: 1px solid var(--line);
            border-radius: 14px;
            padding: 13px 14px;
        }

        .summary-card span {
            color: var(--muted);
            display: block;
            font-size: .78rem;
            font-weight: 700;
            text-transform: uppercase;
        }

        .summary-card strong {
            display: block;
            font-size: 1.22rem;
            margin-top: 4px;
        }

        .core-table {
            border: 1px solid var(--line);
            border-radius: 14px;
            overflow: hidden;
        }

        .core-table-head,
        .core-table-row {
            display: grid;
            gap: 12px;
            grid-template-columns: minmax(220px, 1.4fr) minmax(120px, .7fr) minmax(116px, .62fr) minmax(112px, .58fr) minmax(130px, .65fr) 98px;
        }

        .core-table-head {
            background: var(--demo-soft);
            color: var(--muted);
            font-size: .78rem;
            font-weight: 800;
            padding: 12px 14px;
            text-transform: uppercase;
        }

        .core-table-row {
            align-items: center;
            background: var(--demo-card);
            border-top: 1px solid var(--line);
            padding: 13px 14px;
        }

        .core-table-title {
            font-weight: 800;
        }

        .core-table-subtitle {
            color: var(--muted);
            font-size: .85rem;
            margin-top: 3px;
        }

        .status-pill,
        .priority-pill {
            border-radius: 999px;
            display: inline-flex;
            font-size: .78rem;
            font-weight: 800;
            justify-content: center;
            padding: 5px 9px;
        }

        .status-done {
            background: rgba(22, 163, 74, .14);
            color: #15803d;
        }

        .status-doing {
            background: rgba(37, 99, 235, .14);
            color: #2563eb;
        }

        .status-review {
            background: rgba(217, 119, 6, .16);
            color: #b45309;
        }

        .priority-high {
            background: rgba(180, 35, 24, .13);
            color: var(--danger);
        }

        .priority-medium {
            background: rgba(37, 99, 235, .13);
            color: var(--accent);
        }

        .priority-low {
            background: rgba(15, 118, 110, .13);
            color: var(--accent-2);
        }

        .progress-mini {
            background: var(--surface-2);
            border-radius: 999px;
            height: 8px;
            overflow: hidden;
        }

        .progress-mini span {
            background: linear-gradient(90deg, var(--accent), var(--accent-2));
            display: block;
            height: 100%;
        }

        .kendo-demo-page .k-widget,
        .kendo-demo-page .k-input,
        .kendo-demo-page .k-picker,
        .kendo-demo-page .k-dropdownlist,
        .kendo-demo-page .k-multiselect,
        .kendo-demo-page .k-combobox {
            width: 100%;
        }

        .kendo-demo-page .k-listview {
            border: 0;
        }

        .kendo-demo-page .k-pager {
            border: 0;
            border-top: 1px solid var(--line);
        }

        .kendo-demo-page .k-window,
        .kendo-demo-page .k-dialog,
        .k-popup,
        .k-list-container,
        .k-calendar-container,
        .k-colorpalette,
        .k-notification-container {
            z-index: 3000;
        }

        .k-animation-container,
        body > .k-animation-container {
            z-index: 3000 !important;
        }

        .layout-playground {
            display: grid;
            gap: 14px;
            grid-template-columns: minmax(0, 1fr) minmax(280px, .8fr);
        }

        #kendo-splitter {
            height: 260px;
        }

        #kendo-splitter .split-pane {
            color: var(--text);
            padding: 16px;
        }

        .widget-missing {
            border: 1px dashed var(--danger);
            border-radius: 10px;
            color: var(--danger);
            font-size: .86rem;
            margin-top: 8px;
            padding: 9px 10px;
        }

        @@media (max-width: 1100px) {
            .kendo-meta-row,
            .summary-grid,
            .demo-card-grid,
            .layout-playground {
                grid-template-columns: 1fr;
            }

            .kendo-toolbar-row {
                grid-template-columns: 1fr;
            }

            .core-table-head {
                display: none;
            }

            .core-table-row {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="tool-grid kendo-demo-page">
    <section class="span-12 kendo-demo-hero">
        <h2>@T["Nav.KendoDemo"]</h2>
        <p>
            Demo này dùng Kendo UI Core bản miễn phí mới nhất theo hướng self-host từ npm package Apache 2.0,
            không còn phụ thuộc vào Telerik CDN. Phần bảng dữ liệu được dựng bằng DataSource, ListView và Pager
            để tránh phụ thuộc vào Kendo Grid thương mại.
        </p>

        <div class="kendo-meta-row">
            <div class="kendo-meta-pill">
                <span>Kendo UI Core</span>
                <strong>2026.2.520</strong>
            </div>
            <div class="kendo-meta-pill">
                <span>Kendo Theme</span>
                <strong>Default 14.1.0</strong>
            </div>
            <div class="kendo-meta-pill">
                <span>jQuery</span>
                <strong>3.7.1</strong>
            </div>
            <div class="kendo-meta-pill">
                <span>Culture</span>
                <strong>vi-VN</strong>
            </div>
        </div>

        <div class="core-warning">
            <strong>Lưu ý license:</strong>
            Kendo UI Core miễn phí không bao gồm Grid, Switch, TreeView, Scheduler, Chart, Excel/PDF export.
            Nếu cần đúng Kendo Grid đầy đủ thì phải đổi sang bundle/giấy phép thương mại; bản demo này chỉ dùng widget Core để source chạy sạch.
        </div>
    </section>

    <section class="panel span-12">
        <div class="demo-tab-shell">
            <ul class="nav nav-tabs demo-tab-nav" id="kendo-demo-tabs" role="tablist">
                <li class="k-active">Bảng dữ liệu Core</li>
                <li>Editor & Popup</li>
                <li>Input & Culture</li>
                <li>Layout & UX</li>
            </ul>

            <div>
                <div class="demo-tab-content">
                    <div class="kendo-toolbar-row">
                        <div>
                            <label for="table-search">Tìm nhanh</label>
                            <input id="table-search" />
                        </div>
                        <div>
                            <label for="table-category">Danh mục</label>
                            <input id="table-category" />
                        </div>
                        <div>
                            <label for="table-sort">Sắp xếp</label>
                            <input id="table-sort" />
                        </div>
                        <button id="table-reset" type="button">Đặt lại</button>
                    </div>

                    <div class="summary-grid">
                        <div class="summary-card">
                            <span>Tổng dòng</span>
                            <strong id="summary-total">0</strong>
                        </div>
                        <div class="summary-card">
                            <span>Đang hiển thị</span>
                            <strong id="summary-visible">0</strong>
                        </div>
                        <div class="summary-card">
                            <span>Hoàn tất</span>
                            <strong id="summary-done">0</strong>
                        </div>
                        <div class="summary-card">
                            <span>Tiến độ TB</span>
                            <strong id="summary-progress">0%</strong>
                        </div>
                    </div>

                    <div class="core-table">
                        <div class="core-table-head">
                            <div>Công việc</div>
                            <div>Danh mục</div>
                            <div>Trạng thái</div>
                            <div>Ưu tiên</div>
                            <div>Tiến độ</div>
                            <div>Thao tác</div>
                        </div>
                        <div id="task-listview"></div>
                        <div id="task-pager"></div>
                    </div>
                </div>
            </div>

            <div>
                <div class="demo-tab-content demo-card-grid">
                    <div class="demo-card">
                        <h3>AutoComplete</h3>
                        <label for="kendo-autocomplete">Gợi ý từ khóa</label>
                        <input id="kendo-autocomplete" placeholder="Gõ UI, API, SQL..." />
                        <div class="hint">Popup được append vào vùng demo để không bị topbar/sidebar hoặc z-index của app đè.</div>
                    </div>

                    <div class="demo-card">
                        <h3>MultiSelect</h3>
                        <label for="kendo-multiselect">Chọn nhiều danh mục</label>
                        <input id="kendo-multiselect" />
                        <div class="hint">Đã bật filter, autoClose=false và popup height cố định để danh sách không vỡ layout.</div>
                    </div>

                    <div class="demo-card">
                        <h3>ComboBox</h3>
                        <label for="kendo-combobox">Nhập hoặc chọn tỉnh/thành</label>
                        <input id="kendo-combobox" />
                    </div>

                    <div class="demo-card">
                        <h3>DropDownList + ListBox</h3>
                        <label for="kendo-dropdownlist">Mức ưu tiên</label>
                        <input id="kendo-dropdownlist" />
                        <div class="mt-3">
                            <label for="kendo-listbox">Danh sách xử lý</label>
                            <select id="kendo-listbox"></select>
                        </div>
                    </div>
                </div>
            </div>

            <div>
                <div class="demo-tab-content demo-card-grid">
                    <div class="demo-card">
                        <h3>DatePicker & DateTimePicker</h3>
                        <label for="kendo-datepicker">Ngày theo định dạng Việt Nam</label>
                        <input id="kendo-datepicker" />
                        <div class="mt-3">
                            <label for="kendo-datetimepicker">Ngày giờ</label>
                            <input id="kendo-datetimepicker" />
                        </div>
                    </div>

                    <div class="demo-card">
                        <h3>NumericTextBox & Slider</h3>
                        <label for="kendo-numeric">Ngân sách VNĐ</label>
                        <input id="kendo-numeric" />
                        <div class="mt-3">
                            <label for="kendo-slider">Mức hoàn thành</label>
                            <input id="kendo-slider" />
                        </div>
                    </div>

                    <div class="demo-card">
                        <h3>MaskedTextBox & TimePicker</h3>
                        <label for="kendo-phone">Số điện thoại</label>
                        <input id="kendo-phone" />
                        <div class="mt-3">
                            <label for="kendo-timepicker">Giờ nhắc việc</label>
                            <input id="kendo-timepicker" />
                        </div>
                    </div>

                    <div class="demo-card">
                        <h3>ColorPicker & Validator</h3>
                        <label for="kendo-colorpicker">Màu nhãn</label>
                        <input id="kendo-colorpicker" />
                        <div class="hint">Màu đang chọn: <strong id="kendo-color-value">#2563eb</strong><span id="kendo-color-preview" class="color-inline-preview" style="background:#2563eb;"></span></div>
                        <form id="kendo-validation-form" class="mt-3">
                            <label for="kendo-email">Email nhận nhắc việc</label>
                            <input id="kendo-email" name="Email" type="email" required validationMessage="Vui lòng nhập email hợp lệ" />
                            <button id="validate-form-btn" class="mt-3" type="button">Kiểm tra form</button>
                        </form>
                    </div>
                </div>
            </div>

            <div>
                <div class="demo-tab-content">
                    <div class="layout-playground">
                        <div class="demo-card">
                            <h3>Splitter, PanelBar, Menu</h3>
                            <ul id="kendo-menu">
                                <li>
                                    Tác vụ
                                    <ul>
                                        <li>Tạo ghi chú</li>
                                        <li>Tạo checklist</li>
                                        <li>Mở prompt</li>
                                    </ul>
                                </li>
                                <li>
                                    Bộ lọc
                                    <ul>
                                        <li>Hôm nay</li>
                                        <li>Tuần này</li>
                                        <li>Đã ghim</li>
                                    </ul>
                                </li>
                            </ul>

                            <div id="kendo-splitter" class="mt-3">
                                <div class="split-pane">
                                    <strong>Panel chính</strong>
                                    <p class="muted mb-0">Splitter cho phép resize/collapse vùng nội dung trong Core.</p>
                                </div>
                                <div class="split-pane">
                                    <ul id="kendo-panelbar">
                                        <li class="k-expanded">
                                            Trạng thái demo
                                            <ul>
                                                <li>Asset Kendo mới</li>
                                                <li>Popup đã fix z-index</li>
                                                <li>Widget thương mại đã tránh gọi</li>
                                            </ul>
                                        </li>
                                        <li>
                                            Thành phần Core
                                            <ul>
                                                <li>DataSource</li>
                                                <li>ListView</li>
                                                <li>Pager</li>
                                            </ul>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <div class="demo-card">
                            <h3>Window, Dialog, Tooltip, Notification</h3>
                            <button id="show-window-btn" type="button">Mở Window</button>
                            <button id="show-dialog-btn" class="mt-2" type="button">Mở Dialog</button>
                            <button id="show-notification-btn" class="mt-2" type="button">Hiện Notification</button>
                            <div id="tooltip-target" class="mt-3 p-3 rounded border" style="cursor: help;">
                                Di chuột vào đây để xem Tooltip.
                            </div>
                            <div id="kendo-progress" class="mt-3"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<div id="task-detail-window" style="display:none;"></div>
<div id="kendo-window" style="display:none;">
    <div class="p-3">
        <h5>Kendo Window trong bản Core</h5>
        <p class="mb-0">Window hỗ trợ kéo, resize, minimize, maximize và modal mà không cần bundle thương mại.</p>
    </div>
</div>
<div id="kendo-dialog" style="display:none;">
    <p class="mb-0">Dialog này dùng Kendo UI Core. Nếu một widget không có trong Core, trang sẽ không gọi để tránh làm hỏng các widget còn lại.</p>
</div>
<div id="kendo-notification"></div>

<script id="task-row-template" type="text/x-kendo-template">
    <div class="core-table-row">
        <div>
            <div class="core-table-title">#: name #</div>
            <div class="core-table-subtitle">#: owner # · Hạn: #= kendo.toString(due, "dd/MM/yyyy") #</div>
        </div>
        <div>#: category #</div>
        <div><span class="status-pill status-#: statusCode #">#: status #</span></div>
        <div><span class="priority-pill priority-#: priorityCode #">#: priority #</span></div>
        <div>
            <div class="progress-mini" aria-label="Tiến độ #: progress #%">
                <span style="width: #: progress #%"></span>
            </div>
            <div class="core-table-subtitle">#: progress #% · #: kendo.toString(budget, "c0") #</div>
        </div>
        <div>
            <button class="k-button k-button-md k-rounded-md k-button-solid k-button-solid-primary" type="button" data-task-detail data-task-id="#: id #">Chi tiết</button>
        </div>
    </div>
</script>

@section Scripts {
    <script src="~/vendor/kendo/js/kendo.ui.core.min.js" asp-append-version="true"></script>
    <script src="~/vendor/kendo/cultures/kendo.culture.vi-VN.min.js" asp-append-version="true"></script>
    <script src="~/vendor/kendo/messages/kendo.messages.vi-VN.min.js" asp-append-version="true"></script>
    <script>
        (function ($) {
            if (!window.kendo) {
                $(".kendo-demo-hero").append("<div class='widget-missing'>Không tải được Kendo UI Core browser bundle self-host. Vui lòng kiểm tra static file hoặc CSP.</div>");
                return;
            }

            kendo.culture("vi-VN");

            const popupOptions = {
                appendTo: $(document.body),
                collision: "fit flip"
            };

            function initWidget(selector, pluginName, options) {
                const element = $(selector);
                if (typeof $.fn[pluginName] !== "function") {
                    element.after("<div class='widget-missing'>" + pluginName + " chưa sẵn sàng trong bundle Kendo self-host hiện tại. Hãy kiểm tra asset browser js và phiên bản culture/messages.</div>");
                    return null;
                }

                element[pluginName](options || {});
                return element.data(pluginName);
            }

            const tasks = [
                { id: 1, name: "Chuẩn hóa giao diện popup Kendo", owner: "Khai", category: "UI", status: "Đang làm", statusCode: "doing", priority: "Cao", priorityCode: "high", progress: 72, budget: 1250000, due: new Date(2026, 5, 18), note: "Kiểm tra AutoComplete, MultiSelect và z-index popup." },
                { id: 2, name: "Tách localization JSON external", owner: "ToolboxWeb", category: "Localization", status: "Hoàn tất", statusCode: "done", priority: "Cao", priorityCode: "high", progress: 100, budget: 980000, due: new Date(2026, 5, 19), note: "Cho phép chỉnh ngôn ngữ sau khi publish." },
                { id: 3, name: "Kiểm tra culture vi-VN", owner: "Khai", category: "Culture", status: "Review", statusCode: "review", priority: "Trung bình", priorityCode: "medium", progress: 84, budget: 620000, due: new Date(2026, 5, 20), note: "Ngày giờ, tiền tệ, timezone Việt Nam." },
                { id: 4, name: "Bổ sung demo DataSource", owner: "Codex", category: "Kendo Core", status: "Đang làm", statusCode: "doing", priority: "Trung bình", priorityCode: "medium", progress: 66, budget: 750000, due: new Date(2026, 5, 21), note: "Thay thế Grid bằng ListView + Pager cho bản miễn phí." },
                { id: 5, name: "Tạo checklist kiểm thử UI", owner: "QA", category: "Testing", status: "Review", statusCode: "review", priority: "Thấp", priorityCode: "low", progress: 48, budget: 420000, due: new Date(2026, 5, 22), note: "Kiểm thử desktop/mobile và dark mode." },
                { id: 6, name: "Rà soát gói self-host Kendo", owner: "DevOps", category: "Kendo Core", status: "Hoàn tất", statusCode: "done", priority: "Trung bình", priorityCode: "medium", progress: 100, budget: 350000, due: new Date(2026, 5, 23), note: "Dùng asset local từ npm package Apache 2.0, không phụ thuộc Telerik CDN." },
                { id: 7, name: "Tinh chỉnh responsive bảng", owner: "Frontend", category: "UI", status: "Đang làm", statusCode: "doing", priority: "Thấp", priorityCode: "low", progress: 54, budget: 560000, due: new Date(2026, 5, 24), note: "Bảng chuyển thành card trên màn hình nhỏ." },
                { id: 8, name: "Kiểm tra form validation", owner: "ToolboxWeb", category: "Testing", status: "Hoàn tất", statusCode: "done", priority: "Thấp", priorityCode: "low", progress: 100, budget: 300000, due: new Date(2026, 5, 25), note: "Validator hoạt động cùng culture và theme hiện tại." }
            ];

            const taskDataSource = new kendo.data.DataSource({
                data: tasks,
                pageSize: 5,
                sort: { field: "due", dir: "asc" },
                schema: {
                    model: {
                        id: "id",
                        fields: {
                            id: { type: "number" },
                            progress: { type: "number" },
                            budget: { type: "number" },
                            due: { type: "date" }
                        }
                    }
                },
                change: updateSummary
            });

            const demoTabs = document.getElementById("kendo-demo-tabs");
            if (demoTabs) {
                const tabList = demoTabs.querySelector(":scope > ul");
                const headers = tabList ? Array.from(tabList.children) : [];
                const panels = Array.from(demoTabs.querySelectorAll(":scope > div"));

                if (tabList && headers.length === panels.length) {
                    const contentHost = document.createElement("div");
                    contentHost.className = "tab-content";

                    headers.forEach(function (header, index) {
                        const label = header.textContent?.trim() || "Tab";
                        const tabId = "demo-tab-" + index;
                        const paneId = "demo-pane-" + index;
                        const panel = panels[index];
                        const button = document.createElement("button");

                        header.className = "nav-item";
                        header.setAttribute("role", "presentation");
                        header.replaceChildren();

                        button.className = index === 0 ? "nav-link active" : "nav-link";
                        button.id = tabId;
                        button.type = "button";
                        button.setAttribute("role", "tab");
                        button.setAttribute("data-bs-toggle", "tab");
                        button.setAttribute("data-bs-target", "#" + paneId);
                        button.setAttribute("aria-controls", paneId);
                        button.setAttribute("aria-selected", index === 0 ? "true" : "false");
                        button.textContent = label;
                        header.appendChild(button);

                        panel.className = index === 0 ? "tab-pane fade show active" : "tab-pane fade";
                        panel.id = paneId;
                        panel.setAttribute("role", "tabpanel");
                        panel.setAttribute("aria-labelledby", tabId);
                        panel.setAttribute("tabindex", "0");
                        contentHost.appendChild(panel);
                    });

                    demoTabs.appendChild(contentHost);
                }
            }

            initWidget("#task-listview", "kendoListView", {
                dataSource: taskDataSource,
                template: kendo.template($("#task-row-template").html())
            });

            initWidget("#task-pager", "kendoPager", {
                dataSource: taskDataSource,
                buttonCount: 5,
                pageSizes: [5, 10, 20],
                refresh: true
            });

            initWidget("#table-search", "kendoTextBox", {
                placeholder: "Nhập tên, người phụ trách, ghi chú..."
            });

            initWidget("#table-category", "kendoDropDownList", {
                optionLabel: "Tất cả",
                dataTextField: "text",
                dataValueField: "value",
                dataSource: [
                    { text: "UI", value: "UI" },
                    { text: "Localization", value: "Localization" },
                    { text: "Culture", value: "Culture" },
                    { text: "Kendo Core", value: "Kendo Core" },
                    { text: "Testing", value: "Testing" }
                ],
                change: applyTableState,
                popup: popupOptions
            });

            initWidget("#table-sort", "kendoDropDownList", {
                dataTextField: "text",
                dataValueField: "value",
                dataSource: [
                    { text: "Hạn gần nhất", value: "due-asc", field: "due", dir: "asc" },
                    { text: "Tiến độ cao nhất", value: "progress-desc", field: "progress", dir: "desc" },
                    { text: "Ngân sách cao nhất", value: "budget-desc", field: "budget", dir: "desc" },
                    { text: "Tên A-Z", value: "name-asc", field: "name", dir: "asc" }
                ],
                change: function () {
                    const item = this.dataItem();
                    taskDataSource.sort({ field: item.field, dir: item.dir });
                },
                popup: popupOptions
            });

            initWidget("#table-reset", "kendoButton", {
                themeColor: "secondary",
                click: function () {
                    $("#table-search").val("");
                    $("#table-category").data("kendoDropDownList")?.value("");
                    $("#table-sort").data("kendoDropDownList")?.value("due-asc");
                    taskDataSource.filter({});
                    taskDataSource.sort({ field: "due", dir: "asc" });
                }
            });

            let searchTimer = null;
            $("#table-search").on("input", function () {
                window.clearTimeout(searchTimer);
                searchTimer = window.setTimeout(applyTableState, 180);
            });

            function applyTableState() {
                const search = ($("#table-search").val() || "").trim();
                const category = $("#table-category").data("kendoDropDownList")?.value();
                const filters = [];

                if (search) {
                    filters.push({
                        logic: "or",
                        filters: [
                            { field: "name", operator: "contains", value: search },
                            { field: "owner", operator: "contains", value: search },
                            { field: "note", operator: "contains", value: search }
                        ]
                    });
                }

                if (category) {
                    filters.push({ field: "category", operator: "eq", value: category });
                }

                taskDataSource.filter(filters.length ? { logic: "and", filters: filters } : {});
            }

            function updateSummary() {
                const fullData = taskDataSource.data().toJSON();
                const totalProgress = fullData.reduce(function (sum, item) { return sum + item.progress; }, 0);
                const doneCount = fullData.filter(function (item) { return item.statusCode === "done"; }).length;

                $("#summary-total").text(fullData.length);
                $("#summary-visible").text(taskDataSource.total());
                $("#summary-done").text(doneCount);
                $("#summary-progress").text(Math.round(totalProgress / fullData.length) + "%");
            }

            const detailWindow = initWidget("#task-detail-window", "kendoWindow", {
                width: "460px",
                title: "Chi tiết công việc",
                visible: false,
                modal: true,
                actions: ["Minimize", "Maximize", "Close"]
            });

            $("#task-listview").on("click", "[data-task-detail]", function () {
                const item = taskDataSource.get(Number($(this).data("task-id")));
                if (!item || !detailWindow) return;

                detailWindow.content(
                    "<div class='p-3'>" +
                    "<h5>" + kendo.htmlEncode(item.name) + "</h5>" +
                    "<p class='muted mb-2'>" + kendo.htmlEncode(item.note) + "</p>" +
                    "<div><strong>Người phụ trách:</strong> " + kendo.htmlEncode(item.owner) + "</div>" +
                    "<div><strong>Hạn:</strong> " + kendo.toString(item.due, "dd/MM/yyyy") + "</div>" +
                    "<div><strong>Ngân sách:</strong> " + kendo.toString(item.budget, "c0") + "</div>" +
                    "</div>"
                );
                detailWindow.center().open();
            });

            initWidget("#kendo-autocomplete", "kendoAutoComplete", {
                dataSource: ["UI", "API", "SQL", "Localization", "Kendo Core", "Popup", "Culture", "Testing", "Dashboard"],
                filter: "contains",
                minLength: 1,
                suggest: true,
                height: 260,
                popup: popupOptions
            });

            initWidget("#kendo-multiselect", "kendoMultiSelect", {
                placeholder: "Chọn các danh mục...",
                dataTextField: "text",
                dataValueField: "value",
                dataSource: [
                    { text: "Giao diện UI", value: "ui" },
                    { text: "Cơ sở dữ liệu", value: "database" },
                    { text: "Đa ngôn ngữ", value: "localization" },
                    { text: "Bảo mật", value: "security" },
                    { text: "Kiểm thử", value: "testing" }
                ],
                value: ["ui", "localization"],
                autoClose: false,
                filter: "contains",
                height: 260,
                popup: popupOptions
            });

            initWidget("#kendo-combobox", "kendoComboBox", {
                placeholder: "Chọn hoặc nhập tỉnh/thành...",
                dataTextField: "text",
                dataValueField: "value",
                dataSource: [
                    { text: "Hà Nội", value: "HN" },
                    { text: "TP. Hồ Chí Minh", value: "HCM" },
                    { text: "Đà Nẵng", value: "DN" },
                    { text: "Hải Phòng", value: "HP" },
                    { text: "Cần Thơ", value: "CT" }
                ],
                filter: "contains",
                suggest: true,
                popup: popupOptions
            });

            initWidget("#kendo-dropdownlist", "kendoDropDownList", {
                dataTextField: "text",
                dataValueField: "value",
                dataSource: [
                    { text: "Ưu tiên cao", value: "high" },
                    { text: "Ưu tiên trung bình", value: "medium" },
                    { text: "Ưu tiên thấp", value: "low" }
                ],
                popup: popupOptions
            });

            initWidget("#kendo-listbox", "kendoListBox", {
                dataTextField: "text",
                dataValueField: "value",
                dataSource: [
                    { text: "Thiết kế form", value: "form" },
                    { text: "Sửa popup", value: "popup" },
                    { text: "Kiểm tra responsive", value: "responsive" },
                    { text: "Build release", value: "build" }
                ],
                selectable: "multiple"
            });

            initWidget("#kendo-datepicker", "kendoDatePicker", {
                value: new Date(),
                format: "dd/MM/yyyy",
                popup: popupOptions
            });

            initWidget("#kendo-datetimepicker", "kendoDateTimePicker", {
                value: new Date(),
                format: "dd/MM/yyyy HH:mm",
                timeFormat: "HH:mm",
                popup: popupOptions
            });

            initWidget("#kendo-numeric", "kendoNumericTextBox", {
                format: "c0",
                value: 5000000,
                min: 0,
                step: 100000
            });

            initWidget("#kendo-slider", "kendoSlider", {
                min: 0,
                max: 100,
                smallStep: 5,
                largeStep: 20,
                value: 65,
                showButtons: true
            });

            initWidget("#kendo-phone", "kendoMaskedTextBox", {
                mask: "0000 000 000",
                value: "0900000000"
            });

            initWidget("#kendo-timepicker", "kendoTimePicker", {
                value: new Date(2026, 5, 17, 9, 30),
                format: "HH:mm",
                interval: 15,
                popup: popupOptions
            });

            function syncColorPreview(value) {
                const nextColor = value || "#2563eb";
                $("#kendo-color-value").text(nextColor);
                $("#kendo-color-preview").css("background-color", nextColor);
            }

            const colorPicker = initWidget("#kendo-colorpicker", "kendoColorPicker", {
                value: "#2563eb",
                buttons: false,
                change: function () {
                    syncColorPreview(this.value());
                },
                select: function (e) {
                    syncColorPreview(e.value);
                }
            });
            syncColorPreview(colorPicker?.value());

            initWidget("#kendo-email", "kendoTextBox", {
                placeholder: "ten@congty.vn"
            });

            const validator = initWidget("#kendo-validation-form", "kendoValidator");
            initWidget("#validate-form-btn", "kendoButton", {
                themeColor: "primary",
                click: function () {
                    const valid = validator ? validator.validate() : false;
                    notification?.show(valid ? "Form hợp lệ." : "Form chưa hợp lệ, vui lòng kiểm tra email.", valid ? "success" : "error");
                }
            });

            initWidget("#kendo-menu", "kendoMenu", {
                animation: { open: { effects: "fadeIn" } },
                popupCollision: "fit flip"
            });

            initWidget("#kendo-splitter", "kendoSplitter", {
                panes: [
                    { size: "52%", collapsible: true },
                    { collapsible: true }
                ]
            });

            initWidget("#kendo-panelbar", "kendoPanelBar", {
                expandMode: "multiple"
            });

            const demoWindow = initWidget("#kendo-window", "kendoWindow", {
                width: "460px",
                title: "Kendo Window",
                visible: false,
                modal: true,
                actions: ["Pin", "Minimize", "Maximize", "Close"]
            });

            const dialog = initWidget("#kendo-dialog", "kendoDialog", {
                width: "420px",
                title: "Kendo Dialog",
                visible: false,
                closable: true,
                modal: true,
                actions: [{ text: "Đóng" }]
            });

            const notification = initWidget("#kendo-notification", "kendoNotification", {
                position: { pinned: true, top: 88, right: 28 },
                stacking: "down",
                autoHideAfter: 2800
            });

            initWidget("#show-window-btn", "kendoButton", {
                themeColor: "primary",
                click: function () { demoWindow?.center().open(); }
            });

            initWidget("#show-dialog-btn", "kendoButton", {
                themeColor: "secondary",
                click: function () { dialog?.open(); }
            });

            initWidget("#show-notification-btn", "kendoButton", {
                themeColor: "tertiary",
                click: function () { notification?.show("Kendo Notification hoạt động trong ToolboxWeb.", "info"); }
            });

            initWidget("#tooltip-target", "kendoTooltip", {
                content: "Tooltip này dùng đúng browser bundle self-host và vẫn nằm trên layer popup chuẩn của app.",
                position: "bottom",
                width: 300
            });

            initWidget("#kendo-progress", "kendoProgressBar", {
                min: 0,
                max: 100,
                value: 68,
                type: "percent"
            });

            taskDataSource.read();
        })(jQuery);
    </script>
}
