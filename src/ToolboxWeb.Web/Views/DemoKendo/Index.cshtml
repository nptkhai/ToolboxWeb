@using System.Text.Json
@using ToolboxWeb.Web.Constants
@using ToolboxWeb.Web.Infrastructure.Time
@*
    Kendo UI Core demo, a developer page ([DevToolsOnly]), stage 5.13. Every card shows the
    widget's status from ViewModels/ComponentCatalog.cs (_DemoCardHead). Layout comes from
    component-hub.css and dev-demo.css; behavior from Content/js/kendo-demo.js. The sample rows
    live in the browser only: deleting one asks first and is gone after a reload.
*@
@{
    ViewData["Title"] = T["Nav.KendoDemo"];
    var activeTab = ViewData["ActiveTab"] as string ?? ToolboxRouteSlugs.KendoDemoTabs.Default;

    bool IsActiveTab(string tab) => string.Equals(activeTab, tab, StringComparison.OrdinalIgnoreCase);
    string TabButtonClass(string tab) => IsActiveTab(tab) ? "nav-link active" : "nav-link";
    string TabPaneClass(string tab) => IsActiveTab(tab) ? "tab-pane fade show active" : "tab-pane fade";
    string TabSelected(string tab) => IsActiveTab(tab) ? "true" : "false";
    string TabRoute(string tab) => Url.RouteUrl(ToolboxRouteSlugs.RouteNames.KendoDemoTabHtml, new { tab }) ?? $"/demo-kendo/{tab}.html";

    var componentsHref = Url.RouteUrl(ToolboxRouteSlugs.RouteNames.ComponentsHtml) ?? "/component.html";
    var tabulatorHref = Url.RouteUrl(ToolboxRouteSlugs.RouteNames.TabulatorDemoHtml) ?? "/tabulator-demo.html";

    var tabs = new[]
    {
        (Key: ToolboxRouteSlugs.KendoDemoTabs.DataSourceListView, Id: "data", Label: T["KendoDemo.Tab.Data"].Value),
        (Key: ToolboxRouteSlugs.KendoDemoTabs.Selection, Id: "selection", Label: T["KendoDemo.Tab.Selection"].Value),
        (Key: ToolboxRouteSlugs.KendoDemoTabs.FormCulture, Id: "form", Label: T["KendoDemo.Tab.Form"].Value),
        (Key: ToolboxRouteSlugs.KendoDemoTabs.LayoutPopup, Id: "layout", Label: T["KendoDemo.Tab.Layout"].Value)
    };

    string Category(string code) => T["TabulatorTaskCategory." + code].Value;
    string Status(string code) => T["TabulatorTaskStatus." + code].Value;
    string Priority(string code) => T["TabulatorTaskPriority." + code].Value;

    // Sample rows: due dates count from today in the app time zone, so the demo never looks stale.
    var today = AppClock.Today;
    var samples = new[]
    {
        (Id: 1, Owner: "Khai", Category: "Ui", Status: "InProgress", StatusCode: "doing", Priority: "High", Progress: 72, Budget: 1250000, Days: 1),
        (Id: 2, Owner: "Frontend", Category: "Localization", Status: "Done", StatusCode: "done", Priority: "High", Progress: 100, Budget: 980000, Days: 2),
        (Id: 3, Owner: "Khai", Category: "Culture", Status: "Review", StatusCode: "review", Priority: "Medium", Progress: 84, Budget: 620000, Days: 3),
        (Id: 4, Owner: "Backend", Category: "Operations", Status: "Todo", StatusCode: "todo", Priority: "Medium", Progress: 10, Budget: 750000, Days: 5),
        (Id: 5, Owner: "QA", Category: "Testing", Status: "Review", StatusCode: "review", Priority: "Low", Progress: 48, Budget: 420000, Days: 6),
        (Id: 6, Owner: "DevOps", Category: "Operations", Status: "Done", StatusCode: "done", Priority: "Low", Progress: 100, Budget: 350000, Days: 8)
    };

    var json = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var pageData = JsonSerializer.Serialize(new
    {
        Tasks = samples.Select(x => new
        {
            x.Id,
            Name = T[$"KendoDemo.Sample.{x.Id}.Name"].Value,
            Note = T[$"KendoDemo.Sample.{x.Id}.Note"].Value,
            x.Owner,
            x.Category,
            CategoryLabel = Category(x.Category),
            x.StatusCode,
            StatusLabel = Status(x.Status),
            PriorityCode = x.Priority.ToLowerInvariant(),
            PriorityLabel = Priority(x.Priority),
            x.Progress,
            x.Budget,
            Due = today.AddDays(x.Days).ToString("yyyy-MM-dd")
        }),
        Categories = new[] { "Ui", "Localization", "Culture", "Testing", "Operations" }.Select(x => new { Value = x, Text = Category(x) }),
        Priorities = new[] { "High", "Medium", "Low" }.Select(x => new { Value = x.ToLowerInvariant(), Text = Priority(x) }),
        Text = new
        {
            Summary = T["KendoDemo.Summary"].Value,
            Detail = T["KendoDemo.Detail"].Value,
            DetailTitle = T["KendoDemo.DetailTitle"].Value,
            Owner = T["KendoDemo.Owner"].Value,
            Due = T["KendoDemo.Due"].Value,
            Budget = T["KendoDemo.Budget"].Value,
            Progress = T["TabulatorDemo.Columns.Progress"].Value,
            Delete = T["Action.Delete"].Value,
            DeleteTitle = T["Confirm.DeleteTitle"].Value,
            DeleteConfirm = T["KendoDemo.DeleteConfirm"].Value,
            Deleted = T["KendoDemo.Deleted"].Value,
            Missing = T["KendoDemo.Missing"].Value,
            ValidOk = T["KendoDemo.ValidOk"].Value,
            ValidFail = T["KendoDemo.ValidFail"].Value,
            EmailRequired = T["KendoDemo.EmailRequired"].Value,
            WindowTitle = T["KendoDemo.WindowTitle"].Value,
            Tooltip = T["KendoDemo.TooltipText"].Value,
            NotifyInfo = T["KendoDemo.NotifyInfo"].Value,
            NotifySuccess = T["KendoDemo.NotifySuccess"].Value,
            NotifyError = T["KendoDemo.NotifyError"].Value,
            MultiSelectPlaceholder = T["KendoDemo.MultiSelectPlaceholder"].Value,
            ComboPlaceholder = T["KendoDemo.ComboPlaceholder"].Value
        }
    }, json);

    var emptyState = new EmptyStateViewModel(T["KendoDemo.NoMatch"].Value, "search");
}

@section Styles {
    <link rel="stylesheet" href="~/vendor/kendo/icons/index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/vendor/kendo/theme/default-main.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/component-hub.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dev-demo.css" asp-append-version="true" />
}

<div class="component-hub dev-demo kendo-demo" data-kendo-demo>
    <section class="tbx-panel component-intro">
        <p>@T["KendoDemo.Intro"]</p>
        <div class="component-intro-links">
            <a class="btn btn-outline-secondary btn-sm" href="@componentsHref"><tbx-icon name="layout-grid" />@T["Nav.Components"]</a>
            <a class="btn btn-outline-secondary btn-sm" href="@tabulatorHref"><tbx-icon name="table" />@T["Nav.TabulatorDemo"]</a>
        </div>
    </section>

    <div class="component-tabs-shell">
        <ul class="nav nav-tabs component-tab-nav" id="kendo-demo-tabs" role="tablist">
            @foreach (var tab in tabs)
            {
                <li class="nav-item" role="presentation">
                    <button class="@TabButtonClass(tab.Key)" id="kd-tab-@tab.Id" type="button" role="tab"
                            data-bs-toggle="tab" data-bs-target="#kd-pane-@tab.Id" aria-controls="kd-pane-@tab.Id"
                            aria-selected="@TabSelected(tab.Key)" data-route-url="@TabRoute(tab.Key)">@tab.Label</button>
                </li>
            }
        </ul>

        <div class="tab-content component-tab-content">
            @* ------------------------------------------------------------ data *@
            <div class="@TabPaneClass(ToolboxRouteSlugs.KendoDemoTabs.DataSourceListView)" id="kd-pane-data" role="tabpanel" aria-labelledby="kd-tab-data" tabindex="0">
                <article class="component-card">
                    <partial name="_DemoCardHead" model="@(("kendo-listview", "Kendo DataSource + ListView + Pager", T["KendoDemo.Card.ListView"].Value))" />

                    <div class="tbx-form-grid demo-filters">
                        <div class="tbx-field">
                            <label class="tbx-field-label" for="kd-search">@T["Action.Search"]</label>
                            <input class="form-control" id="kd-search" type="search" autocomplete="off" placeholder="@T["KendoDemo.SearchPlaceholder"]" data-kd-search />
                        </div>
                        <div class="tbx-field">
                            <label class="tbx-field-label" for="kd-category">@T["TabulatorDemo.Columns.Category"]</label>
                            <input id="kd-category" placeholder="@T["KendoDemo.AllCategories"]" data-kd-category />
                        </div>
                        <div class="tbx-field">
                            <label class="tbx-field-label" for="kd-sort">@T["KendoDemo.SortLabel"]</label>
                            <select class="form-select" id="kd-sort" data-kd-sort>
                                <option value="due-asc">@T["KendoDemo.Sort.Due"]</option>
                                <option value="progress-desc">@T["KendoDemo.Sort.Progress"]</option>
                                <option value="name-asc">@T["KendoDemo.Sort.Name"]</option>
                            </select>
                        </div>
                        <div class="demo-filters-reset">
                            <button class="btn btn-outline-secondary" type="button" data-kd-reset><tbx-icon name="refresh-cw" />@T["Action.Reset"]</button>
                        </div>
                    </div>

                    <p class="tbx-toolbar-summary demo-summary" data-kd-summary aria-live="polite"></p>
                    <div class="tbx-list demo-list" id="kd-listview" role="list" aria-label="@T["KendoDemo.ListLabel"]"></div>
                    <div class="demo-list-empty" data-kd-empty hidden>
                        <partial name="_EmptyState" model="emptyState" />
                        <button class="btn btn-outline-secondary btn-sm" type="button" data-kd-reset>@T["KendoDemo.ClearFilters"]</button>
                    </div>
                    <div id="kd-pager"></div>
                </article>
            </div>

            @* ------------------------------------------------------------ selection *@
            <div class="@TabPaneClass(ToolboxRouteSlugs.KendoDemoTabs.Selection)" id="kd-pane-selection" role="tabpanel" aria-labelledby="kd-tab-selection" tabindex="0">
                <div class="component-card-grid">
                    <article class="component-card">
                        <partial name="_DemoCardHead" model="@(("kendo-autocomplete", "Kendo AutoComplete", T["KendoDemo.Card.AutoComplete"].Value))" />
                        <div class="component-sample">
                            <label class="form-label" for="kd-autocomplete">@T["KendoDemo.Keyword"]</label>
                            <input id="kd-autocomplete" placeholder="UI, API, SQL…" />
                        </div>
                    </article>
                    <article class="component-card">
                        <partial name="_DemoCardHead" model="@(("kendo-multiselect", "Kendo MultiSelect", T["KendoDemo.Card.MultiSelect"].Value))" />
                        <div class="component-sample">
                            <label class="form-label" for="kd-multiselect">@T["TabulatorDemo.Columns.Category"]</label>
                            <select id="kd-multiselect" multiple></select>
                        </div>
                    </article>
                    <article class="component-card">
                        <partial name="_DemoCardHead" model="@(("kendo-combobox", "Kendo ComboBox", T["KendoDemo.Card.ComboBox"].Value))" />
                        <div class="component-sample">
                            <label class="form-label" for="kd-combobox">@T["KendoDemo.Language"]</label>
                            <input id="kd-combobox" />
                        </div>
                    </article>
                    <article class="component-card">
                        <partial name="_DemoCardHead" model="@(("kendo-dropdownlist", "Kendo DropDownList", T["KendoDemo.Card.DropDownList"].Value))" />
                        <div class="component-sample">
                            <label class="form-label" for="kd-dropdownlist">@T["TabulatorDemo.Columns.Priority"]</label>
                            <input id="kd-dropdownlist" />
                        </div>
                    </article>
                    <article class="component-card component-card-wide">
                        <partial name="_DemoCardHead" model="@(("kendo-listbox", "Kendo ListBox", T["KendoDemo.Card.ListBox"].Value))" />
                        <div class="component-sample">
                            <label class="form-label" for="kd-listbox">@T["KendoDemo.ListBoxLabel"]</label>
                            <select id="kd-listbox"></select>
                        </div>
                    </article>
                </div>
            </div>

            @* ------------------------------------------------------------ dates, numbers, form *@
            <div class="@TabPaneClass(ToolboxRouteSlugs.KendoDemoTabs.FormCulture)" id="kd-pane-form" role="tabpanel" aria-labelledby="kd-tab-form" tabindex="0">
                <div class="component-card-grid">
                    <article class="component-card">
                        <partial name="_DemoCardHead" model="@(("kendo-datepicker", "Kendo DatePicker", T["KendoDemo.Card.DatePicker"].Value))" />
                        <div class="component-sample">
                            <label class="form-label" for="kd-datepicker">@T["KendoDemo.Due"]</label>
                            <input id="kd-datepicker" />
                        </div>
                    </article>
                    <article class="component-card">
                        <partial name="_DemoCardHead" model="@(("kendo-datetimepicker", "Kendo DateTimePicker", T["KendoDemo.Card.DateTimePicker"].Value))" />
                        <div class="component-sample">
                            <label class="form-label" for="kd-datetimepicker">@T["KendoDemo.Meeting"]</label>
                            <input id="kd-datetimepicker" />
                        </div>
                    </article>
                    <article class="component-card">
                        <partial name="_DemoCardHead" model="@(("kendo-timepicker", "Kendo TimePicker", T["KendoDemo.Card.TimePicker"].Value))" />
                        <div class="component-sample">
                            <label class="form-label" for="kd-timepicker">@T["KendoDemo.Reminder"]</label>
                            <input id="kd-timepicker" />
                        </div>
                    </article>
                    <article class="component-card">
                        <partial name="_DemoCardHead" model="@(("kendo-numeric", "Kendo NumericTextBox", T["KendoDemo.Card.Numeric"].Value))" />
                        <div class="component-sample">
                            <label class="form-label" for="kd-numeric">@T["KendoDemo.Budget"]</label>
                            <input id="kd-numeric" />
                        </div>
                    </article>
                    <article class="component-card">
                        <partial name="_DemoCardHead" model="@(("kendo-slider", "Kendo Slider", T["KendoDemo.Card.Slider"].Value))" />
                        <div class="component-sample">
                            <label class="form-label" for="kd-slider">@T["KendoDemo.ProgressPercent"]</label>
                            <input id="kd-slider" />
                        </div>
                    </article>
                    <article class="component-card">
                        <partial name="_DemoCardHead" model="@(("kendo-masked", "Kendo MaskedTextBox", T["KendoDemo.Card.Masked"].Value))" />
                        <div class="component-sample">
                            <label class="form-label" for="kd-phone">@T["KendoDemo.Phone"]</label>
                            <input id="kd-phone" />
                        </div>
                    </article>
                    <article class="component-card component-card-wide">
                        <partial name="_DemoCardHead" model="@(("kendo-validator", "Kendo Validator", T["KendoDemo.Card.Validator"].Value))" />
                        <form class="component-sample demo-validator" id="kd-validation-form" novalidate>
                            <div class="tbx-field">
                                <label class="tbx-field-label" for="kd-email">@T["KendoDemo.Email"]</label>
                                <input class="form-control" id="kd-email" name="Email" type="email" required autocomplete="off"
                                       placeholder="@T["KendoDemo.EmailPlaceholder"]" />
                                <span class="k-invalid-msg" data-for="Email"></span>
                            </div>
                            <button class="btn btn-outline-secondary" type="submit">@T["KendoDemo.Validate"]</button>
                            <p class="demo-validator-result" data-kd-validate-result aria-live="polite"></p>
                        </form>
                    </article>
                </div>
            </div>

            @* ------------------------------------------------------------ layout, popup *@
            <div class="@TabPaneClass(ToolboxRouteSlugs.KendoDemoTabs.LayoutPopup)" id="kd-pane-layout" role="tabpanel" aria-labelledby="kd-tab-layout" tabindex="0">
                <div class="component-card-grid">
                    <article class="component-card component-card-wide">
                        <partial name="_DemoCardHead" model="@(("kendo-menu", "Kendo Menu", T["KendoDemo.Card.Menu"].Value))" />
                        <div class="component-sample">
                            <ul id="kd-menu">
                                <li>@T["Nav.Group.Personal"]
                                    <ul>
                                        <li>@T["Nav.Notes"]</li>
                                        <li>@T["Nav.Checklist"]</li>
                                        <li>@T["Nav.FocusTimer"]</li>
                                    </ul>
                                </li>
                                <li>@T["Nav.Group.Database"]
                                    <ul>
                                        <li>@T["Nav.SchemaCompare"]</li>
                                        <li>@T["Nav.SqlProfiler"]</li>
                                    </ul>
                                </li>
                                <li>@T["Nav.Dashboard"]</li>
                            </ul>
                        </div>
                    </article>
                    <article class="component-card component-card-wide">
                        <partial name="_DemoCardHead" model="@(("kendo-splitter", "Kendo Splitter + PanelBar", T["KendoDemo.Card.Splitter"].Value))" />
                        <div id="kd-splitter" class="demo-splitter">
                            <div class="demo-split-pane">
                                <strong>@T["KendoDemo.SplitMain"]</strong>
                                <p>@T["KendoDemo.SplitMainText"]</p>
                            </div>
                            <div class="demo-split-pane">
                                <ul id="kd-panelbar">
                                    <li class="k-state-active">@T["KendoDemo.Panel1"]
                                        <div class="demo-panel-body">@T["KendoDemo.Panel1Text"]</div>
                                    </li>
                                    <li>@T["KendoDemo.Panel2"]
                                        <div class="demo-panel-body">@T["KendoDemo.Panel2Text"]</div>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </article>
                    <article class="component-card">
                        <partial name="_DemoCardHead" model="@(("kendo-window", "Kendo Window", T["KendoDemo.Card.Window"].Value))" />
                        <div class="component-sample">
                            <button class="btn btn-outline-secondary" type="button" data-kd-open-window>@T["KendoDemo.OpenWindow"]</button>
                        </div>
                    </article>
                    <article class="component-card">
                        <partial name="_DemoCardHead" model="@(("kendo-tooltip", "Kendo Tooltip", T["KendoDemo.Card.Tooltip"].Value))" />
                        <div class="component-sample">
                            <button class="btn btn-outline-secondary" type="button" id="kd-tooltip-target">@T["KendoDemo.TooltipTarget"]</button>
                        </div>
                    </article>
                    <article class="component-card component-card-wide">
                        <partial name="_DemoCardHead" model="@(("kendo-notification", "Kendo Notification", T["KendoDemo.Card.Notification"].Value))" />
                        <div class="component-sample demo-buttons">
                            <button class="btn btn-outline-secondary" type="button" data-kd-notify="info">@T["KendoDemo.NotifyInfoButton"]</button>
                            <button class="btn btn-outline-secondary" type="button" data-kd-notify="success">@T["KendoDemo.NotifySuccessButton"]</button>
                            <button class="btn btn-outline-secondary" type="button" data-kd-notify="error">@T["KendoDemo.NotifyErrorButton"]</button>
                        </div>
                    </article>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="kd-detail-window" class="demo-window-source"></div>
<div id="kd-window" class="demo-window-source">
    <div class="demo-window-body">
        <p>@T["KendoDemo.WindowText"]</p>
    </div>
</div>

<script id="kendo-demo-data" type="application/json">@Html.Raw(pageData)</script>

@section Scripts {
    <partial name="_KendoScripts" />
    <script src="~/js/kendo-demo.js" asp-append-version="true"></script>
}
