@model FocusSessionFormViewModel
@{
    ViewData["Title"] = T["FocusTimer.Title"];
    var sessions = ViewBag.RecentSessions as IReadOnlyList<FocusSession> ?? [];
}

<div class="tool-grid">
    <section class="panel span-6">
        <div class="panel-header"><h2>@T["FocusTimer.Timer"]</h2></div>
        <form asp-action="Complete" method="post" class="form-grid">
            <div data-focus-timer data-minutes="@Model.DurationMinutes" data-finished-message="@T["FocusTimer.Finished"]">
                <div class="timer-display" data-timer-display>25:00</div>
                <div class="inline-actions justify-content-center mt-3">
                    <button class="btn btn-primary" type="button" data-timer-start>@T["Action.Start"]</button>
                    <button class="btn btn-outline-secondary" type="button" data-timer-pause>@T["Action.Pause"]</button>
                    <button class="btn btn-outline-secondary" type="button" data-timer-reset>@T["Action.Reset"]</button>
                </div>
            </div>
            <label>
                @T["FocusTimer.DurationMinutes"]
                <input asp-for="DurationMinutes" class="form-control" />
            </label>
            <label>
                @T["FocusTimer.SessionNote"]
                <textarea asp-for="Note" class="form-control" rows="3"></textarea>
            </label>
            @* Enabled by site.js once the countdown reaches zero, so only finished sessions are saved. *@
            <button class="btn btn-primary" type="submit" data-timer-save disabled aria-describedby="focus-save-hint">@T["FocusTimer.SaveCompletedSession"]</button>
            <div class="form-text" id="focus-save-hint">@T["FocusTimer.SaveHint"]</div>
        </form>
    </section>

    <section class="panel span-6">
        <div class="panel-header"><h2>@T["FocusTimer.RecentSessions"]</h2></div>
        <div class="stack">
            @foreach (var session in sessions)
            {
                <div class="item-row">
                    <div>
                        <div class="item-title">@T["Common.Minutes", session.DurationMinutes]</div>
                        <div class="item-meta">@session.CompletedAt.ToDisplayAppDateTime()</div>
                        <div>@session.Note</div>
                    </div>
                </div>
            }
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
