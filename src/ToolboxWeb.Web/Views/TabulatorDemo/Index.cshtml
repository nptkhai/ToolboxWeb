@using System.Text.Json
@using ToolboxWeb.Web.Constants
@*
    Tabulator demo, a developer page ([DevToolsOnly]), stage 5.13: an editable grid whose rows
    belong to the signed-in user (TabulatorTaskService). Added, edited and deleted rows stay in
    the browser until "Save changes" sends them in one request. Layout comes from
    component-hub.css and dev-demo.css; behavior from Content/js/tabulator-demo.js.
*@
@{
    ViewData["Title"] = T["Nav.TabulatorDemo"];

    var componentsHref = Url.RouteUrl(ToolboxRouteSlugs.RouteNames.ComponentsHtml) ?? "/component.html";
    var kendoHref = Url.RouteUrl(ToolboxRouteSlugs.RouteNames.KendoDemoHtml) ?? "/demo-kendo.html";

    object Options(string prefix, params string[] codes) =>
        codes.Select(code => new { Value = code, Label = T[prefix + code].Value });

    var json = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var pageData = JsonSerializer.Serialize(new
    {
        DataUrl = Url.Action("Data", "TabulatorDemo"),
        SaveUrl = Url.Action("Save", "TabulatorDemo"),
        LoginUrl = Url.Page("/Account/Login", new { area = "Identity", ReturnUrl = Url.Action("Index", "TabulatorDemo") }),
        Categories = Options("TabulatorTaskCategory.", "Ui", "Localization", "Culture", "Testing", "Operations"),
        Statuses = Options("TabulatorTaskStatus.", "Todo", "InProgress", "Review", "Done"),
        Priorities = Options("TabulatorTaskPriority.", "Low", "Medium", "High"),
        Text = new
        {
            CleanState = T["TabulatorDemo.CleanState"].Value,
            DirtyState = T["TabulatorDemo.DirtyState"].Value,
            RowCount = T["TabulatorDemo.RowCount"].Value,
            SaveCount = T["TabulatorDemo.SaveChangesCount"].Value,
            Save = T["TabulatorDemo.SaveChanges"].Value,
            DeleteCount = T["TabulatorDemo.DeleteSelectedCount"].Value,
            Delete = T["TabulatorDemo.DeleteSelected"].Value,
            DeleteTitle = T["TabulatorDemo.DeleteTitle"].Value,
            DeleteConfirm = T["TabulatorDemo.DeleteConfirm"].Value,
            DeleteMore = T["TabulatorDemo.DeleteMore"].Value,
            DeleteOk = T["Action.Delete"].Value,
            Untitled = T["TabulatorDemo.Untitled"].Value,
            TitleRequired = T["TabulatorDemo.ValidationTitleRequired"].Value,
            ReloadTitle = T["TabulatorDemo.ReloadTitle"].Value,
            ReloadConfirm = T["TabulatorDemo.ReloadConfirm"].Value,
            ReloadOk = T["TabulatorDemo.ReloadOk"].Value,
            Ready = T["TabulatorDemo.Ready"].Value,
            Pending = T["TabulatorDemo.PendingChangesNotice"].Value,
            Reloaded = T["TabulatorDemo.Reloaded"].Value,
            RowAdded = T["TabulatorDemo.RowAdded"].Value,
            RowsDeleted = T["TabulatorDemo.RowsDeleted"].Value,
            Saving = T["TabulatorDemo.Saving"].Value,
            SaveSuccess = T["TabulatorDemo.SaveSuccess"].Value,
            GenericError = T["TabulatorDemo.GenericError"].Value,
            Columns = new
            {
                Title = T["TabulatorDemo.Columns.Title"].Value,
                Category = T["TabulatorDemo.Columns.Category"].Value,
                Status = T["TabulatorDemo.Columns.Status"].Value,
                Priority = T["TabulatorDemo.Columns.Priority"].Value,
                Progress = T["TabulatorDemo.Columns.Progress"].Value,
                Budget = T["TabulatorDemo.Columns.Budget"].Value,
                DueDate = T["TabulatorDemo.Columns.DueDate"].Value,
                Note = T["TabulatorDemo.Columns.Note"].Value,
                UpdatedAt = T["TabulatorDemo.Columns.UpdatedAt"].Value,
                Select = T["TabulatorDemo.Columns.Select"].Value
            }
        }
    }, json);
}

@section Styles {
    <link rel="stylesheet" href="~/vendor/tabulator/css/tabulator.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/component-hub.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dev-demo.css" asp-append-version="true" />
}

<div class="component-hub dev-demo tabulator-demo" data-tabulator-demo>
    <section class="tbx-panel component-intro">
        <p>@T["TabulatorDemo.Description"]</p>
        <div class="component-intro-links">
            <a class="btn btn-outline-secondary btn-sm" href="@componentsHref"><tbx-icon name="layout-grid" />@T["Nav.Components"]</a>
            <a class="btn btn-outline-secondary btn-sm" href="@kendoHref"><tbx-icon name="layout-grid" />@T["Nav.KendoDemo"]</a>
        </div>
    </section>

    <article class="component-card">
        <partial name="_DemoCardHead" model="@(("tabulator", "Tabulator", T["TabulatorDemo.Card"].Value))" />
        @Html.AntiForgeryToken()

        <div class="demo-grid-shell" data-state="loading">
            <header class="tbx-toolbar demo-grid-toolbar">
                <button class="btn btn-primary" type="button" data-td-save disabled>
                    <tbx-icon name="save" /><span data-td-save-text>@T["TabulatorDemo.SaveChanges"]</span>
                </button>
                <button class="btn btn-outline-secondary" type="button" data-td-add>
                    <tbx-icon name="plus" />@T["TabulatorDemo.AddRow"]
                </button>
                <button class="btn btn-outline-secondary" type="button" data-td-reload>
                    <tbx-icon name="refresh-cw" />@T["TabulatorDemo.Reload"]
                </button>
                <span class="demo-grid-state">
                    <span class="tbx-pill is-neutral" data-td-dirty>@T["TabulatorDemo.CleanState"]</span>
                    <span class="tbx-toolbar-summary" data-td-count></span>
                </span>
                <span class="tbx-toolbar-spacer"></span>
                <button class="btn btn-outline-danger" type="button" data-td-delete disabled>
                    <tbx-icon name="trash-2" /><span data-td-delete-text>@T["TabulatorDemo.DeleteSelected"]</span>
                </button>
            </header>

            <div class="demo-grid-loading" data-td-loading aria-busy="true">
                <span class="tbx-skeleton"></span>
                <span class="tbx-skeleton"></span>
                <span class="tbx-skeleton"></span>
            </div>
            <div class="tbx-error-state demo-grid-error" data-td-error role="alert" hidden>
                <tbx-icon name="circle-alert" />
                <span data-td-error-text>@T["TabulatorDemo.LoadError"]</span>
                <button class="btn btn-outline-secondary btn-sm" type="button" data-td-retry>@T["TabulatorDemo.Retry"]</button>
            </div>
            <div id="tabulator-grid" class="demo-grid"></div>

            <template data-td-empty>
                <div class="tbx-empty">
                    <span class="tbx-empty-icon"><tbx-icon name="table" size="20" /></span>
                    <p class="tbx-empty-text">@T["TabulatorDemo.EmptyState"]</p>
                </div>
            </template>

            <p class="demo-grid-feedback" data-td-feedback aria-live="polite"></p>
        </div>
    </article>
</div>

<script id="tabulator-demo-data" type="application/json">@Html.Raw(pageData)</script>

@section Scripts {
    <script src="~/vendor/tabulator/js/tabulator.min.js" asp-append-version="true"></script>
    <script src="~/js/tabulator-demo.js" asp-append-version="true"></script>
}
