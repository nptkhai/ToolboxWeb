@using System.Globalization
@using System.Text.Json
@using ToolboxWeb.Web.Constants
@using ToolboxWeb.Web.ViewModels.Jira
@model ToolboxWeb.Web.ViewModels.Jira.JiraDashboardPageViewModel
@{
    ViewData["Title"] = T["Jira.Dashboard.Title"];
    var currentCulture = CultureInfo.CurrentUICulture.Name;
    var dashboardHref = Url.RouteUrl(ToolboxRouteSlugs.RouteNames.JiraDashboardHtml) ?? "/jira-dashboard.html";
    var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var periodPicker = new JiraPeriodPickerViewModel
    {
        IdPrefix = "jira-dashboard-period",
        PeriodType = Model.Filter.PeriodType,
        DayValue = Model.Filter.DayValue,
        WeekValue = Model.Filter.WeekValue,
        MonthValue = Model.Filter.MonthValue,
        YearValue = Model.Filter.YearValue
    };
    var jqlBlock = new JiraJqlBlockViewModel
    {
        Id = "jira-dashboard-jql",
        Jql = Model.AppliedJql,
        BrowseBaseUrl = Model.Session.BaseUrl
    };
    var dashboardRowsJson = JsonSerializer.Serialize(Model.Rows, jsonOptions);
    var dashboardConfigJson = JsonSerializer.Serialize(new
    {
        currentCulture,
        dashboardApiUrl = Url.Action("Dashboard", "Jira"),
        loginUrl = Url.Page("/Account/Login", new { area = "Identity" }),
        browseBaseUrl = Model.Session.BaseUrl?.TrimEnd('/'),
        initialSort = Model.Filter.Sort,
        initialDirection = Model.Filter.Direction,
        emptyState = T["Jira.Dashboard.EmptyState"].Value,
        filterEmpty = T["Jira.Dashboard.FilterEmpty"].Value,
        searchErrorMessage = T["Jira.Dashboard.Error"].Value,
        columns = new
        {
            index = T["Jira.Table.Index"].Value,
            project = T["Jira.Table.Project"].Value,
            subTaskKey = T["Jira.Table.SubtaskKey"].Value,
            subTaskSummary = T["Jira.Table.SubtaskSummary"].Value,
            issueKey = T["Jira.Table.IssueKey"].Value,
            issueSummary = T["Jira.Table.IssueSummary"].Value,
            status = T["Jira.Table.Status"].Value,
            dueDate = T["Jira.Table.DueDate"].Value,
            estimate = T["Jira.Table.EstimateTime"].Value,
            logged = T["Jira.Table.LogTime"].Value
        }
    });
}

@section Styles {
    <link rel="stylesheet" href="~/vendor/kendo/icons/index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/vendor/kendo/theme/default-main.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/vendor/tabulator/css/tabulator.min.css" asp-append-version="true" />
}

<div class="jira-dashboard-shell">
    <form method="get" action="@dashboardHref" class="jira-toolbar" data-jira-dashboard-form>
        <div class="jira-toolbar-range">
            <span class="jira-toolbar-caption">@T["Jira.Dashboard.ToolbarLabel"]</span>
            <strong data-jira-range-label>@Model.Filter.RangeLabel</strong>
        </div>

        <partial name="_JiraPeriodPicker" model="periodPicker" />

        <input type="hidden" name="periodType" value="@Model.Filter.PeriodType" data-jira-period-type />
        <input type="hidden" name="periodValue" value="@Model.Filter.PeriodValue" data-jira-period-value />
        <input type="hidden" name="sort" value="@Model.Filter.Sort" data-jira-sort />
        <input type="hidden" name="dir" value="@Model.Filter.Direction" data-jira-direction />
    </form>

    <div data-jira-alert-host>
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger jira-dashboard-alert" role="alert">@Model.ErrorMessage</div>
        }
    </div>

    <section class="jira-dashboard-stats" aria-label="@T["Jira.Dashboard.Title"]" data-jira-stats>
        @foreach (var stat in Model.Stats)
        {
            <article class="jira-dashboard-stat-card jira-dashboard-stat-card--@stat.AccentClass">
                <span class="jira-dashboard-stat-label">@stat.Label</span>
                <strong class="jira-dashboard-stat-value">@stat.Value</strong>
                <span class="jira-dashboard-stat-hint">@stat.Hint</span>
            </article>
        }
    </section>

    <section class="jira-dashboard-table-card" data-jira-table-card>
        <div class="jira-dashboard-table-head">
            <div>
                <h2>@T["Jira.Dashboard.SubtasksTitle"]</h2>
                <p>@T["Jira.Dashboard.SubtasksHint"]</p>
            </div>
            <div class="jira-chips" role="group" aria-label="@T["Jira.Chips.Label"]" data-jira-chips>
                <button type="button" class="tbx-chip" data-chip="all" aria-pressed="true">@T["Jira.Chips.All"] <span class="jira-chip-count" data-chip-count></span></button>
                <button type="button" class="tbx-chip" data-chip="open" aria-pressed="false">@T["Jira.Chips.Open"] <span class="jira-chip-count" data-chip-count></span></button>
                <button type="button" class="tbx-chip" data-chip="overdue" aria-pressed="false">@T["Jira.Chips.Overdue"] <span class="jira-chip-count" data-chip-count></span></button>
                <button type="button" class="tbx-chip" data-chip="done" aria-pressed="false">@T["Jira.Chips.Done"] <span class="jira-chip-count" data-chip-count></span></button>
            </div>
        </div>

        <div id="jira-dashboard-grid" class="jira-grid-host" aria-busy="false" data-jira-grid></div>

        <partial name="_JiraJqlBlock" model="jqlBlock" />
    </section>
</div>

<script id="jira-dashboard-rows" type="application/json">@Html.Raw(dashboardRowsJson)</script>
<script id="jira-dashboard-config" type="application/json">@Html.Raw(dashboardConfigJson)</script>

@section Scripts {
    <partial name="_KendoScripts" />
    <script src="~/vendor/tabulator/js/tabulator.min.js" asp-append-version="true"></script>
    <script src="~/js/jira-common.js" asp-append-version="true"></script>
    <script src="~/js/jira-dashboard.js" asp-append-version="true"></script>
}
