@using System.Globalization
@using System.Text.Json
@using ToolboxWeb.Web.Constants
@using ToolboxWeb.Web.ViewModels.Jira
@model ToolboxWeb.Web.ViewModels.Jira.JiraDashboardPageViewModel
@*
    Jira Dashboard, stage 5.1 pilot (docs/UI_UX_REVIEW.md 4.2): period picker, four cards that
    answer "is my log complete / over the estimate", hours logged per day against 8 h, and the
    subtasks grouped by parent issue. Cards, chart and table are drawn by jira-dashboard.js from
    the same JSON the period picker reloads.
*@
@{
    ViewData["Title"] = T["Jira.Dashboard.Title"];
    var dashboardHref = Url.RouteUrl(ToolboxRouteSlugs.RouteNames.JiraDashboardHtml) ?? "/jira-dashboard.html";
    var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var periodPicker = new JiraPeriodPickerViewModel
    {
        IdPrefix = "jira-dashboard-period",
        PeriodType = Model.Filter.PeriodType,
        DayValue = Model.Filter.DayValue,
        WeekValue = Model.Filter.WeekValue,
        MonthValue = Model.Filter.MonthValue,
        YearValue = Model.Filter.YearValue
    };
    var jqlBlock = new JiraJqlBlockViewModel
    {
        Id = "jira-dashboard-jql",
        Jql = Model.AppliedJql,
        BrowseBaseUrl = Model.Session.BaseUrl
    };
    var dataJson = JsonSerializer.Serialize(new
    {
        Model.Filter,
        Model.Summary,
        Model.LogBarUnit,
        Model.LogBars,
        Model.Rows
    }, jsonOptions);
    var configJson = JsonSerializer.Serialize(new
    {
        dashboardApiUrl = Url.Action("Dashboard", "Jira"),
        loginUrl = Url.Page("/Account/Login", new { area = "Identity" }),
        browseBaseUrl = Model.Session.BaseUrl?.TrimEnd('/'),
        initialSort = Model.Filter.Sort,
        initialDirection = Model.Filter.Direction,
        text = new
        {
            emptyState = T["Jira.Dashboard.EmptyState"].Value,
            filterEmpty = T["Jira.Dashboard.FilterEmpty"].Value,
            searchError = T["Jira.Dashboard.Error"].Value,
            tableCount = T["Jira.Dashboard.TableCount"].Value,
            noParent = T["Jira.Dashboard.Group.NoParent"].Value,
            groupMeta = T["Jira.Dashboard.Group.Meta"].Value,
            daysLate = T["Jira.Dashboard.DaysLate"].Value,
            noEstimate = T["Jira.Dashboard.NoEstimate"].Value,
            cardLogVsEstimate = T["Jira.Dashboard.Card.LogVsEstimate"].Value,
            cardLogVsEstimateDetail = T["Jira.Dashboard.Card.LogVsEstimateDetail"].Value,
            cardOverEstimate = T["Jira.Dashboard.Card.OverEstimate"].Value,
            cardWithinEstimate = T["Jira.Dashboard.Card.WithinEstimate"].Value,
            cardNoEstimate = T["Jira.Dashboard.Card.NoEstimate"].Value,
            cardSupport = T["Jira.Dashboard.Card.Support"].Value,
            cardLogVsEstimateInfo = T["Jira.Dashboard.Card.LogVsEstimateInfo"].Value,
            cardLogVsEstimateHelp = T["Jira.Dashboard.Card.LogVsEstimateHelp"].Value,
            cardProgress = T["Jira.Dashboard.Card.Progress"].Value,
            cardProgressDetail = T["Jira.Dashboard.Card.ProgressDetail"].Value,
            cardProgressPrevious = T["Jira.Dashboard.Card.ProgressPrevious"].Value,
            cardLogged = T["Jira.Dashboard.Card.Logged"].Value,
            cardLoggedNeed = T["Jira.Dashboard.Card.LoggedNeed"].Value,
            cardLoggedShort = T["Jira.Dashboard.Card.LoggedShort"].Value,
            cardLoggedEnough = T["Jira.Dashboard.Card.LoggedEnough"].Value,
            cardNotStarted = T["Jira.Dashboard.Card.NotStarted"].Value,
            deltaUp = T["Jira.Dashboard.Card.DeltaUp"].Value,
            deltaDown = T["Jira.Dashboard.Card.DeltaDown"].Value,
            deltaSame = T["Jira.Dashboard.Card.DeltaSame"].Value,
            cardOverdue = T["Jira.Dashboard.Card.Overdue"].Value,
            cardUnestimated = T["Jira.Dashboard.Card.Unestimated"].Value,
            cardAllEstimated = T["Jira.Dashboard.Card.AllEstimated"].Value,
            chartTitleDay = T["Jira.Dashboard.Chart.TitleDay"].Value,
            chartTitleMonth = T["Jira.Dashboard.Chart.TitleMonth"].Value,
            chartTarget = T["Jira.Dashboard.Chart.Target"].Value,
            chartSummary = T["Jira.Dashboard.Chart.Summary"].Value,
            chartTooltip = T["Jira.Dashboard.Chart.Tooltip"].Value,
            chartTooltipNoTarget = T["Jira.Dashboard.Chart.TooltipNoTarget"].Value,
            chartEmpty = T["Jira.Dashboard.Chart.Empty"].Value
        },
        columns = new
        {
            subTaskKey = T["Jira.Table.SubtaskKey"].Value,
            subTaskSummary = T["Jira.Table.SubtaskSummary"].Value,
            status = T["Jira.Table.Status"].Value,
            dueDate = T["Jira.Table.DueDate"].Value,
            estimate = T["Jira.Table.EstimateTime"].Value,
            logged = T["Jira.Table.LogTime"].Value
        }
    });
}

@section Styles {
    <link rel="stylesheet" href="~/vendor/kendo/icons/index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/vendor/kendo/theme/default-main.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/vendor/tabulator/css/tabulator.min.css" asp-append-version="true" />
}

<div class="jira-dashboard-shell">
    <form method="get" action="@dashboardHref" class="jira-toolbar" data-jira-dashboard-form>
        <partial name="_JiraPeriodPicker" model="periodPicker" />
        @* The picker box already shows the dates; screen readers hear the range when it changes. *@
        <span class="visually-hidden" role="status" aria-live="polite" data-jira-range-label>@Model.Filter.RangeLabel</span>

        <input type="hidden" name="periodType" value="@Model.Filter.PeriodType" data-jira-period-type />
        <input type="hidden" name="periodValue" value="@Model.Filter.PeriodValue" data-jira-period-value />
        <input type="hidden" name="sort" value="@Model.Filter.Sort" data-jira-sort />
        <input type="hidden" name="dir" value="@Model.Filter.Direction" data-jira-direction />
    </form>

    <div data-jira-alert-host>
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger jira-dashboard-alert" role="alert">@Model.ErrorMessage</div>
        }
    </div>

    @* Placeholders until the script draws the cards (loading state). *@
    <section class="jira-kpis" aria-label="@T["Jira.Dashboard.CardsLabel"]" aria-busy="true" data-jira-kpis>
        @for (var i = 0; i < 4; i++)
        {
            <div class="jira-kpi"><span class="tbx-skeleton jira-kpi-skeleton"></span></div>
        }
    </section>

    <section class="tbx-panel jira-chart-panel" aria-labelledby="jira-chart-title">
        <header class="jira-panel-head">
            <h2 id="jira-chart-title" data-jira-chart-title>@T["Jira.Dashboard.Chart.TitleDay"]</h2>
            <p class="jira-panel-sub" data-jira-chart-summary></p>
        </header>
        <div class="jira-chart" data-jira-chart></div>
    </section>

    <section class="tbx-panel jira-table-panel" aria-labelledby="jira-table-title">
        <header class="jira-panel-head">
            <div>
                <h2 id="jira-table-title">@T["Jira.Dashboard.SubtasksTitle"]</h2>
                <p class="jira-panel-sub"><span data-jira-table-count></span> · @T["Jira.Dashboard.SubtasksHint"]</p>
            </div>
            <div class="jira-chips" role="group" aria-label="@T["Jira.Chips.Label"]" data-jira-chips>
                <button type="button" class="tbx-chip" data-chip="all" aria-pressed="true">@T["Jira.Chips.All"] <span class="jira-chip-count" data-chip-count></span></button>
                <button type="button" class="tbx-chip" data-chip="open" aria-pressed="false">@T["Jira.Chips.Open"] <span class="jira-chip-count" data-chip-count></span></button>
                <button type="button" class="tbx-chip" data-chip="overdue" aria-pressed="false">@T["Jira.Chips.Overdue"] <span class="jira-chip-count" data-chip-count></span></button>
                <button type="button" class="tbx-chip" data-chip="done" aria-pressed="false">@T["Jira.Chips.Done"] <span class="jira-chip-count" data-chip-count></span></button>
            </div>
        </header>

        <div id="jira-dashboard-grid" class="jira-grid-host" aria-busy="false" data-jira-grid></div>

        <partial name="_JiraJqlBlock" model="jqlBlock" />
    </section>
</div>

<script id="jira-dashboard-data" type="application/json">@Html.Raw(dataJson)</script>
<script id="jira-dashboard-config" type="application/json">@Html.Raw(configJson)</script>

@section Scripts {
    <partial name="_KendoScripts" />
    <script src="~/vendor/tabulator/js/tabulator.min.js" asp-append-version="true"></script>
    <script src="~/vendor/echarts/js/echarts.min.js" asp-append-version="true"></script>
    <script src="~/js/charts.js" asp-append-version="true"></script>
    <script src="~/js/jira-common.js" asp-append-version="true"></script>
    <script src="~/js/jira-dashboard.js" asp-append-version="true"></script>
}
