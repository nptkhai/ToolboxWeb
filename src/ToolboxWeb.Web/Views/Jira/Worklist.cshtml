@using System.Globalization
@using System.Text.Json
@using ToolboxWeb.Web.Constants
@using ToolboxWeb.Web.Services
@using ToolboxWeb.Web.ViewModels.Jira
@model ToolboxWeb.Web.ViewModels.Jira.JiraWorklistPageViewModel
@{
    ViewData["Title"] = T["Jira.Worklist.Title"];
    var currentCulture = CultureInfo.CurrentUICulture.Name;
    var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var worklistConfigJson = JsonSerializer.Serialize(new
    {
        currentCulture,
        taskBoardApiUrl = Url.Action("TaskBoard", "Jira"),
        autoScheduleApiUrl = Url.Action("AutoScheduleSearch", "Jira"),
        loginUrl = Url.Page("/Account/Login", new { area = "Identity" }),
        browseBaseUrl = Model.Session.BaseUrl?.TrimEnd('/'),
        dayCapacityHours = 8,
        unsaved = new
        {
            message = T["Jira.Unsaved.Message"].Value,
            leaveTitle = T["Jira.Unsaved.LeaveTitle"].Value,
            leaveMessage = T["Jira.Unsaved.LeaveMessage"].Value,
            leaveOk = T["Jira.Unsaved.LeaveOk"].Value
        },
        columns = new
        {
            index = T["Jira.Table.Index"].Value,
            project = T["Jira.Table.Project"].Value,
            subTaskKey = T["Jira.Table.SubtaskKey"].Value,
            subTaskSummary = T["Jira.Table.SubtaskSummary"].Value,
            issueKey = T["Jira.Table.IssueKey"].Value,
            issueSummary = T["Jira.Table.IssueSummary"].Value,
            status = T["Jira.Table.Status"].Value,
            dueDate = T["Jira.Table.DueDate"].Value,
            estimate = T["Jira.Table.EstimateTime"].Value,
            logged = T["Jira.Table.LogTime"].Value
        }
    }, jsonOptions);
    var boardConfigJson = JsonSerializer.Serialize(new
    {
        hint = T["Jira.TaskBoard.Hint"].Value,
        noTasks = T["Jira.TaskBoard.NoTasks"].Value,
        emptyState = T["Jira.TaskBoard.EmptyState"].Value,
        error = T["Jira.TaskBoard.Error"].Value,
        movedToast = T["Jira.TaskBoard.MovedToast"].Value,
        movedFrom = T["Jira.TaskBoard.MovedFrom"].Value,
        loadTitle = T["Jira.TaskBoard.LoadTitle"].Value,
        cardHours = T["Jira.TaskBoard.CardHours"].Value
    }, jsonOptions);
    var searchJqlBlock = new JiraJqlBlockViewModel
    {
        Id = "jira-search-jql",
        BrowseBaseUrl = Model.Session.BaseUrl
    };
    var searchConfigJson = JsonSerializer.Serialize(new
    {
        searchUrl = Url.Action("Search", "Jira"),
        loginUrl = Url.Page("/Account/Login", new { area = "Identity" }),
        browseBaseUrl = Model.Session.BaseUrl?.TrimEnd('/'),
        sheetUrl = Url.Content("~/vendor/sheetjs/js/xlsx.full.min.js"),
        defaults = new
        {
            mode = "filter",
            assignee = "currentUser()",
            from = Model.Search.FromDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
            to = Model.Search.ToDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
        },
        text = new
        {
            searching = T["Jira.Search.Searching"].Value,
            assigneeRequired = T["Jira.Search.AssigneeRequired"].Value,
            dateOrder = T["Jira.Search.DateOrder"].Value,
            failed = T["Jira.SearchFailed"].Value,
            retry = T["Jira.Search.Retry"].Value,
            empty = T["Jira.Search.Empty"].Value,
            filterEmpty = T["Jira.Dashboard.FilterEmpty"].Value,
            editFilters = T["Jira.Search.EditFilters"].Value,
            count = T["Jira.Search.Count"].Value,
            truncated = T["Jira.Search.Truncated"].Value,
            summaryJql = T["Jira.Search.SummaryJql"].Value,
            any = T["Jira.Search.Any"].Value,
            noParent = T["Jira.Dashboard.Group.NoParent"].Value,
            groupMeta = T["Jira.Search.GroupMeta"].Value,
            daysLate = T["Jira.Dashboard.DaysLate"].Value,
            noEstimate = T["Jira.Dashboard.NoEstimate"].Value,
            pageCounter = T["Jira.Search.PageCounter"].Value,
            pageFirst = T["Jira.Search.PageFirst"].Value,
            pagePrev = T["Jira.Search.PagePrev"].Value,
            pageNext = T["Jira.Search.PageNext"].Value,
            pageLast = T["Jira.Search.PageLast"].Value,
            exportFailed = T["Jira.Search.ExportFailed"].Value,
            exportSheet = T["Jira.Search.ExportSheet"].Value,
            labels = new
            {
                assignee = T["Jira.Worklist.Assignee"].Value,
                due = T["Jira.Table.DueDate"].Value,
                status = T["Jira.Worklist.Status"].Value,
                project = T["Jira.Worklist.Project"].Value,
                issueKey = T["Jira.Worklist.IssueKey"].Value,
                reporter = T["Jira.Worklist.Reporter"].Value
            }
        },
        columns = new
        {
            key = T["Jira.Table.Key"].Value,
            summary = T["Jira.Table.Summary"].Value,
            status = T["Jira.Table.Status"].Value,
            type = T["Jira.Table.Type"].Value,
            dueDate = T["Jira.Table.DueDate"].Value,
            estimate = T["Jira.Table.Estimate"].Value,
            logged = T["Jira.Table.LogTime"].Value,
            parent = T["Jira.Table.Parent"].Value,
            parentSummary = T["Jira.Table.IssueSummary"].Value
        }
    }, jsonOptions);
    var boardPeriodPicker = new JiraPeriodPickerViewModel
    {
        IdPrefix = "jira-board-period",
        Periods = ["week", "month"],
        PeriodType = "week"
    };
    var autoScheduleConfigJson = JsonSerializer.Serialize(new
    {
        error = T["Jira.AutoSchedule.Error"].Value,
        resultEmpty = T["Jira.AutoSchedule.ResultGridEmpty"].Value,
        dueEditedToast = T["Jira.AutoSchedule.DueEditedToast"].Value,
        savedToast = T["Jira.AutoSchedule.SavedToast"].Value,
        discardedToast = T["Jira.AutoSchedule.DiscardedToast"].Value,
        groupSummary = T["Jira.AutoSchedule.GroupSummary"].Value,
        noEligibleTasks = T["Jira.AutoSchedule.NoEligibleTasks"].Value,
        configSummary = T["Jira.AutoSchedule.ConfigSummary"].Value,
        configSummarySkipped = T["Jira.AutoSchedule.ConfigSummarySkipped"].Value,
        noDueWarning = T["Jira.AutoSchedule.NoDueWarning"].Value,
        startDateRequired = T["Jira.AutoSchedule.StartDateRequired"].Value,
        noProposalsToast = T["Jira.AutoSchedule.NoProposalsToast"].Value,
        proposalsToast = T["Jira.AutoSchedule.ProposalsToast"].Value,
        criteria = new
        {
            dueDate = T["Jira.AutoSchedule.CriteriaDueDate"].Value,
            status = T["Jira.AutoSchedule.CriteriaStatus"].Value,
            createDate = T["Jira.AutoSchedule.CriteriaCreateDate"].Value
        },
        directions = new
        {
            dueSoonestFirst = T["Jira.AutoSchedule.DirDueSoonestFirst"].Value,
            dueLatestFirst = T["Jira.AutoSchedule.DirDueLatestFirst"].Value,
            doingFirst = T["Jira.AutoSchedule.DirDoingFirst"].Value,
            todoFirst = T["Jira.AutoSchedule.DirTodoFirst"].Value,
            createOldestFirst = T["Jira.AutoSchedule.DirCreateOldestFirst"].Value,
            createNewestFirst = T["Jira.AutoSchedule.DirCreateNewestFirst"].Value
        }
    }, jsonOptions);
}

@section Styles {
    <link rel="stylesheet" href="~/vendor/kendo/icons/index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/vendor/kendo/theme/default-main.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/vendor/tabulator/css/tabulator.min.css" asp-append-version="true" />
}

<div class="jira-shell jira-dashboard-shell">
    <section class="jira-tabs-shell">
    @* Due-date changes on the board and auto-schedule tabs are not written to Jira yet. *@
    <div class="alert alert-warning jira-unsaved-bar d-none" role="status" data-jira-unsaved>
        <span data-jira-unsaved-text></span>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-jira-unsaved-discard>@T["Jira.Unsaved.Discard"]</button>
    </div>
    <ul class="nav nav-tabs jira-page-tabs" id="jira-worklist-tabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="jira-tab-search" data-bs-toggle="tab" data-bs-target="#jira-tab-search-pane" type="button" role="tab" aria-controls="jira-tab-search-pane" aria-selected="true">@T["Jira.Worklist.Tabs.Search"]</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="jira-tab-board" data-bs-toggle="tab" data-bs-target="#jira-tab-board-pane" type="button" role="tab" aria-controls="jira-tab-board-pane" aria-selected="false">@T["Jira.Worklist.Tabs.Board"]</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="jira-tab-auto" data-bs-toggle="tab" data-bs-target="#jira-tab-auto-pane" type="button" role="tab" aria-controls="jira-tab-auto-pane" aria-selected="false">@T["Jira.Worklist.Tabs.AutoSchedule"]</button>
        </li>
    </ul>

    <div class="tab-content jira-tab-content">
        <div class="tab-pane fade show active" id="jira-tab-search-pane" role="tabpanel" aria-labelledby="jira-tab-search">
            @* Stage 5.2: two exclusive modes (filters / JQL), searches without reloading the page, the
               form folds into a one-line summary, results in a grouped Tabulator. Content/js/jira-search.js *@
            <div class="jira-search" data-jira-search>
                <section class="tbx-panel jira-search-panel">
                    <div class="jira-search-summary" data-search-summary hidden>
                        <tbx-icon name="search" />
                        <p class="jira-search-summary-text" data-search-summary-text></p>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-search-edit>
                            <tbx-icon name="pencil" />
                            <span>@T["Jira.Search.EditFilters"]</span>
                        </button>
                    </div>

                    <form class="jira-search-form" data-search-form novalidate>
                        @Html.AntiForgeryToken()
                        <div class="jira-period-tabs jira-search-modes" role="group" aria-label="@T["Jira.Search.ModeLabel"]">
                            <button type="button" class="jira-period-tab is-active" data-search-mode-button="filter" aria-pressed="true">@T["Jira.Search.ModeFilter"]</button>
                            <button type="button" class="jira-period-tab" data-search-mode-button="jql" aria-pressed="false">@T["Jira.Search.ModeJql"]</button>
                        </div>

                        <div class="jira-search-grid" data-search-mode="filter">
                            <div class="tbx-field">
                                <label class="tbx-field-label" for="jira-search-assignee">@T["Jira.Worklist.Assignee"]<span class="tbx-required" aria-hidden="true">*</span></label>
                                <select id="jira-search-assignee" class="form-select" data-search-field="assignee">
                                    <option value="">@T["Jira.Worklist.AssigneeEmpty"]</option>
                                    <option value="currentUser()" selected>@T["Jira.Worklist.AssigneeCurrentUser"]</option>
                                    @foreach (var user in Model.Users)
                                    {
                                        <option value="@user.Name">@user.DisplayName</option>
                                    }
                                </select>
                            </div>
                            <div class="tbx-field">
                                <label class="tbx-field-label" for="jira-search-from">@T["Jira.Worklist.FromDate"]</label>
                                <input id="jira-search-from" class="form-control" autocomplete="off" data-search-field="from" data-search-date value="@Model.Search.FromDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" />
                            </div>
                            <div class="tbx-field">
                                <label class="tbx-field-label" for="jira-search-to">@T["Jira.Worklist.ToDate"]</label>
                                <input id="jira-search-to" class="form-control" autocomplete="off" data-search-field="to" data-search-date value="@Model.Search.ToDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" />
                            </div>
                            <div class="tbx-field">
                                <label class="tbx-field-label" for="jira-search-status">@T["Jira.Worklist.Status"]</label>
                                <select id="jira-search-status" class="form-select" data-search-field="status">
                                    <option value="">@T["Jira.Search.Any"]</option>
                                    <option>Open</option>
                                    <option>In Analysis</option>
                                    <option>To Do</option>
                                    <option>In Progress</option>
                                    <option>Done</option>
                                </select>
                            </div>
                            <div class="tbx-field">
                                <label class="tbx-field-label" for="jira-search-project">@T["Jira.Worklist.Project"]</label>
                                <input id="jira-search-project" class="form-control" autocomplete="off" data-search-field="project" placeholder="@T["Jira.Search.ProjectExample"]" />
                            </div>
                            <div class="tbx-field">
                                <label class="tbx-field-label" for="jira-search-key">@T["Jira.Worklist.IssueKey"]</label>
                                <input id="jira-search-key" class="form-control" autocomplete="off" data-search-field="issueKey" placeholder="@T["Jira.Search.IssueKeyExample"]" />
                            </div>
                            <div class="tbx-field">
                                <label class="tbx-field-label" for="jira-search-reporter">@T["Jira.Worklist.Reporter"]</label>
                                <select id="jira-search-reporter" class="form-select" data-search-field="reporter">
                                    <option value="">@T["Jira.Search.Any"]</option>
                                    @foreach (var user in Model.Users)
                                    {
                                        <option value="@user.Name">@user.DisplayName</option>
                                    }
                                </select>
                            </div>
                            <div class="jira-search-actions">
                                <button type="submit" class="btn btn-primary"><tbx-icon name="search" /><span>@T["Jira.Worklist.SearchButton"]</span></button>
                                <button type="button" class="btn btn-outline-secondary" data-search-reset>@T["Jira.Worklist.ResetButton"]</button>
                            </div>
                        </div>

                        <div class="jira-search-jql" data-search-mode="jql" hidden>
                            <div class="tbx-field">
                                <label class="tbx-field-label" for="jira-search-saved">@T["Jira.Worklist.FiltersLabel"]</label>
                                <select id="jira-search-saved" class="form-select" data-search-saved>
                                    <option value="">@T["Jira.Search.SavedNone"]</option>
                                    @foreach (var filter in Model.Filters)
                                    {
                                        <option value="@filter.Id" data-jql="@filter.Jql">@filter.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="tbx-field jira-search-jql-field">
                                <label class="tbx-field-label" for="jira-search-jql-text">@T["Jira.Worklist.AdvancedJql"]</label>
                                <textarea id="jira-search-jql-text" class="form-control jira-jql-input" rows="5" spellcheck="false" data-search-field="jql" aria-describedby="jira-search-jql-hint"></textarea>
                                <span class="tbx-field-hint" id="jira-search-jql-hint">@T["Jira.Search.JqlHint"]</span>
                            </div>
                            <div class="jira-search-actions">
                                <button type="submit" class="btn btn-primary"><tbx-icon name="search" /><span>@T["Jira.Worklist.SearchButton"]</span></button>
                                <button type="button" class="btn btn-outline-secondary" data-search-format>@T["Jira.Search.FormatJql"]</button>
                            </div>
                        </div>

                        <p class="jira-search-error" role="alert" data-search-error></p>
                    </form>
                </section>

                <section class="tbx-panel jira-table-panel jira-search-results" aria-labelledby="jira-search-results-title" data-search-results>
                    <header class="jira-panel-head">
                        <div>
                            <h2 id="jira-search-results-title">@T["Jira.Worklist.ResultsTitle"]</h2>
                            <p class="jira-panel-sub" data-search-count></p>
                        </div>
                        <div class="jira-search-tools">
                            <div class="jira-chips" role="group" aria-label="@T["Jira.Search.ChipsLabel"]" data-search-chips>
                                <button type="button" class="tbx-chip" data-chip="all" aria-pressed="true">@T["Jira.Chips.All"] <span class="jira-chip-count" data-chip-count></span></button>
                                <button type="button" class="tbx-chip" data-chip="open" aria-pressed="false">@T["Jira.Chips.Open"] <span class="jira-chip-count" data-chip-count></span></button>
                                <button type="button" class="tbx-chip" data-chip="overdue" aria-pressed="false">@T["Jira.Chips.Overdue"] <span class="jira-chip-count" data-chip-count></span></button>
                                <button type="button" class="tbx-chip" data-chip="done" aria-pressed="false">@T["Jira.Chips.Done"] <span class="jira-chip-count" data-chip-count></span></button>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-secondary jira-search-export" data-search-export disabled>
                                <tbx-icon name="download" />
                                <span>@T["Jira.Search.Export"]</span>
                            </button>
                        </div>
                    </header>

                    <p class="jira-search-note" data-search-truncated hidden></p>
                    <div data-search-state></div>
                    <div class="jira-grid-host" aria-busy="false" data-search-grid></div>

                    <partial name="_JiraJqlBlock" model="searchJqlBlock" />
                </section>
            </div>
        </div>

        <div class="tab-pane fade" id="jira-tab-board-pane" role="tabpanel" aria-labelledby="jira-tab-board">
            <div class="jira-toolbar" data-jira-board-toolbar>
                <div class="jira-toolbar-range">
                    <span class="jira-toolbar-caption">@T["Jira.Dashboard.ToolbarLabel"]</span>
                    <strong data-jira-board-range-label></strong>
                </div>

                <partial name="_JiraPeriodPicker" model="boardPeriodPicker" />
            </div>

            <div data-jira-board-alert></div>

            <section class="jira-dashboard-table-card">
                <div class="jira-dashboard-table-head">
                    <div>
                        <h2>@T["Jira.Worklist.Tabs.Board"]</h2>
                        <p>@T["Jira.TaskBoard.Hint"]</p>
                    </div>
                </div>
                <div id="jira-board-root" class="jira-board-root"></div>
            </section>
        </div>

        <div class="tab-pane fade" id="jira-tab-auto-pane" role="tabpanel" aria-labelledby="jira-tab-auto">
            <section class="panel jira-panel">
                <div class="jira-auto-filter-card" data-jira-auto-filter>
                    <div class="jira-auto-filter-row">
                        <div class="jira-auto-filter-group">
                            <label class="form-label">@T["Jira.AutoSchedule.Project"]</label>
                            <select class="form-select" id="jira-auto-project">
                                <option value="">@T["Jira.AutoSchedule.ProjectAll"]</option>
                            </select>
                        </div>
                        <div class="jira-auto-filter-group">
                            <label class="form-label">@T["Jira.AutoSchedule.Status"]</label>
                            <select class="form-select" id="jira-auto-status">
                                <option value="all">@T["Jira.AutoSchedule.StatusAll"]</option>
                                <option value="todo">@T["Jira.AutoSchedule.StatusTodo"]</option>
                                <option value="doing">@T["Jira.AutoSchedule.StatusDoing"]</option>
                            </select>
                        </div>
                        <div class="jira-auto-filter-group jira-auto-filter-grow">
                            <label class="form-label">@T["Jira.AutoSchedule.Text"]</label>
                            <input type="text" class="form-control" id="jira-auto-text" />
                        </div>
                        <div class="jira-auto-filter-group">
                            <label class="form-label">@T["Jira.AutoSchedule.DueFrom"]</label>
                            <input type="date" class="form-control" id="jira-auto-due-from" />
                        </div>
                        <div class="jira-auto-filter-group">
                            <label class="form-label">@T["Jira.AutoSchedule.DueTo"]</label>
                            <input type="date" class="form-control" id="jira-auto-due-to" />
                        </div>
                        <button type="button" class="btn btn-primary" data-jira-auto-search>@T["Jira.AutoSchedule.SearchButton"]</button>
                        <button type="button" class="btn btn-outline-secondary" data-jira-auto-sort disabled>@T["Jira.AutoSchedule.SortButton"]</button>
                    </div>
                </div>

                <div data-jira-auto-alert></div>

                <div class="jira-auto-grids">
                    <div class="jira-auto-grid-col">
                        <div class="jira-auto-grid-head">
                            <h3>@T["Jira.AutoSchedule.SearchGridTitle"]</h3>
                            <span class="jira-auto-grid-count" data-jira-auto-count></span>
                        </div>
                        <div id="jira-auto-search-grid" class="jira-auto-grid-host"></div>
                    </div>
                    <div class="jira-auto-grid-col">
                        <div class="jira-auto-grid-head">
                            <h3>@T["Jira.AutoSchedule.ResultGridTitle"]</h3>
                            <div class="jira-auto-grid-actions">
                                <span class="jira-auto-grid-hint" data-jira-auto-result-hint></span>
                                <button type="button" class="btn btn-outline-secondary" data-jira-auto-discard disabled>@T["Jira.AutoSchedule.DiscardProposal"]</button>
                                <button type="button" class="btn btn-primary" data-jira-auto-save disabled>@T["Jira.AutoSchedule.SaveProposal"]</button>
                            </div>
                        </div>
                        <div id="jira-auto-result-grid" class="jira-auto-grid-host"></div>
                    </div>
                </div>
            </section>

            <div class="modal fade" id="jira-auto-config-modal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">@T["Jira.AutoSchedule.ConfigTitle"]</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Action.Close"]"></button>
                        </div>
                        <div class="modal-body">
                            <p class="jira-auto-config-summary" data-jira-auto-config-summary></p>
                            <div class="alert alert-warning d-none" data-jira-auto-config-warning></div>

                            <div class="jira-auto-config-section">
                                <div class="jira-auto-config-title">@T["Jira.AutoSchedule.ConfigSectionManual"]</div>
                                <p class="jira-auto-config-hint">@T["Jira.AutoSchedule.ConfigSectionManualHint"]</p>
                                <div class="jira-auto-manual-list" data-jira-auto-manual-list></div>
                            </div>

                            <div class="jira-auto-config-section">
                                <div class="jira-auto-config-title">@T["Jira.AutoSchedule.ConfigSectionCriteria"]</div>
                                <p class="jira-auto-config-hint">@T["Jira.AutoSchedule.ConfigSectionCriteriaHint"]</p>
                                <div data-jira-auto-criteria-list></div>
                            </div>

                            <div class="jira-auto-config-section">
                                <div class="jira-auto-config-title">@T["Jira.AutoSchedule.ConfigSectionCapacity"]</div>
                                <div class="jira-auto-cap-mode-row">
                                    <label class="form-check"><input type="radio" class="form-check-input" name="jira-auto-cap-mode" id="jira-auto-cap-hours" checked /> <span class="form-check-label">@T["Jira.AutoSchedule.ConfigCapacityByHours"]</span></label>
                                    <label class="form-check"><input type="radio" class="form-check-input" name="jira-auto-cap-mode" id="jira-auto-cap-percent" /> <span class="form-check-label">@T["Jira.AutoSchedule.ConfigCapacityByPercent"]</span></label>
                                </div>
                                <div class="jira-auto-cap-row" data-jira-auto-cap-hours-row>
                                    <input type="number" class="form-control jira-auto-cap-input" id="jira-auto-cap-hours-value" min="1" step="0.5" value="8" />
                                </div>
                                <div class="jira-auto-cap-row d-none" data-jira-auto-cap-percent-row>
                                    <input type="number" class="form-control jira-auto-cap-input" id="jira-auto-cap-percent-value" min="1" max="100" step="5" value="100" />
                                    <span class="jira-auto-cap-preview">(&asymp; <span data-jira-auto-cap-percent-preview>8</span>h)</span>
                                </div>
                            </div>

                            <div class="jira-auto-config-section">
                                <div class="jira-auto-config-title">@T["Jira.AutoSchedule.ConfigSectionOther"]</div>
                                <div class="jira-auto-config-row">
                                    <div class="jira-auto-filter-group">
                                        <label class="form-label">@T["Jira.AutoSchedule.ConfigStartDate"]</label>
                                        <input type="date" class="form-control" id="jira-auto-cfg-start-date" required />
                                    </div>
                                    <label class="form-check jira-auto-config-checkbox"><input type="checkbox" class="form-check-input" id="jira-auto-cfg-skip-weekend" checked /> <span class="form-check-label">@T["Jira.AutoSchedule.ConfigSkipWeekend"]</span></label>
                                </div>
                                <div class="jira-auto-config-row">
                                    <label class="form-check"><input type="radio" class="form-check-input" name="jira-auto-cfg-scope" id="jira-auto-scope-all" checked /> <span class="form-check-label">@T["Jira.AutoSchedule.ConfigScopeAll"]</span></label>
                                    <label class="form-check"><input type="radio" class="form-check-input" name="jira-auto-cfg-scope" id="jira-auto-scope-unplanned" /> <span class="form-check-label">@T["Jira.AutoSchedule.ConfigScopeUnplanned"]</span></label>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@T["Jira.AutoSchedule.ConfigCancel"]</button>
                            <button type="button" class="btn btn-primary" data-jira-auto-config-run>@T["Jira.AutoSchedule.ConfigRun"]</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    </section>
</div>

<script id="jira-search-config" type="application/json">@Html.Raw(searchConfigJson)</script>
<script id="jira-worklist-config" type="application/json">@Html.Raw(worklistConfigJson)</script>
<script id="jira-task-board-config" type="application/json">@Html.Raw(boardConfigJson)</script>
<script id="jira-auto-schedule-config" type="application/json">@Html.Raw(autoScheduleConfigJson)</script>

@section Scripts {
    <partial name="_KendoScripts" />
    <script src="~/vendor/tabulator/js/tabulator.min.js" asp-append-version="true"></script>
    <script src="~/js/jira-common.js" asp-append-version="true"></script>
    <script src="~/js/jira-search.js" asp-append-version="true"></script>
    <script src="~/js/jira-task-board.js" asp-append-version="true"></script>
    <script src="~/js/jira-auto-schedule.js" asp-append-version="true"></script>
    <script src="~/js/jira-worklist-tabs.js" asp-append-version="true"></script>
}
