@section Scripts {
    <partial name="_KendoScripts" />
    <script src="~/vendor/tabulator/js/tabulator.min.js" asp-append-version="true"></script>
    <script src="~/js/component-hub.js" asp-append-version="true"></script>
    <script>
        (function ($) {
            const text = @Html.Raw(JsonSerializer.Serialize(componentText));
            const categoryOptions = @Html.Raw(JsonSerializer.Serialize(tabulatorCategoryOptions));
            const statusOptions = @Html.Raw(JsonSerializer.Serialize(tabulatorStatusOptions));
            const priorityOptions = @Html.Raw(JsonSerializer.Serialize(tabulatorPriorityOptions));
            const kendoPriorityOptions = @Html.Raw(JsonSerializer.Serialize(kendoPriorityOptions));
            const kendoListBoxItems = @Html.Raw(JsonSerializer.Serialize(kendoListBoxItems));
            const kendoListViewItems = @Html.Raw(JsonSerializer.Serialize(kendoListViewItems));
            const antiForgeryToken = document.querySelector("#component-grid-pane input[name='__RequestVerificationToken']")?.value || "";
            let componentNotification = null;
            let componentTabulatorApi = null;

            function bindTabRoutes(containerSelector) {
                document.querySelectorAll(containerSelector + " [data-route-url]").forEach(function (trigger) {
                    trigger.addEventListener("shown.bs.tab", function (event) {
                        const routeUrl = event.target.getAttribute("data-route-url");
                        if (!routeUrl || !window.history || typeof window.history.replaceState !== "function") {
                            return;
                        }

                        const nextUrl = new URL(routeUrl, window.location.origin);
                        const currentUrl = new URL(window.location.href);
                        if (nextUrl.pathname === currentUrl.pathname && nextUrl.search === currentUrl.search) {
                            return;
                        }

                        window.history.replaceState(window.history.state, "", nextUrl.pathname + nextUrl.search + nextUrl.hash);
                    });
                });
            }

            function showComponentTab(tabButtonId) {
                const trigger = document.getElementById(tabButtonId);
                if (!trigger) {
                    return;
                }

                if (window.bootstrap && window.bootstrap.Tab) {
                    window.bootstrap.Tab.getOrCreateInstance(trigger).show();
                    return;
                }

                trigger.click();
            }

            function showComponentMessage(message, type) {
                if (componentNotification) {
                    componentNotification.show(message, type || "info");
                    return;
                }

                const fallback = document.getElementById("component-tabulator-feedback");
                if (!fallback) {
                    return;
                }

                fallback.textContent = message;
                fallback.classList.remove("success", "error");

                if (type === "success" || type === "error") {
                    fallback.classList.add(type);
                }
            }

            // Cards show their catalog status (ViewModels/ComponentCatalog.cs). The page only
            // overrides it when a widget fails to start, which means the Kendo bundle stopped loading.
            function setCardStatus(cardId, kind, note) {
                if (kind !== "missing") {
                    return;
                }

                const card = document.getElementById(cardId);
                const badge = card?.querySelector("[data-status-badge]");
                const noteEl = card?.querySelector("[data-status-note]");
                if (badge) {
                    badge.className = "tbx-pill is-danger";
                    badge.textContent = text.LoadFailed;
                }

                if (noteEl) {
                    noteEl.textContent = note ? note + " " + text.LoadFailedNote : text.LoadFailedNote;
                    noteEl.classList.remove("d-none");
                }
            }

            function hasPlugin(pluginName) {
                return !!($ && $.fn && typeof $.fn[pluginName] === "function");
            }

            function initWidget(selector, pluginName, options, cardId) {
                const element = $(selector);
                if (!element.length) {
                    return null;
                }

                if (!hasPlugin(pluginName)) {
                    if (cardId) {
                        setCardStatus(cardId, "missing", pluginName + ":");
                    }
                    return null;
                }

                element[pluginName](options || {});
                if (cardId) {
                    setCardStatus(cardId, "usable");
                }

                return element.data(pluginName);
            }

            function initKendoDemos() {
                if (!window.kendo) {
                    [
                        "card-kendo-textbox",
                        "card-kendo-autocomplete",
                        "card-kendo-combobox",
                        "card-kendo-dropdownlist",
                        "card-kendo-multiselect",
                        "card-kendo-listbox",
                        "card-kendo-datepicker",
                        "card-kendo-datetimepicker",
                        "card-kendo-timepicker",
                        "card-kendo-numeric",
                        "card-kendo-slider",
                        "card-kendo-masked",
                        "card-kendo-listview",
                        "card-kendo-validator",
                        "card-kendo-window",
                        "card-kendo-notification",
                        "card-kendo-tooltip",
                        "card-kendo-menu",
                        "card-kendo-panelbar",
                        "card-kendo-splitter"
                    ].forEach(function (cardId) {
                        setCardStatus(cardId, "missing");
                    });
                    return;
                }

                if (text.CultureName === "vi-VN") {
                    kendo.culture("vi-VN");
                }

                const popupOptions = {
                    appendTo: $(document.body),
                    collision: "fit flip"
                };

                const keywordData = ["UI", "API", "SQL", "Localization", "Kendo Core", "Tabulator", "Bootstrap", "Popup", "Culture"];
                const provinceData = [
                    { text: "Hà Nội", value: "HN" },
                    { text: "TP. Hồ Chí Minh", value: "HCM" },
                    { text: "Đà Nẵng", value: "DN" },
                    { text: "Hải Phòng", value: "HP" },
                    { text: "Cần Thơ", value: "CT" }
                ];
                const moduleData = [
                    { text: "UI", value: "ui" },
                    { text: "Localization", value: "localization" },
                    { text: "Culture", value: "culture" },
                    { text: "Testing", value: "testing" },
                    { text: "Operations", value: "operations" }
                ];

                initWidget("#kendo-textbox-demo", "kendoTextBox", { placeholder: "REQ-2048" }, "card-kendo-textbox");
                initWidget("#kendo-autocomplete-demo", "kendoAutoComplete", {
                    dataSource: keywordData,
                    filter: "contains",
                    minLength: 1,
                    suggest: true,
                    popup: popupOptions
                }, "card-kendo-autocomplete");
                initWidget("#kendo-combobox-demo", "kendoComboBox", {
                    dataTextField: "text",
                    dataValueField: "value",
                    dataSource: provinceData,
                    placeholder: "Choose or type...",
                    filter: "contains",
                    suggest: true,
                    popup: popupOptions
                }, "card-kendo-combobox");
                initWidget("#kendo-dropdownlist-demo", "kendoDropDownList", {
                    dataTextField: "text",
                    dataValueField: "value",
                    dataSource: kendoPriorityOptions,
                    popup: popupOptions
                }, "card-kendo-dropdownlist");
                initWidget("#kendo-multiselect-demo", "kendoMultiSelect", {
                    dataTextField: "text",
                    dataValueField: "value",
                    dataSource: moduleData,
                    value: ["ui", "localization"],
                    autoClose: false,
                    filter: "contains",
                    popup: popupOptions
                }, "card-kendo-multiselect");
                initWidget("#kendo-listbox-demo", "kendoListBox", {
                    dataTextField: "text",
                    dataValueField: "value",
                    dataSource: kendoListBoxItems,
                    selectable: "multiple"
                }, "card-kendo-listbox");
                initWidget("#kendo-datepicker-demo", "kendoDatePicker", {
                    value: new Date(2026, 5, 22),
                    format: "dd/MM/yyyy",
                    popup: popupOptions
                }, "card-kendo-datepicker");
                initWidget("#kendo-datetimepicker-demo", "kendoDateTimePicker", {
                    value: new Date(2026, 5, 22, 9, 30),
                    format: "dd/MM/yyyy HH:mm",
                    timeFormat: "HH:mm",
                    popup: popupOptions
                }, "card-kendo-datetimepicker");
                initWidget("#kendo-timepicker-demo", "kendoTimePicker", {
                    value: new Date(2026, 5, 22, 14, 15),
                    format: "HH:mm",
                    interval: 15,
                    popup: popupOptions
                }, "card-kendo-timepicker");
                initWidget("#kendo-numeric-demo", "kendoNumericTextBox", {
                    format: "c0",
                    value: 5000000,
                    min: 0,
                    step: 100000
                }, "card-kendo-numeric");
                initWidget("#kendo-slider-demo", "kendoSlider", {
                    min: 0,
                    max: 100,
                    smallStep: 5,
                    largeStep: 20,
                    value: 65,
                    showButtons: true
                }, "card-kendo-slider");
                initWidget("#kendo-masked-demo", "kendoMaskedTextBox", {
                    mask: "0000 000 000",
                    value: "0900000000"
                }, "card-kendo-masked");

                if (hasPlugin("kendoListView") && hasPlugin("kendoPager")) {
                    const listViewDataSource = new kendo.data.DataSource({
                        data: kendoListViewItems,
                        pageSize: 3,
                        schema: {
                            model: {
                                id: "id",
                                fields: {
                                    dueDate: { type: "date" },
                                    progress: { type: "number" }
                                }
                            }
                        }
                    });

                    $("#component-listview").kendoListView({
                        dataSource: listViewDataSource,
                        template: kendo.template($("#component-listview-template").html())
                    });

                    $("#component-pager").kendoPager({
                        dataSource: listViewDataSource,
                        buttonCount: 5,
                        pageSizes: [3, 6],
                        refresh: true,
                        messages: {
                            empty: text.ListViewEmpty
                        }
                    });

                    setCardStatus("card-kendo-listview", "usable");
                    listViewDataSource.read();
                } else {
                    setCardStatus("card-kendo-listview", "missing", "kendoListView / kendoPager:");
                }

                initWidget("#component-validator-email", "kendoTextBox", {
                    placeholder: "team@toolbox.local"
                }, null);

                const validator = initWidget("#component-validator-form", "kendoValidator", null, "card-kendo-validator");
                const demoWindow = initWidget("#component-window", "kendoWindow", {
                    width: "460px",
                    title: text.WindowTitle,
                    visible: false,
                    modal: true,
                    actions: ["Pin", "Minimize", "Maximize", "Close"]
                }, "card-kendo-window");

                componentNotification = initWidget("#component-notification", "kendoNotification", {
                    position: { pinned: true, top: 88, right: 28 },
                    stacking: "down",
                    autoHideAfter: 2600
                }, "card-kendo-notification");

                initWidget("#component-tooltip-target", "kendoTooltip", {
                    content: text.TooltipContent,
                    position: "bottom",
                    width: 300
                }, "card-kendo-tooltip");

                initWidget("#component-menu", "kendoMenu", {
                    animation: { open: { effects: "fadeIn" } },
                    popupCollision: "fit flip"
                }, "card-kendo-menu");
                initWidget("#component-panelbar", "kendoPanelBar", {
                    expandMode: "multiple"
                }, "card-kendo-panelbar");
                initWidget("#component-splitter", "kendoSplitter", {
                    panes: [
                        { size: "40%", collapsible: true },
                        { collapsible: true }
                    ]
                }, "card-kendo-splitter");

                document.getElementById("component-validator-submit")?.addEventListener("click", function () {
                    const valid = validator ? validator.validate() : false;
                    if (componentNotification) {
                        componentNotification.show(valid ? text.ValidatorSuccess : text.ValidatorError, valid ? "success" : "error");
                    }
                });

                document.getElementById("component-window-open")?.addEventListener("click", function () {
                    demoWindow?.center().open();
                });

                document.getElementById("component-notification-open")?.addEventListener("click", function () {
                    componentNotification?.show(text.NotificationInfo, "info");
                });
            }

            function initTabulatorDemo() {
                if (!window.Tabulator) {
                    const feedbackEl = document.getElementById("component-tabulator-feedback");
                    if (feedbackEl) {
                        feedbackEl.textContent = "Tabulator assets are not available.";
                        feedbackEl.classList.add("error");
                    }
                    return;
                }

                const loginUrl = text.Tabulator.LoginPath + "?ReturnUrl=" + encodeURIComponent(text.Tabulator.ReturnUrl);
                const feedbackEl = document.getElementById("component-tabulator-feedback");
                const dirtyChipEl = document.getElementById("component-tabulator-dirty");
                const rowCountEl = document.getElementById("component-tabulator-count");
                const pending = {
                    created: new Map(),
                    updated: new Map(),
                    deletedIds: new Set()
                };

                const categoryLookup = toLookup(categoryOptions);
                const statusLookup = toLookup(statusOptions);
                const priorityLookup = toLookup(priorityOptions);
                const updatedAtFormatter = new Intl.DateTimeFormat(text.CultureName, {
                    day: "2-digit",
                    month: "2-digit",
                    year: "numeric",
                    hour: "2-digit",
                    minute: "2-digit",
                    hour12: false
                });
                let table = null;
                // Tabulator builds the table asynchronously; setData before that fails inside
                // Tabulator ("verticalFillMode" of null) when the data request returns first.
                let tableBuilt = Promise.resolve();
                let tempRowCounter = 0;

                function setFeedback(message, type) {
                    feedbackEl.textContent = message;
                    feedbackEl.classList.remove("success", "error");
                    if (type) {
                        feedbackEl.classList.add(type);
                    }
                }

                function updateRowCount() {
                    rowCountEl.textContent = table ? String(table.getDataCount("active")) : "0";
                }

                function hasPendingChanges() {
                    return pending.created.size > 0 || pending.updated.size > 0 || pending.deletedIds.size > 0;
                }

                function updateDirtyState() {
                    const dirty = hasPendingChanges();
                    dirtyChipEl.textContent = dirty ? text.Tabulator.DirtyState : text.Tabulator.CleanState;
                    dirtyChipEl.classList.toggle("dirty", dirty);
                    updateRowCount();
                }

                function toSnapshot(data) {
                    return {
                        id: data.id,
                        title: (data.title || "").trim(),
                        category: data.category || "Ui",
                        status: data.status || "Todo",
                        priority: data.priority || "Medium",
                        progress: normalizeNumber(data.progress, 0),
                        budget: normalizeNumber(data.budget, 0),
                        dueDate: data.dueDate || null,
                        note: (data.note || "").trim()
                    };
                }

                function clearPending() {
                    pending.created.clear();
                    pending.updated.clear();
                    pending.deletedIds.clear();
                    updateDirtyState();
                }

                function normalizeNumber(value, fallbackValue) {
                    const parsed = Number(value);
                    return Number.isFinite(parsed) ? parsed : fallbackValue;
                }

                function formatUpdatedAt(date) {
                    return updatedAtFormatter.format(date).replace(",", "");
                }

                function syncDerived(row) {
                    row.categoryLabel = categoryLookup[row.category] || row.category;
                    row.statusLabel = statusLookup[row.status] || row.status;
                    row.priorityLabel = priorityLookup[row.priority] || row.priority;
                    return row;
                }

                function markRowDirty(rowData) {
                    const snapshot = toSnapshot(syncDerived(rowData));
                    if (snapshot.id == null) {
                        pending.created.set(rowData.rowKey, snapshot);
                    } else {
                        pending.updated.set(rowData.rowKey, snapshot);
                    }
                    updateDirtyState();
                }

                function createEmptyRow() {
                    tempRowCounter += 1;
                    return {
                        id: null,
                        rowKey: "tmp-" + tempRowCounter,
                        title: "",
                        category: "Ui",
                        categoryLabel: categoryLookup.Ui,
                        status: "Todo",
                        statusLabel: statusLookup.Todo,
                        priority: "Medium",
                        priorityLabel: priorityLookup.Medium,
                        progress: 0,
                        budget: 0,
                        dueDate: "",
                        note: "",
                        updatedAt: ""
                    };
                }

                function appendCreatedRow(rowData) {
                    return table.addRow(rowData, true).then(function (row) {
                        pending.created.set(rowData.rowKey, toSnapshot(rowData));
                        updateDirtyState();
                        setFeedback(text.Tabulator.PendingChangesNotice);
                        updateRowCount();
                        return row;
                    });
                }

                function flushActiveEditor() {
                    if (document.activeElement && typeof document.activeElement.blur === "function") {
                        document.activeElement.blur();
                    }
                }

                function waitForUiCommit() {
                    return new Promise(function (resolve) {
                        window.setTimeout(resolve, 0);
                    });
                }

                function collectEditedRows() {
                    if (!table || typeof table.getEditedCells !== "function") {
                        return;
                    }

                    const touchedRows = new Set();
                    table.getEditedCells().forEach(function (cell) {
                        const rowData = cell.getRow().getData();
                        if (!rowData || touchedRows.has(rowData.rowKey)) {
                            return;
                        }

                        touchedRows.add(rowData.rowKey);
                        const snapshot = toSnapshot(syncDerived(rowData));
                        if (snapshot.id == null) {
                            pending.created.set(rowData.rowKey, snapshot);
                        } else if (!pending.deletedIds.has(snapshot.id)) {
                            pending.updated.set(rowData.rowKey, snapshot);
                        }
                    });
                }

                function refreshPendingSnapshots() {
                    pending.created.forEach(function (_, rowKey) {
                        const row = table.getRow(rowKey);
                        if (row) {
                            pending.created.set(rowKey, toSnapshot(syncDerived(row.getData())));
                        }
                    });

                    pending.updated.forEach(function (_, rowKey) {
                        const row = table.getRow(rowKey);
                        if (row) {
                            pending.updated.set(rowKey, toSnapshot(syncDerived(row.getData())));
                        }
                    });
                }

                async function requestJson(url, options) {
                    const response = await fetch(url, options);

                    if (response.status === 401 || response.status === 403) {
                        window.location.href = loginUrl;
                        return null;
                    }

                    const contentType = response.headers.get("content-type") || "";
                    const payload = contentType.includes("application/json")
                        ? await response.json()
                        : await response.text();

                    if (!response.ok) {
                        const message = typeof payload === "string"
                            ? payload
                            : (payload.message || text.Tabulator.GenericError);
                        const errors = typeof payload === "object" && payload.errors
                            ? payload.errors.join(" ")
                            : "";
                        throw new Error((message + " " + errors).trim());
                    }

                    return payload;
                }

                async function loadGridData(showMessage) {
                    const payload = await requestJson(text.Tabulator.DataUrl, {
                        credentials: "same-origin",
                        headers: {
                            "X-Requested-With": "XMLHttpRequest"
                        }
                    });

                    if (!payload) {
                        return;
                    }

                    await tableBuilt;
                    table.setData(payload);
                    clearPending();
                    if (showMessage) {
                        setFeedback(text.Tabulator.Reloaded, "success");
                    }
                }

                table = new Tabulator("#component-tabulator-grid", {
                    index: "rowKey",
                    layout: "fitColumns",
                    height: "430px",
                    selectableRows: true,
                    placeholder: text.Tabulator.EmptyState,
                    columnDefaults: {
                        headerHozAlign: "center",
                        headerSort: true,
                        vertAlign: "middle"
                    },
                    columns: [
                        {
                            formatter: "rowSelection",
                            titleFormatter: "rowSelection",
                            hozAlign: "center",
                            headerSort: false,
                            width: 52
                        },
                        {
                            title: text.Tabulator.Columns.Title,
                            field: "title",
                            editor: "input",
                            hozAlign: "left",
                            minWidth: 220
                        },
                        {
                            title: text.Tabulator.Columns.Category,
                            field: "category",
                            editor: "list",
                            editorParams: { values: categoryLookup },
                            formatter: function (cell) { return categoryLookup[cell.getValue()] || ""; },
                            hozAlign: "left",
                            minWidth: 150
                        },
                        {
                            title: text.Tabulator.Columns.Status,
                            field: "status",
                            editor: "list",
                            editorParams: { values: statusLookup },
                            formatter: function (cell) { return statusLookup[cell.getValue()] || ""; },
                            hozAlign: "center",
                            minWidth: 140
                        },
                        {
                            title: text.Tabulator.Columns.Priority,
                            field: "priority",
                            editor: "list",
                            editorParams: { values: priorityLookup },
                            formatter: function (cell) { return priorityLookup[cell.getValue()] || ""; },
                            hozAlign: "center",
                            minWidth: 140
                        },
                        {
                            title: text.Tabulator.Columns.Progress,
                            field: "progress",
                            editor: "number",
                            sorter: "number",
                            hozAlign: "center",
                            minWidth: 120
                        },
                        {
                            title: text.Tabulator.Columns.Budget,
                            field: "budget",
                            editor: "number",
                            sorter: "number",
                            hozAlign: "right",
                            formatter: function (cell) {
                                return new Intl.NumberFormat(text.CultureName).format(normalizeNumber(cell.getValue(), 0));
                            },
                            minWidth: 140
                        },
                        {
                            title: text.Tabulator.Columns.DueDate,
                            field: "dueDate",
                            editor: "date",
                            hozAlign: "center",
                            minWidth: 135
                        },
                        {
                            title: text.Tabulator.Columns.Note,
                            field: "note",
                            editor: "textarea",
                            hozAlign: "left",
                            minWidth: 220
                        },
                        {
                            title: text.Tabulator.Columns.UpdatedAt,
                            field: "updatedAt",
                            headerSort: false,
                            hozAlign: "center",
                            minWidth: 140
                        }
                    ],
                    cellEdited: function (cell) {
                        const rowData = cell.getRow().getData();
                        syncDerived(rowData);
                        markRowDirty(rowData);
                        setFeedback(text.Tabulator.PendingChangesNotice);
                        updateRowCount();
                    },
                    dataLoaded: function () {
                        updateRowCount();
                    }
                });
                tableBuilt = new Promise(function (resolve) { table.on("tableBuilt", resolve); });

                async function addRowFromPopup(formData) {
                    if (!table) {
                        throw new Error(text.PopupGridUnavailable);
                    }

                    const newRow = createEmptyRow();
                    newRow.title = (formData.title || "").trim();
                    newRow.category = formData.category || "Ui";
                    newRow.status = formData.status || "Todo";
                    newRow.priority = formData.priority || "Medium";
                    newRow.progress = Math.min(100, Math.max(0, normalizeNumber(formData.progress, 0)));
                    newRow.budget = Math.max(0, normalizeNumber(formData.budget, 0));
                    newRow.dueDate = formData.dueDate || "";
                    newRow.note = (formData.note || "").trim();
                    newRow.updatedAt = formatUpdatedAt(new Date());
                    syncDerived(newRow);

                    await appendCreatedRow(newRow);

                    const row = table.getRow(newRow.rowKey);
                    if (row && typeof row.scrollTo === "function") {
                        try {
                            await row.scrollTo("center", false);
                        } catch {
                            // Ignore scroll issues from hidden tabs; the new row still exists in the data set.
                        }
                    }

                    return newRow;
                }

                componentTabulatorApi = {
                    addRowFromPopup: addRowFromPopup,
                    focusGrid: function () {
                        showComponentTab("component-grid-tab");
                    }
                };

                document.getElementById("component-tabulator-add")?.addEventListener("click", function () {
                    const newRow = createEmptyRow();
                    appendCreatedRow(newRow).catch(function (error) {
                        setFeedback(error.message || text.Tabulator.GenericError, "error");
                    });
                });

                document.getElementById("component-tabulator-delete")?.addEventListener("click", function () {
                    const selected = table.getSelectedRows();
                    if (!selected.length) {
                        setFeedback(text.Tabulator.NoSelection, "error");
                        return;
                    }

                    selected.forEach(function (row) {
                        const data = row.getData();
                        if (data.id == null) {
                            pending.created.delete(data.rowKey);
                        } else {
                            pending.updated.delete(data.rowKey);
                            pending.deletedIds.add(data.id);
                        }
                        row.delete();
                    });

                    updateDirtyState();
                    setFeedback(text.Tabulator.PendingChangesNotice);
                });

                document.getElementById("component-tabulator-reload")?.addEventListener("click", async function () {
                    try {
                        await loadGridData(true);
                    } catch (error) {
                        setFeedback(error.message || text.Tabulator.GenericError, "error");
                    }
                });

                document.getElementById("component-tabulator-save")?.addEventListener("click", async function () {
                    try {
                        flushActiveEditor();
                        await waitForUiCommit();
                        collectEditedRows();
                        refreshPendingSnapshots();
                        updateDirtyState();

                        if (!hasPendingChanges()) {
                            setFeedback(text.Tabulator.NoChanges);
                            return;
                        }

                        setFeedback(text.Tabulator.Saving);

                        const payload = {
                            created: Array.from(pending.created.values()),
                            updated: Array.from(pending.updated.values()).filter(function (item) { return item.id != null; }),
                            deletedIds: Array.from(pending.deletedIds.values())
                        };

                        const response = await requestJson(text.Tabulator.SaveUrl, {
                            method: "POST",
                            credentials: "same-origin",
                            headers: {
                                "Content-Type": "application/json",
                                "RequestVerificationToken": antiForgeryToken,
                                "X-Requested-With": "XMLHttpRequest"
                            },
                            body: JSON.stringify(payload)
                        });

                        if (!response) {
                            return;
                        }

                        table.setData(response.items || []);
                        clearPending();
                        setFeedback(response.message || text.Tabulator.SaveSuccess, "success");
                    } catch (error) {
                        setFeedback(error.message || text.Tabulator.GenericError, "error");
                    }
                });

                loadGridData(false).catch(function (error) {
                    setFeedback(error.message || text.Tabulator.GenericError, "error");
                });
            }

            function initFeedbackPopupDemo() {
                const modalEl = document.getElementById("component-create-task-modal");
                const formEl = document.getElementById("component-create-task-form");
                const saveBtn = document.getElementById("component-popup-save");
                const openBtn = document.getElementById("component-popup-create-open");
                const openGridBtn = document.getElementById("component-popup-grid-open");
                const titleInput = document.getElementById("component-popup-title");

                if (!modalEl || !formEl || !saveBtn || !openBtn) {
                    return;
                }

                const modal = window.bootstrap && window.bootstrap.Modal
                    ? new window.bootstrap.Modal(modalEl)
                    : null;

                function resetPopupForm() {
                    formEl.reset();
                    formEl.classList.remove("was-validated");
                }

                openBtn.addEventListener("click", function () {
                    resetPopupForm();
                    modal?.show();
                    window.setTimeout(function () {
                        titleInput?.focus();
                    }, 180);
                });

                openGridBtn?.addEventListener("click", function () {
                    showComponentTab("component-grid-tab");
                });

                modalEl.addEventListener("hidden.bs.modal", resetPopupForm);

                saveBtn.addEventListener("click", async function () {
                    formEl.classList.add("was-validated");

                    if (!formEl.checkValidity()) {
                        showComponentMessage(text.PopupValidationError, "error");
                        return;
                    }

                    if (!componentTabulatorApi || typeof componentTabulatorApi.addRowFromPopup !== "function") {
                        showComponentMessage(text.PopupGridUnavailable, "error");
                        return;
                    }

                    saveBtn.setAttribute("disabled", "disabled");

                    try {
                        await componentTabulatorApi.addRowFromPopup({
                            title: document.getElementById("component-popup-title")?.value || "",
                            category: document.getElementById("component-popup-category")?.value || "Ui",
                            status: document.getElementById("component-popup-status")?.value || "Todo",
                            priority: document.getElementById("component-popup-priority")?.value || "Medium",
                            progress: document.getElementById("component-popup-progress")?.value || "0",
                            budget: document.getElementById("component-popup-budget")?.value || "0",
                            dueDate: document.getElementById("component-popup-due-date")?.value || "",
                            note: document.getElementById("component-popup-note")?.value || ""
                        });

                        modal?.hide();
                        showComponentTab("component-grid-tab");
                        showComponentMessage(text.PopupCreateSuccess, "success");
                    } catch (error) {
                        showComponentMessage(error.message || text.PopupCreateError, "error");
                    } finally {
                        saveBtn.removeAttribute("disabled");
                    }
                });
            }

            function toLookup(options) {
                return options.reduce(function (acc, item) {
                    acc[item.value] = item.label;
                    return acc;
                }, {});
            }

            bindTabRoutes("#component-tabs");
            initKendoDemos();
            initTabulatorDemo();
            initFeedbackPopupDemo();
        })(jQuery);
    </script>
}

