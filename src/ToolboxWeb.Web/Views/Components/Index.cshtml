    var missingBundleCatalog = new[]
    {
        new { Name = "Grid", Library = "Kendo UI", Status = T["Components.StatusMissingBundle"].Value, Note = LocalText("Không có trong Kendo UI Core bundle hiện tại, nên grid editable của hub dùng Tabulator.", "Not present in the current Kendo UI Core bundle, so the editable grid demo uses Tabulator instead.") },
