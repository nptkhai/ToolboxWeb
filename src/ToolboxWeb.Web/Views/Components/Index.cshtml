    var assetOnlyCatalog = new[]
    {
        new { Name = "ECharts", Library = "Asset package", Status = T["Components.StatusAssetOnly"].Value, Note = LocalText("Đã có file JS trong source, phù hợp cho dashboard chart, KPI và visual analytics.", "JS assets are already in source; ideal for dashboard charts, KPI cards, and visual analytics.") },
        new { Name = "FullCalendar", Library = "Asset package", Status = T["Components.StatusAssetOnly"].Value, Note = LocalText("Phù hợp cho lịch công việc, booking hoặc timeline cần tương tác kéo thả.", "A good fit for task calendars, booking screens, or drag-and-drop timeline views.") },
