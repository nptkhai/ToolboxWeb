@using System.Globalization
@using System.Text.Json
@using ToolboxWeb.Web.Constants
@{
    ViewData["Title"] = T["Components.Title"];

    var currentCulture = CultureInfo.CurrentUICulture.Name;
    var activeTab = ViewData["ActiveTab"] as string ?? ToolboxRouteSlugs.ComponentsTabs.Default;

    string LocalText(string vi, string en) => currentCulture == "vi-VN" ? vi : en;
    bool IsActiveTab(string tab) => string.Equals(activeTab, tab, StringComparison.OrdinalIgnoreCase);
    string TabButtonClass(string tab) => IsActiveTab(tab) ? "nav-link active" : "nav-link";
    string TabPaneClass(string tab) => IsActiveTab(tab) ? "tab-pane fade show active" : "tab-pane fade";
    string TabRoute(string tab) => Url.RouteUrl(ToolboxRouteSlugs.RouteNames.ComponentsTabHtml, new { tab }) ?? $"/component/{tab}.html";

    var tabulatorCategoryOptions = new[]
    {
        new { value = "Ui", label = T["TabulatorTaskCategory.Ui"].Value },
        new { value = "Localization", label = T["TabulatorTaskCategory.Localization"].Value },
        new { value = "Culture", label = T["TabulatorTaskCategory.Culture"].Value },
        new { value = "Testing", label = T["TabulatorTaskCategory.Testing"].Value },
        new { value = "Operations", label = T["TabulatorTaskCategory.Operations"].Value }
    };

