                            <div>
                                <h4>Kendo Splitter</h4>
                                <div class="component-meta-line">@T["Components.LibraryLabel"]: Kendo UI Core</div>
                            </div>
                            <tbx-component-status key="kendo-splitter" />
                        </div>
                        <p class="component-note">@LocalText("Phù hợp cho màn hình cấu hình có pane trái là navigation và pane phải là nội dung chi tiết.", "Great for configuration screens with navigation on the left and details on the right.")</p>
                        <div class="component-sample">
                            <div id="component-splitter">
                                <div class="split-pane">
                                    <strong>@LocalText("Left pane", "Left pane")</strong>
                                    <div class="helper">@LocalText("Menu dự án, bộ lọc hoặc danh sách section.", "Project menu, filters, or a section list.")</div>
                                </div>
                                <div class="split-pane">
                                    <strong>@LocalText("Right pane", "Right pane")</strong>
                                    <div class="helper">@LocalText("Chi tiết form, preview hoặc hướng dẫn thao tác.", "Form details, previews, or usage guidance.")</div>
