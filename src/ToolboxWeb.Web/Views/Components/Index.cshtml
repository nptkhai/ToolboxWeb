@using System.Globalization
@using System.Text.Json
@using ToolboxWeb.Web.Constants
@{
    ViewData["Title"] = T["Components.Title"];

    var currentCulture = CultureInfo.CurrentUICulture.Name;
    var activeTab = ViewData["ActiveTab"] as string ?? ToolboxRouteSlugs.ComponentsTabs.Default;

    string LocalText(string vi, string en) => currentCulture == "vi-VN" ? vi : en;
    bool IsActiveTab(string tab) => string.Equals(activeTab, tab, StringComparison.OrdinalIgnoreCase);
    string TabButtonClass(string tab) => IsActiveTab(tab) ? "nav-link active" : "nav-link";
    string TabPaneClass(string tab) => IsActiveTab(tab) ? "tab-pane fade show active" : "tab-pane fade";
    string TabRoute(string tab) => Url.RouteUrl(ToolboxRouteSlugs.RouteNames.ComponentsTabHtml, new { tab }) ?? $"/component/{tab}.html";

    var tabulatorCategoryOptions = new[]
    {
        new { value = "Ui", label = T["TabulatorTaskCategory.Ui"].Value },
        new { value = "Localization", label = T["TabulatorTaskCategory.Localization"].Value },
        new { value = "Culture", label = T["TabulatorTaskCategory.Culture"].Value },
        new { value = "Testing", label = T["TabulatorTaskCategory.Testing"].Value },
        new { value = "Operations", label = T["TabulatorTaskCategory.Operations"].Value }
    };

    var tabulatorStatusOptions = new[]
    {
        new { value = "Todo", label = T["TabulatorTaskStatus.Todo"].Value },
        new { value = "InProgress", label = T["TabulatorTaskStatus.InProgress"].Value },
        new { value = "Review", label = T["TabulatorTaskStatus.Review"].Value },
        new { value = "Done", label = T["TabulatorTaskStatus.Done"].Value }
    };

    var tabulatorPriorityOptions = new[]
    {
        new { value = "Low", label = T["TabulatorTaskPriority.Low"].Value },
        new { value = "Medium", label = T["TabulatorTaskPriority.Medium"].Value },
        new { value = "High", label = T["TabulatorTaskPriority.High"].Value }
    };

    var kendoPriorityOptions = new[]
    {
        new { text = T["TabulatorTaskPriority.High"].Value, value = "high" },
        new { text = T["TabulatorTaskPriority.Medium"].Value, value = "medium" },
        new { text = T["TabulatorTaskPriority.Low"].Value, value = "low" }
    };

    var kendoListBoxItems = new[]
    {
        new { text = LocalText("Chuẩn hóa form", "Normalize forms"), value = "forms" },
        new { text = LocalText("Rà popup", "Review popups"), value = "popups" },
        new { text = LocalText("Test responsive", "Test responsive"), value = "responsive" },
        new { text = LocalText("Chuẩn hóa locale", "Normalize locale"), value = "locale" }
    };

    var kendoListViewItems = new[]
    {
        new { id = 1, title = LocalText("Chuẩn hóa demo component", "Normalize component demos"), owner = "Khai", dueDate = new DateTime(2026, 6, 22), status = T["TabulatorTaskStatus.InProgress"].Value, statusCode = "doing", priority = T["TabulatorTaskPriority.High"].Value, priorityCode = "high", progress = 72 },
        new { id = 2, title = LocalText("Bổ sung localization", "Add localization"), owner = "ToolboxWeb", dueDate = new DateTime(2026, 6, 23), status = T["TabulatorTaskStatus.Review"].Value, statusCode = "review", priority = T["TabulatorTaskPriority.Medium"].Value, priorityCode = "medium", progress = 84 },
        new { id = 3, title = LocalText("Giữ menu demo cũ", "Keep legacy demo menus"), owner = "Codex", dueDate = new DateTime(2026, 6, 24), status = T["TabulatorTaskStatus.Done"].Value, statusCode = "done", priority = T["TabulatorTaskPriority.Medium"].Value, priorityCode = "medium", progress = 100 },
        new { id = 4, title = LocalText("Catalog asset ngoài bundle", "Catalog asset-only libraries"), owner = "Khai", dueDate = new DateTime(2026, 6, 25), status = T["TabulatorTaskStatus.Todo"].Value, statusCode = "todo", priority = T["TabulatorTaskPriority.Low"].Value, priorityCode = "low", progress = 22 }
    };

    var demoImageUploadControl = new ImageUploadControlViewModel
    {
        InputName = "ComponentDemoAvatar",
        RemovedInputName = "ComponentDemoAvatarRemoved",
        TriggerText = LocalText("Chọn ảnh đại diện", "Choose cover image"),
        RemoveText = LocalText("Xóa", "Delete"),
        EmptyTitle = LocalText("Chọn ảnh đại diện", "Choose cover image"),
        EmptyNote = LocalText("Kéo thả ảnh vào đây hoặc bấm để cập nhật.", "Drop an image here or click to update it."),
        HelperText = LocalText("Control này chỉ giữ ảnh ở giao diện và trong input file. Chỉ khi submit form thật thì backend mới lưu ảnh vào source và ghi URL xuống cơ sở dữ liệu.", "This control only keeps the image in the UI and file input. The backend should save the file and persist its URL only when the real form is submitted."),
        InvalidTypeMessage = LocalText("Chỉ được đính kèm ảnh JPG, JPEG, PNG, GIF hoặc WEBP.", "Only JPG, JPEG, PNG, GIF, or WEBP images are allowed."),
        AriaLabel = LocalText("Chọn hoặc kéo thả ảnh đại diện", "Choose or drag a cover image"),
        RootCssClass = "tbx-upload-image-fixed"
    };

    var demoFileAttachmentControl = new FileAttachmentControlViewModel
    {
        InputName = "ComponentDemoAttachments",
        RemovedInputName = "ComponentDemoAttachmentsRemoved",
        TriggerText = LocalText("Đính kèm tệp tin", "Attach files"),
        HeaderText = LocalText("Tệp đính kèm đã chọn:", "Selected attachments:"),
        ClearAllText = LocalText("Xóa hết", "Clear all"),
        RemoveText = LocalText("Xóa", "Delete"),
        EmptyText = LocalText("Chưa có file đính kèm nào.", "No attachment files yet."),
        HelperText = LocalText("Danh sách file chỉ tồn tại trong giao diện và input file cho đến lúc submit. Không có file nào được lưu xuống source ngay khi bạn vừa chọn.", "The selected files stay only in the UI and file input until form submit. Nothing is written into the source as soon as a user picks files."),
        InvalidTypeMessage = LocalText("Chỉ nhận các file thông dụng như PDF, Word, Excel, PowerPoint, TXT, CSV hoặc ảnh JPG, JPEG, PNG, GIF, WEBP.", "Only common files such as PDF, Word, Excel, PowerPoint, TXT, CSV, or JPG, JPEG, PNG, GIF, WEBP images are allowed."),
        AriaLabel = LocalText("Chọn hoặc kéo thả file đính kèm", "Choose or drag attachment files")
    };

    var componentText = new
    {
        CultureName = currentCulture,
        LoadFailed = T["Components.Status.LoadFailed"].Value,
        LoadFailedNote = T["Components.Status.LoadFailedNote"].Value,
        ListViewEmpty = LocalText("Chưa có dữ liệu mini demo.", "No mini demo data yet."),
        ValidatorSuccess = LocalText("Form hợp lệ, có thể tiếp tục lưu.", "The form is valid and ready to save."),
        ValidatorError = LocalText("Form chưa hợp lệ, vui lòng kiểm tra lại email và tiêu đề.", "The form is not valid yet. Please review the email and title fields."),
        ValidatorSummary = LocalText("Mẹo: demo này dùng Kendo Validator nhưng vẫn phối hợp được với input native hoặc Kendo TextBox.", "Tip: this demo uses Kendo Validator and still works alongside native inputs or Kendo TextBox."),
        NotificationInfo = LocalText("Notification đang hoạt động bình thường trong bundle hiện tại.", "Notification is working correctly in the current bundle."),
        PopupCreateSuccess = T["Components.Popup.Success"].Value,
        PopupCreateError = T["Components.Popup.Error"].Value,
        PopupValidationError = T["Components.Popup.ValidationError"].Value,
        PopupGridUnavailable = T["Components.Popup.GridUnavailable"].Value,
        TooltipContent = LocalText("Tooltip này dùng bundle self-host hiện tại và có thể gắn trên target bất kỳ trong page.", "This tooltip uses the current self-host bundle and can attach to arbitrary targets on the page."),
        WindowTitle = LocalText("Kendo Window", "Kendo Window"),
        WindowBody = LocalText("Window phù hợp cho popup làm việc ngắn, xem chi tiết hoặc chỉnh sửa nhẹ mà chưa cần Dialog thương mại.", "Window works well for quick popups, detail previews, or lightweight editing without needing the commercial Dialog widget."),
        ListViewNote = LocalText("Phần này minh họa cách dùng DataSource + ListView + Pager thay cho Grid thương mại.", "This shows how DataSource + ListView + Pager can cover lightweight data listing instead of the commercial Grid."),
        TabulatorInfo = LocalText("Grid ở hub này dùng lại endpoint Data/Save hiện có của TabulatorDemoController để bạn test đúng luồng editable hiện tại.", "This grid reuses the existing TabulatorDemoController Data/Save endpoints so you can test the real editable flow already in the app."),
        Tabulator = new
        {
            LoginPath = Url.Page("/Account/Login", new { area = "Identity" }),
            ReturnUrl = Url.Action("Index", "Components"),
            DataUrl = Url.Action("Data", "TabulatorDemo"),
            SaveUrl = Url.Action("Save", "TabulatorDemo"),
            DirtyState = T["TabulatorDemo.DirtyState"].Value,
            CleanState = T["TabulatorDemo.CleanState"].Value,
            Ready = T["TabulatorDemo.Ready"].Value,
            PendingChangesNotice = T["TabulatorDemo.PendingChangesNotice"].Value,
            Reloaded = T["TabulatorDemo.Reloaded"].Value,
            NoSelection = T["TabulatorDemo.NoSelection"].Value,
            NoChanges = T["TabulatorDemo.NoChanges"].Value,
            Saving = T["TabulatorDemo.Saving"].Value,
            SaveSuccess = T["TabulatorDemo.SaveSuccess"].Value,
            GenericError = T["TabulatorDemo.GenericError"].Value,
            EmptyState = T["TabulatorDemo.EmptyState"].Value,
            AddRow = T["TabulatorDemo.AddRow"].Value,
            DeleteSelected = T["TabulatorDemo.DeleteSelected"].Value,
            SaveChanges = T["TabulatorDemo.SaveChanges"].Value,
            Reload = T["TabulatorDemo.Reload"].Value,
            Columns = new
            {
                Title = T["TabulatorDemo.Columns.Title"].Value,
                Category = T["TabulatorDemo.Columns.Category"].Value,
                Status = T["TabulatorDemo.Columns.Status"].Value,
                Priority = T["TabulatorDemo.Columns.Priority"].Value,
                Progress = T["TabulatorDemo.Columns.Progress"].Value,
                Budget = T["TabulatorDemo.Columns.Budget"].Value,
                DueDate = T["TabulatorDemo.Columns.DueDate"].Value,
                Note = T["TabulatorDemo.Columns.Note"].Value,
                UpdatedAt = T["TabulatorDemo.Columns.UpdatedAt"].Value
            }
        }
    };
}

@section Styles {
    <link rel="stylesheet" href="~/vendor/kendo/icons/index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/vendor/kendo/theme/default-main.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/vendor/tabulator/css/tabulator.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/component-hub.css" asp-append-version="true" />
}

<div class="component-hub">
    <section class="tbx-panel component-intro">
        <p>@T["Components.Description"]</p>
        <div class="component-intro-links">
            <a class="btn btn-sm btn-outline-secondary" asp-controller="DemoKendo" asp-action="Index">@T["Components.GoToKendoDemo"]</a>
            <a class="btn btn-sm btn-outline-secondary" asp-controller="TabulatorDemo" asp-action="Index">@T["Components.GoToTabulatorDemo"]</a>
        </div>
    </section>

    <section class="component-tabs-shell">
        <ul class="nav nav-tabs component-tab-nav" id="component-tabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="@TabButtonClass(ToolboxRouteSlugs.ComponentsTabs.Foundations)" id="component-foundations-tab" data-bs-toggle="tab" data-bs-target="#component-foundations-pane" data-route-url="@TabRoute(ToolboxRouteSlugs.ComponentsTabs.Foundations)" type="button" role="tab" aria-controls="component-foundations-pane" aria-selected="@(IsActiveTab(ToolboxRouteSlugs.ComponentsTabs.Foundations).ToString().ToLowerInvariant())">@T["Components.Sections.Foundations"]</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="@TabButtonClass(ToolboxRouteSlugs.ComponentsTabs.TextInput)" id="component-text-tab" data-bs-toggle="tab" data-bs-target="#component-text-pane" data-route-url="@TabRoute(ToolboxRouteSlugs.ComponentsTabs.TextInput)" type="button" role="tab" aria-controls="component-text-pane" aria-selected="@(IsActiveTab(ToolboxRouteSlugs.ComponentsTabs.TextInput).ToString().ToLowerInvariant())">@T["Components.Sections.TextInput"]</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="@TabButtonClass(ToolboxRouteSlugs.ComponentsTabs.Selection)" id="component-selection-tab" data-bs-toggle="tab" data-bs-target="#component-selection-pane" data-route-url="@TabRoute(ToolboxRouteSlugs.ComponentsTabs.Selection)" type="button" role="tab" aria-controls="component-selection-pane" aria-selected="@(IsActiveTab(ToolboxRouteSlugs.ComponentsTabs.Selection).ToString().ToLowerInvariant())">@T["Components.Sections.Selection"]</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="@TabButtonClass(ToolboxRouteSlugs.ComponentsTabs.DateTimeNumeric)" id="component-datetime-tab" data-bs-toggle="tab" data-bs-target="#component-datetime-pane" data-route-url="@TabRoute(ToolboxRouteSlugs.ComponentsTabs.DateTimeNumeric)" type="button" role="tab" aria-controls="component-datetime-pane" aria-selected="@(IsActiveTab(ToolboxRouteSlugs.ComponentsTabs.DateTimeNumeric).ToString().ToLowerInvariant())">@T["Components.Sections.DateTimeNumeric"]</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="@TabButtonClass(ToolboxRouteSlugs.ComponentsTabs.GridData)" id="component-grid-tab" data-bs-toggle="tab" data-bs-target="#component-grid-pane" data-route-url="@TabRoute(ToolboxRouteSlugs.ComponentsTabs.GridData)" type="button" role="tab" aria-controls="component-grid-pane" aria-selected="@(IsActiveTab(ToolboxRouteSlugs.ComponentsTabs.GridData).ToString().ToLowerInvariant())">@T["Components.Sections.GridData"]</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="@TabButtonClass(ToolboxRouteSlugs.ComponentsTabs.FeedbackPopup)" id="component-feedback-tab" data-bs-toggle="tab" data-bs-target="#component-feedback-pane" data-route-url="@TabRoute(ToolboxRouteSlugs.ComponentsTabs.FeedbackPopup)" type="button" role="tab" aria-controls="component-feedback-pane" aria-selected="@(IsActiveTab(ToolboxRouteSlugs.ComponentsTabs.FeedbackPopup).ToString().ToLowerInvariant())">@T["Components.Sections.FeedbackPopup"]</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="@TabButtonClass(ToolboxRouteSlugs.ComponentsTabs.NavigationLayout)" id="component-layout-tab" data-bs-toggle="tab" data-bs-target="#component-layout-pane" data-route-url="@TabRoute(ToolboxRouteSlugs.ComponentsTabs.NavigationLayout)" type="button" role="tab" aria-controls="component-layout-pane" aria-selected="@(IsActiveTab(ToolboxRouteSlugs.ComponentsTabs.NavigationLayout).ToString().ToLowerInvariant())">@T["Components.Sections.NavigationLayout"]</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="@TabButtonClass(ToolboxRouteSlugs.ComponentsTabs.Catalog)" id="component-catalog-tab" data-bs-toggle="tab" data-bs-target="#component-catalog-pane" data-route-url="@TabRoute(ToolboxRouteSlugs.ComponentsTabs.Catalog)" type="button" role="tab" aria-controls="component-catalog-pane" aria-selected="@(IsActiveTab(ToolboxRouteSlugs.ComponentsTabs.Catalog).ToString().ToLowerInvariant())">@T["Components.Sections.Catalog"]</button>
            </li>
        </ul>

        <div class="tab-content component-tab-content">
            <div class="@TabPaneClass(ToolboxRouteSlugs.ComponentsTabs.Foundations)" id="component-foundations-pane" role="tabpanel" aria-labelledby="component-foundations-tab" tabindex="0">
                <partial name="_Foundations" />
            </div>

            <div class="@TabPaneClass(ToolboxRouteSlugs.ComponentsTabs.TextInput)" id="component-text-pane" role="tabpanel" aria-labelledby="component-text-tab" tabindex="0">
                <div class="component-family-head">
                    <h3>@T["Components.Sections.TextInput"]</h3>
                    <p>@T["Components.TextInputIntro"]</p>
                </div>

                <div class="component-card-grid">
                    <article class="component-card">
                        <div class="component-card-head">
                            <div>
                                <h4>@LocalText("Common Image Attachment Control", "Common Image Attachment Control")</h4>
                                <div class="component-meta-line">@T["Components.LibraryLabel"]: Bootstrap + HTML + shared JS</div>
                            </div>
                            <tbx-component-status key="image-upload" />
                        </div>
                        <p class="component-note">@LocalText("Control chung để chọn, cập nhật, kéo thả, hiển thị và xóa một hình ảnh với khung preview cố định.", "A shared control for choosing, updating, drag-dropping, previewing, and removing a single image inside a fixed preview frame.")</p>
                        <div class="component-sample">
                            <partial name="/Views/Shared/Controls/_ImageUploadControl.cshtml" model="demoImageUploadControl" />
                        </div>
                    </article>

                    <article class="component-card component-card-wide">
                        <div class="component-card-head">
                            <div>
                                <h4>@LocalText("Common Attachment File Control", "Common Attachment File Control")</h4>
                                <div class="component-meta-line">@T["Components.LibraryLabel"]: Bootstrap + HTML + shared JS</div>
                            </div>
                            <tbx-component-status key="file-attachment" />
                        </div>
                        <p class="component-note">@LocalText("Control chung để đính kèm, hiển thị, thêm file mới, kéo thả nhiều file và xóa từng dòng file với chiều cao gọn hơn.", "A shared control for attaching, listing, adding, drag-dropping multiple files, and removing each file row with a more compact height.")</p>
                        <div class="component-sample">
                            <partial name="/Views/Shared/Controls/_FileAttachmentControl.cshtml" model="demoFileAttachmentControl" />
                        </div>
                    </article>

                    <article class="component-card">
                        <div class="component-card-head">
                            <div>
                                <h4>Native Bootstrap Text Input</h4>
                                <div class="component-meta-line">@T["Components.LibraryLabel"]: Bootstrap + HTML</div>
                            </div>
                            <tbx-component-status key="native-text" />
                        </div>
                        <p class="component-note">@LocalText("Dùng cho các ô nhập văn bản ngắn, tìm kiếm hoặc form nội bộ cần nhẹ và ổn định.", "Use this for short text fields, search boxes, or lightweight internal forms.")</p>
                        <div class="component-sample">
                            <label class="form-label" for="native-textbox-demo">Project code</label>
                            <input id="native-textbox-demo" class="form-control" type="text" placeholder="TBX-2026-UI" />
                            <div class="helper">@LocalText("Form-control Bootstrap hiện tại đã đủ đồng bộ với layout chung của app.", "The current Bootstrap form-control already blends well with the app layout.")</div>
                        </div>
                    </article>

                    <article class="component-card">
                        <div class="component-card-head">
                            <div>
                                <h4>Native Textarea</h4>
                                <div class="component-meta-line">@T["Components.LibraryLabel"]: Bootstrap + HTML</div>
                            </div>
                            <tbx-component-status key="native-textarea" />
                        </div>
                        <p class="component-note">@LocalText("Phù hợp cho ghi chú, mô tả ngắn hoặc comment chưa cần rich text.", "A good fit for notes, short descriptions, or comments that do not need rich text.")</p>
                        <div class="component-sample">
                            <label class="form-label" for="native-textarea-demo">Internal note</label>
                            <textarea id="native-textarea-demo" class="form-control" rows="4" placeholder="Mô tả ngắn, acceptance note, handoff..."></textarea>
                        </div>
                    </article>

                    <article class="component-card" id="card-kendo-textbox">
                        <div class="component-card-head">
                            <div>
                                <h4>Kendo TextBox</h4>
                                <div class="component-meta-line">@T["Components.LibraryLabel"]: Kendo UI Core</div>
                            </div>
                            <tbx-component-status key="kendo-textbox" />
                        </div>
                        <p class="component-note">@LocalText("Phù hợp khi muốn input text đồng bộ hoàn toàn với hệ widget Kendo trong cùng form.", "Useful when you want text input to fully match the rest of the Kendo widget set in a form.")</p>
                        <div class="component-sample">
                            <label class="form-label" for="kendo-textbox-demo">Reference id</label>
                            <input id="kendo-textbox-demo" placeholder="REQ-2048" />
                        </div>
                        <div class="component-status-note d-none" data-status-note></div>
                    </article>

                    <article class="component-card" id="card-kendo-autocomplete">
                        <div class="component-card-head">
                            <div>
                                <h4>Kendo AutoComplete</h4>
                                <div class="component-meta-line">@T["Components.LibraryLabel"]: Kendo UI Core</div>
                            </div>
                            <tbx-component-status key="kendo-autocomplete" />
                        </div>
                        <p class="component-note">@LocalText("Hợp cho tìm nhanh từ khóa, tag kỹ thuật hoặc gợi ý nhập mềm trong dashboard tool.", "A good fit for quick keyword lookup, technical tags, or soft input suggestions inside dashboards.")</p>
                        <div class="component-sample">
                            <label class="form-label" for="kendo-autocomplete-demo">Keyword</label>
                            <input id="kendo-autocomplete-demo" placeholder="UI, API, SQL..." />
                        </div>
                        <div class="component-status-note d-none" data-status-note></div>
                    </article>

                </div>
            </div>

            <div class="@TabPaneClass(ToolboxRouteSlugs.ComponentsTabs.Selection)" id="component-selection-pane" role="tabpanel" aria-labelledby="component-selection-tab" tabindex="0">
                <div class="component-family-head">
                    <h3>@T["Components.Sections.Selection"]</h3>
                    <p>@T["Components.SelectionIntro"]</p>
                </div>

                <div class="component-card-grid">
                    <article class="component-card">
                        <div class="component-card-head">
                            <div>
                                <h4>Native Checkbox</h4>
                                <div class="component-meta-line">@T["Components.LibraryLabel"]: Bootstrap + HTML</div>
                            </div>
                            <tbx-component-status key="native-checkbox" />
                        </div>
                        <p class="component-note">@LocalText("Giữ checkbox native giúp kích thước gọn, quen mắt và dễ kiểm soát khi nằm trong grid.", "Keeping the native checkbox makes it compact, familiar, and easier to control inside grids.")</p>
                        <div class="component-sample">
                            <div class="form-check">
                                <input id="native-checkbox-demo" class="form-check-input" type="checkbox" checked />
                                <label class="form-check-label" for="native-checkbox-demo">@LocalText("Cho phép nhắc việc qua email", "Enable reminder emails")</label>
                            </div>
                        </div>
                    </article>

                    <article class="component-card">
                        <div class="component-card-head">
                            <div>
                                <h4>Native Select</h4>
                                <div class="component-meta-line">@T["Components.LibraryLabel"]: Bootstrap + HTML</div>
                            </div>
                            <tbx-component-status key="native-select" />
                        </div>
                        <p class="component-note">@LocalText("Phù hợp cho danh sách ngắn, không cần filter và muốn đơn giản hóa DOM.", "A solid choice for short lists when filtering is unnecessary and the DOM should stay simple.")</p>
                        <div class="component-sample">
                            <label class="form-label" for="native-select-demo">Category</label>
                            <select id="native-select-demo" class="form-select">
                                <option>@LocalText("Tất cả", "All")</option>
                                <option>@T["TabulatorTaskCategory.Ui"]</option>
                                <option>@T["TabulatorTaskCategory.Localization"]</option>
                                <option>@T["TabulatorTaskCategory.Culture"]</option>
                            </select>
                        </div>
                    </article>

                    <article class="component-card" id="card-kendo-dropdownlist">
                        <div class="component-card-head">
                            <div>
                                <h4>Kendo DropDownList</h4>
                                <div class="component-meta-line">@T["Components.LibraryLabel"]: Kendo UI Core</div>
                            </div>
                            <tbx-component-status key="kendo-dropdownlist" />
                        </div>
                        <p class="component-note">@LocalText("Dùng tốt cho lookup chuẩn hóa như trạng thái, ưu tiên hoặc loại yêu cầu.", "Great for standardized lookups such as status, priority, or request type.")</p>
                        <div class="component-sample">
                            <label class="form-label" for="kendo-dropdownlist-demo">Priority</label>
                            <input id="kendo-dropdownlist-demo" />
                        </div>
                        <div class="component-status-note d-none" data-status-note></div>
                    </article>

                    <article class="component-card" id="card-kendo-combobox">
                        <div class="component-card-head">
                            <div>
                                <h4>Kendo ComboBox</h4>
                                <div class="component-meta-line">@T["Components.LibraryLabel"]: Kendo UI Core</div>
                            </div>
                            <tbx-component-status key="kendo-combobox" />
                        </div>
