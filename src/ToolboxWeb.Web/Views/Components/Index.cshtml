    var componentText = new
    {
        CultureName = currentCulture,
        WidgetUnavailable = T["Components.WidgetUnavailable"].Value,
        BundleCheck = T["Components.StatusBundleCheck"].Value,
        UsableNow = T["Components.StatusUsableNow"].Value,
        BundleOnly = T["Components.StatusBundleOnly"].Value,
        AssetOnly = T["Components.StatusAssetOnly"].Value,
        MissingBundle = T["Components.StatusMissingBundle"].Value,
        NativeReady = LocalText("Dùng ngay", "Ready now"),
