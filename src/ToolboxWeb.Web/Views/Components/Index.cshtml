@section Styles {
    <link rel="stylesheet" href="~/vendor/kendo/icons/index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/vendor/kendo/theme/default-main.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/vendor/tabulator/css/tabulator.min.css" asp-append-version="true" />
    <style>
        .component-hub {
            display: grid;
            gap: 18px;
        }

        .component-hero,
        .component-tabs-shell,
        .component-card,
        .catalog-card {
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: 18px;
        }

        .component-hero {
            background:
                radial-gradient(circle at top left, rgba(37, 99, 235, .12), transparent 26%),
                radial-gradient(circle at top right, rgba(15, 118, 110, .10), transparent 22%),
                var(--surface);
            overflow: hidden;
            padding: clamp(20px, 3vw, 30px);
        }

        .component-hero h2 {
            font-size: clamp(1.45rem, 2.8vw, 2.1rem);
            margin: 0 0 10px;
        }

        .component-hero p {
            color: var(--muted);
            margin: 0;
            max-width: 980px;
        }

        .component-hero-meta,
        .component-hero-links,
        .component-card-grid,
        .catalog-grid,
        .tabulator-mini-toolbar {
            display: grid;
            gap: 12px;
        }

        .component-hero-meta {
            grid-template-columns: repeat(4, minmax(0, 1fr));
            margin-top: 18px;
        }

        .component-hero-pill {
            background: color-mix(in srgb, var(--surface-2) 72%, var(--surface));
            border: 1px solid var(--line);
            border-radius: 14px;
            padding: 12px 14px;
        }

        .component-hero-pill span,
        .component-meta-line,
        .component-note-label,
        .catalog-head {
            color: var(--muted);
            font-size: .8rem;
            font-weight: 750;
            text-transform: uppercase;
        }

        .component-hero-pill strong {
            display: block;
            margin-top: 4px;
        }

        .component-hero-links {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            margin-top: 18px;
        }

        .component-link-card {
            background: color-mix(in srgb, var(--surface-2) 62%, var(--surface));
            border: 1px solid var(--line);
            border-radius: 14px;
            display: flex;
            gap: 12px;
            justify-content: space-between;
            padding: 14px;
        }

        .component-link-card a {
            align-self: center;
            border: 1px solid var(--line);
            border-radius: 999px;
            color: var(--text);
            font-weight: 700;
            padding: 8px 14px;
            text-decoration: none;
            white-space: nowrap;
        }

        .component-tabs-shell {
            overflow: hidden;
        }

        .component-tab-nav {
            border-bottom: 1px solid var(--line);
            gap: 8px;
            padding: 14px 14px 0;
        }

        .component-tab-nav .nav-link {
            border: 1px solid transparent;
            border-top-left-radius: 12px;
            border-top-right-radius: 12px;
            color: var(--muted);
            font-weight: 800;
            transform: translateY(0);
            transition: color .18s ease, background-color .18s ease, border-color .18s ease, transform .18s ease, box-shadow .18s ease;
            will-change: transform;
        }

        .component-tab-nav .nav-link:hover,
        .component-tab-nav .nav-link:focus {
            color: var(--text);
            transform: translateY(-1px);
        }

        .component-tab-nav .nav-link.active {
            background: var(--surface);
            border-color: var(--line) var(--line) var(--surface);
            color: var(--text);
        }

        .component-tab-content {
            padding: 18px;
        }

        .component-tab-content > .tab-pane.fade,
        .component-sample .tab-content > .tab-pane.fade {
            transform: translateY(8px);
            transition: opacity .2s ease, transform .22s ease;
        }

        .component-tab-content > .tab-pane.fade.show,
        .component-sample .tab-content > .tab-pane.fade.show {
            transform: translateY(0);
        }

        .component-family-head {
            margin-bottom: 16px;
        }

        .component-family-head h3 {
            margin: 0 0 6px;
        }

        .component-family-head p {
            color: var(--muted);
            margin: 0;
            max-width: 980px;
        }

        .component-card-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .component-card,
        .catalog-card {
            padding: 16px;
        }

        .component-card.component-card-wide,
        .catalog-card {
            grid-column: 1 / -1;
        }

        .component-card-head {
            align-items: start;
            display: flex;
            gap: 12px;
            justify-content: space-between;
            margin-bottom: 12px;
        }

        .component-card h4 {
            font-size: 1.02rem;
            margin: 0 0 4px;
        }

        .component-note {
            color: var(--muted);
            font-size: .9rem;
            margin: 0 0 14px;
        }

        .component-status-badge {
            border-radius: 999px;
            font-size: .78rem;
            font-weight: 800;
            padding: 6px 10px;
            white-space: nowrap;
        }

        .status-usable {
            background: rgba(22, 163, 74, .14);
            color: #15803d;
        }

        .status-check {
            background: rgba(37, 99, 235, .12);
            color: #2563eb;
        }

        .status-bundle {
            background: rgba(217, 119, 6, .15);
            color: #b45309;
        }

        .status-asset {
            background: rgba(15, 118, 110, .14);
            color: #0f766e;
        }

        .status-missing {
            background: rgba(180, 35, 24, .12);
            color: var(--danger);
        }

        .component-status-note {
            border: 1px dashed rgba(180, 35, 24, .35);
            border-radius: 12px;
            color: var(--danger);
            font-size: .85rem;
            margin-top: 12px;
            padding: 9px 10px;
        }

        .component-sample {
            background: color-mix(in srgb, var(--surface-2) 46%, var(--surface));
            border: 1px solid var(--line);
            border-radius: 14px;
            padding: 14px;
        }

        .component-sample .form-label {
            color: var(--muted);
            display: block;
            font-size: .8rem;
            font-weight: 750;
            margin-bottom: 6px;
            text-transform: uppercase;
        }

        .component-sample .helper {
            color: var(--muted);
            font-size: .85rem;
            margin-top: 8px;
        }

        .component-sample .form-check {
            min-height: auto;
        }

        .component-sample .native-color-input {
            background: transparent;
            border: 1px solid var(--line);
            border-radius: 10px;
            height: 42px;
            padding: 4px;
            width: 100%;
        }

        .component-sample .bootstrap-alerts {
            display: grid;
            gap: 10px;
        }

        .component-popup-demo,
        .component-popup-demo-points {
            display: grid;
            gap: 12px;
        }

        .component-popup-demo-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .component-popup-demo-points {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            margin: 0;
            padding: 0;
        }

        .component-popup-demo-points li {
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: 12px;
            list-style: none;
            padding: 12px;
        }

        .component-popup-demo-points strong {
            display: block;
            margin-bottom: 4px;
        }

        .component-popup-demo-points span {
            color: var(--muted);
            display: block;
            font-size: .85rem;
        }

        .component-sample .k-widget,
        .component-sample .k-input,
        .component-sample .k-picker,
        .component-sample .k-dropdownlist,
        .component-sample .k-multiselect,
        .component-sample .k-combobox {
            width: 100%;
        }

        .component-sample .k-listview {
            border: 0;
        }

        .component-modal .modal-content {
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: 20px;
            box-shadow: 0 1.2rem 2.4rem rgba(23, 32, 51, .18);
            color: var(--text);
        }

        .component-modal .modal-header,
        .component-modal .modal-footer {
            border-color: var(--line);
            padding: 16px 20px;
        }

        .component-modal .modal-body {
            padding: 18px 20px 20px;
        }

        .component-modal-grid {
            display: grid;
            gap: 14px;
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .component-modal-field-wide {
            grid-column: 1 / -1;
        }

        .component-modal .form-control,
        .component-modal .form-select {
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: .85rem;
            color: var(--text);
            min-height: 44px;
            padding: .58rem .82rem;
        }

        .component-modal textarea.form-control {
            min-height: 108px;
            resize: vertical;
        }

        .component-modal .form-control:focus,
        .component-modal .form-select:focus {
            border-color: color-mix(in srgb, var(--accent) 52%, var(--line));
            box-shadow: 0 0 0 .2rem color-mix(in srgb, var(--accent) 16%, transparent);
        }

        .component-modal .modal-footer {
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .component-modal-footer-note {
            color: var(--muted);
            font-size: .85rem;
            margin: 0;
        }

        .component-sample .k-pager {
            border: 0;
            border-top: 1px solid var(--line);
            margin-top: 10px;
            padding-top: 8px;
        }

        .component-list-item {
            align-items: center;
            border-bottom: 1px solid color-mix(in srgb, var(--line) 74%, transparent);
            display: grid;
            gap: 12px;
            grid-template-columns: minmax(0, 1.3fr) minmax(120px, .7fr) minmax(120px, .65fr) 98px;
            padding: 12px 4px;
        }

        .component-list-item:last-child {
            border-bottom: 0;
        }

        .component-list-item strong {
            display: block;
        }

        .component-list-item small {
            color: var(--muted);
            display: block;
            margin-top: 3px;
        }

        .priority-pill,
        .status-pill {
            border-radius: 999px;
            display: inline-flex;
            font-size: .78rem;
            font-weight: 800;
            justify-content: center;
            padding: 5px 9px;
        }

        .priority-high {
            background: rgba(180, 35, 24, .13);
            color: var(--danger);
        }

        .priority-medium {
            background: rgba(37, 99, 235, .13);
            color: var(--accent);
        }

        .priority-low {
            background: rgba(15, 118, 110, .13);
            color: var(--accent-2);
        }

        .status-done {
            background: rgba(22, 163, 74, .14);
            color: #15803d;
        }

        .status-doing {
            background: rgba(37, 99, 235, .14);
            color: #2563eb;
        }

        .status-review {
            background: rgba(217, 119, 6, .16);
            color: #b45309;
        }

        .status-todo {
            background: rgba(100, 116, 139, .16);
            color: #475569;
        }

        .mini-progress {
            background: var(--surface-2);
            border-radius: 999px;
            height: 8px;
            overflow: hidden;
        }

        .mini-progress span {
            background: linear-gradient(90deg, var(--accent), var(--accent-2));
            display: block;
            height: 100%;
        }

        .tabulator-mini-shell {
            border: 1px solid var(--line);
            border-radius: 14px;
            overflow: hidden;
        }

        .tabulator-mini-toolbar {
            background: color-mix(in srgb, var(--surface-2) 55%, var(--surface));
            border-bottom: 1px solid var(--line);
            grid-template-columns: 1fr auto;
            padding: 12px 14px;
        }

        .tabulator-mini-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .tabulator-mini-actions button {
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: 999px;
            color: var(--text);
            font-weight: 700;
            padding: 8px 14px;
        }

        .tabulator-mini-actions button.primary {
            background: var(--accent);
            border-color: var(--accent);
            color: #fff;
        }

        .tabulator-mini-actions button.danger {
            border-color: var(--danger);
            color: var(--danger);
        }

        .tabulator-mini-state {
            align-items: center;
            display: inline-flex;
            gap: 8px;
            justify-content: end;
        }

        .tabulator-mini-chip {
            background: var(--surface);
            border-radius: 999px;
            color: var(--muted);
            font-size: .82rem;
            font-weight: 700;
            padding: 5px 10px;
        }

        .tabulator-mini-chip.dirty {
            background: color-mix(in srgb, var(--accent) 14%, transparent);
            color: var(--accent);
        }

        #component-tabulator-grid {
            min-height: 430px;
        }

        .tabulator-mini-shell .tabulator {
            background: var(--surface);
            border: 0;
            color: var(--text);
            font-family: inherit;
            font-size: .94rem;
        }

        .tabulator-mini-shell .tabulator .tabulator-header {
            background: color-mix(in srgb, var(--surface-2) 70%, var(--surface));
            border-bottom: 1px solid var(--line);
            color: var(--text);
            font-weight: 700;
        }

        .tabulator-mini-shell .tabulator .tabulator-col,
        .tabulator-mini-shell .tabulator .tabulator-cell {
            border-color: var(--line);
        }

        .tabulator-mini-shell .tabulator .tabulator-col .tabulator-col-content {
            justify-content: center;
            padding: 10px;
            text-align: center;
        }

        .tabulator-mini-shell .tabulator .tabulator-row {
            background: var(--surface);
            border-bottom: 1px solid color-mix(in srgb, var(--line) 72%, transparent);
        }

        .tabulator-mini-shell .tabulator .tabulator-row:nth-child(even) {
            background: color-mix(in srgb, var(--surface-2) 20%, var(--surface));
        }

        .tabulator-mini-shell .tabulator .tabulator-row:hover,
        .tabulator-mini-shell .tabulator-row.tabulator-selected {
            background: color-mix(in srgb, var(--accent) 7%, var(--surface));
        }

        .tabulator-mini-shell .tabulator .tabulator-row .tabulator-cell {
            background: transparent;
            padding: 10px 8px;
            vertical-align: middle;
        }

        .tabulator-mini-shell .tabulator .tabulator-cell.tabulator-editing {
            background: color-mix(in srgb, var(--accent) 4%, var(--surface));
            box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 26%, transparent);
            padding: 6px 8px;
        }

        .tabulator-mini-shell .tabulator .tabulator-cell input:not([type="checkbox"]),
        .tabulator-mini-shell .tabulator .tabulator-cell textarea,
        .tabulator-mini-shell .tabulator .tabulator-cell select {
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: .5rem;
            color: var(--text);
            font: inherit;
            min-height: 36px;
            padding: .42rem .72rem;
            width: 100%;
        }

        .tabulator-mini-shell .tabulator .tabulator-cell textarea {
            min-height: 76px;
            resize: vertical;
        }

        .tabulator-mini-shell .tabulator .tabulator-cell input:not([type="checkbox"]):focus,
        .tabulator-mini-shell .tabulator .tabulator-cell textarea:focus,
        .tabulator-mini-shell .tabulator .tabulator-cell select:focus {
            border-color: color-mix(in srgb, var(--accent) 50%, var(--line));
            box-shadow: 0 0 0 .2rem color-mix(in srgb, var(--accent) 16%, transparent);
            outline: 0;
        }

        .tabulator-edit-list,
        .tabulator-menu {
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: .75rem;
            box-shadow: 0 .75rem 1.5rem rgba(23, 32, 51, .12);
            color: var(--text);
            padding: 4px;
        }

        .tabulator-edit-list .tabulator-edit-list-item,
        .tabulator-menu .tabulator-menu-item {
            border-radius: .45rem;
            padding: .45rem .65rem;
        }

        .tabulator-edit-list .tabulator-edit-list-item.active,
        .tabulator-menu .tabulator-menu-item.active {
            background: var(--accent);
            color: #fff;
        }

        .tabulator-mini-feedback {
            border-top: 1px solid var(--line);
            color: var(--muted);
            min-height: 48px;
            padding: 12px 14px;
        }

        .tabulator-mini-feedback.success {
            color: #15803d;
        }

        .tabulator-mini-feedback.error {
            color: var(--danger);
        }

        .catalog-grid {
            grid-template-columns: 1fr;
        }

        .catalog-table {
            border: 1px solid var(--line);
            border-radius: 14px;
            overflow: hidden;
        }

        .catalog-row,
        .catalog-header {
            display: grid;
            gap: 12px;
            grid-template-columns: minmax(180px, 1.1fr) minmax(120px, .75fr) minmax(160px, .8fr) minmax(280px, 1.7fr);
            padding: 12px 14px;
        }

        .catalog-header {
            background: color-mix(in srgb, var(--surface-2) 70%, var(--surface));
            font-size: .8rem;
            font-weight: 800;
            text-transform: uppercase;
        }

        .catalog-row {
            align-items: center;
            border-top: 1px solid var(--line);
        }

        .catalog-row strong {
            display: block;
        }

        .catalog-row small {
            color: var(--muted);
            display: block;
        }

        #component-splitter {
            height: 260px;
        }

        #component-splitter .split-pane {
            color: var(--text);
            padding: 16px;
        }

        .component-hub .k-window,
        .k-popup,
        .k-list-container,
        .k-calendar-container,
        .k-notification-container,
        .k-animation-container,
        body > .k-animation-container {
            z-index: 3000 !important;
        }

        @@media (max-width: 1100px) {
            .component-hero-meta,
            .component-hero-links,
            .component-card-grid,
            .tabulator-mini-toolbar,
            .component-popup-demo-points,
            .catalog-row,
            .catalog-header {
                grid-template-columns: 1fr;
            }

            .component-link-card,
            .component-card-head,
            .tabulator-mini-state {
                align-items: start;
                flex-direction: column;
            }
        }

        @@media (max-width: 860px) {
            .component-tab-nav {
                display: flex;
                flex-wrap: nowrap;
                overflow-x: auto;
            }

            .component-tab-nav .nav-link {
                white-space: nowrap;
            }

            .component-list-item {
                grid-template-columns: 1fr;
            }

            .tabulator-mini-actions {
                flex-direction: column;
            }

            .component-modal-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 640px) {
            .component-modal .modal-header,
            .component-modal .modal-body,
            .component-modal .modal-footer {
                padding-left: 16px;
                padding-right: 16px;
            }

            .component-modal .modal-footer {
                align-items: stretch;
                flex-direction: column;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            .component-tab-nav .nav-link,
            .component-tab-content > .tab-pane.fade,
            .component-sample .tab-content > .tab-pane.fade {
                transition: none;
                transform: none;
            }
        }
    </style>
}

<div class="component-hub">
    <section class="component-hero">
        <h2>@T["Components.Title"]</h2>
        <p>@T["Components.Description"]</p>

        <div class="component-hero-meta">
            <div class="component-hero-pill">
                <span>@T["Components.Hero.DemoMode"]</span>
                <strong>@T["Components.Hero.DemoModeValue"]</strong>
            </div>
            <div class="component-hero-pill">
                <span>@T["Components.Hero.Grouping"]</span>
                <strong>@T["Components.Hero.GroupingValue"]</strong>
            </div>
            <div class="component-hero-pill">
                <span>@T["Components.Hero.GridMapping"]</span>
                <strong>@T["Components.Hero.GridMappingValue"]</strong>
            </div>
            <div class="component-hero-pill">
                <span>@T["Components.Hero.Legacy"]</span>
                <strong>@T["Components.Hero.LegacyValue"]</strong>
            </div>
        </div>

        <div class="component-hero-links">
            <div class="component-link-card">
                <div>
                    <div class="component-note-label">@T["Components.LegacyKendoTitle"]</div>
                    <strong>@T["Nav.KendoDemo"]</strong>
                    <div class="component-note">@T["Components.LegacyKendoNote"]</div>
                </div>
                <a asp-controller="DemoKendo" asp-action="Index">@T["Components.GoToKendoDemo"]</a>
            </div>
            <div class="component-link-card">
                <div>
                    <div class="component-note-label">@T["Components.LegacyTabulatorTitle"]</div>
                    <strong>@T["Nav.TabulatorDemo"]</strong>
                    <div class="component-note">@T["Components.LegacyTabulatorNote"]</div>
                </div>
                <a asp-controller="TabulatorDemo" asp-action="Index">@T["Components.GoToTabulatorDemo"]</a>
            </div>
        </div>
    </section>

    <section class="component-tabs-shell">
        <ul class="nav nav-tabs component-tab-nav" id="component-tabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="@TabButtonClass(ToolboxRouteSlugs.ComponentsTabs.TextInput)" id="component-text-tab" data-bs-toggle="tab" data-bs-target="#component-text-pane" data-route-url="@TabRoute(ToolboxRouteSlugs.ComponentsTabs.TextInput)" type="button" role="tab" aria-controls="component-text-pane" aria-selected="@(IsActiveTab(ToolboxRouteSlugs.ComponentsTabs.TextInput).ToString().ToLowerInvariant())">@T["Components.Sections.TextInput"]</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="@TabButtonClass(ToolboxRouteSlugs.ComponentsTabs.Selection)" id="component-selection-tab" data-bs-toggle="tab" data-bs-target="#component-selection-pane" data-route-url="@TabRoute(ToolboxRouteSlugs.ComponentsTabs.Selection)" type="button" role="tab" aria-controls="component-selection-pane" aria-selected="@(IsActiveTab(ToolboxRouteSlugs.ComponentsTabs.Selection).ToString().ToLowerInvariant())">@T["Components.Sections.Selection"]</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="@TabButtonClass(ToolboxRouteSlugs.ComponentsTabs.DateTimeNumeric)" id="component-datetime-tab" data-bs-toggle="tab" data-bs-target="#component-datetime-pane" data-route-url="@TabRoute(ToolboxRouteSlugs.ComponentsTabs.DateTimeNumeric)" type="button" role="tab" aria-controls="component-datetime-pane" aria-selected="@(IsActiveTab(ToolboxRouteSlugs.ComponentsTabs.DateTimeNumeric).ToString().ToLowerInvariant())">@T["Components.Sections.DateTimeNumeric"]</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="@TabButtonClass(ToolboxRouteSlugs.ComponentsTabs.GridData)" id="component-grid-tab" data-bs-toggle="tab" data-bs-target="#component-grid-pane" data-route-url="@TabRoute(ToolboxRouteSlugs.ComponentsTabs.GridData)" type="button" role="tab" aria-controls="component-grid-pane" aria-selected="@(IsActiveTab(ToolboxRouteSlugs.ComponentsTabs.GridData).ToString().ToLowerInvariant())">@T["Components.Sections.GridData"]</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="@TabButtonClass(ToolboxRouteSlugs.ComponentsTabs.FeedbackPopup)" id="component-feedback-tab" data-bs-toggle="tab" data-bs-target="#component-feedback-pane" data-route-url="@TabRoute(ToolboxRouteSlugs.ComponentsTabs.FeedbackPopup)" type="button" role="tab" aria-controls="component-feedback-pane" aria-selected="@(IsActiveTab(ToolboxRouteSlugs.ComponentsTabs.FeedbackPopup).ToString().ToLowerInvariant())">@T["Components.Sections.FeedbackPopup"]</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="@TabButtonClass(ToolboxRouteSlugs.ComponentsTabs.NavigationLayout)" id="component-layout-tab" data-bs-toggle="tab" data-bs-target="#component-layout-pane" data-route-url="@TabRoute(ToolboxRouteSlugs.ComponentsTabs.NavigationLayout)" type="button" role="tab" aria-controls="component-layout-pane" aria-selected="@(IsActiveTab(ToolboxRouteSlugs.ComponentsTabs.NavigationLayout).ToString().ToLowerInvariant())">@T["Components.Sections.NavigationLayout"]</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="@TabButtonClass(ToolboxRouteSlugs.ComponentsTabs.Catalog)" id="component-catalog-tab" data-bs-toggle="tab" data-bs-target="#component-catalog-pane" data-route-url="@TabRoute(ToolboxRouteSlugs.ComponentsTabs.Catalog)" type="button" role="tab" aria-controls="component-catalog-pane" aria-selected="@(IsActiveTab(ToolboxRouteSlugs.ComponentsTabs.Catalog).ToString().ToLowerInvariant())">@T["Components.Sections.Catalog"]</button>
            </li>
        </ul>

        <div class="tab-content component-tab-content">
            <div class="@TabPaneClass(ToolboxRouteSlugs.ComponentsTabs.TextInput)" id="component-text-pane" role="tabpanel" aria-labelledby="component-text-tab" tabindex="0">
                <div class="component-family-head">
                    <h3>@T["Components.Sections.TextInput"]</h3>
                    <p>@T["Components.TextInputIntro"]</p>
                </div>

                <div class="component-card-grid">
                    <article class="component-card component-card-wide d-none" aria-hidden="true">
