                        <p class="component-note">@LocalText("Phù hợp để nhóm guideline, checklist hoặc help content theo cụm có thể expand/collapse.", "Useful for grouped guidelines, checklists, or help content that should expand and collapse.")</p>
                        <div class="component-sample">
                            <ul id="component-panelbar">
                                <li class="k-active">@LocalText("Form usage", "Form usage")
