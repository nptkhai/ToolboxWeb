                            <div>
                                <h4>Bootstrap CRUD Popup</h4>
                                <div class="component-meta-line">@T["Components.LibraryLabel"]: Bootstrap Modal + Kendo Notification + Tabulator</div>
                            </div>
                            <span class="component-status-badge status-usable">@T["Components.StatusUsableNow"]</span>
                        </div>
