            <div class="@TabPaneClass(ToolboxRouteSlugs.ComponentsTabs.Catalog)" id="component-catalog-pane" role="tabpanel" aria-labelledby="component-catalog-tab" tabindex="0">
                <partial name="_Catalog" />
            </div>
        </div>
    </section>
</div>

