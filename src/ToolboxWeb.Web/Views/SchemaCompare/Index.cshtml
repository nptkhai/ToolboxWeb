@using System.Text.Json
@using ToolboxWeb.Web.ViewModels.SchemaCompare
@model SchemaComparePageViewModel
@{
    ViewData["Title"] = T["SchemaCompare.Title"];
    var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };

    // Dictionary keys are not touched by PropertyNamingPolicy, so these stay PascalCase and
    // match the values the API returns.
    var actionLabels = new Dictionary<string, string>
    {
        ["Add"] = T["SchemaCompare.Change.OnlyInSource"].Value,
        ["Change"] = T["SchemaCompare.Change.Different"].Value,
        ["Delete"] = T["SchemaCompare.Change.OnlyInTarget"].Value
    };
    var lineStateLabels = new Dictionary<string, string>
    {
        ["Same"] = T["SchemaCompare.Line.Same"].Value,
        ["Changed"] = T["SchemaCompare.Line.Changed"].Value,
        ["OnlyInSource"] = T["SchemaCompare.Line.OnlyInSource"].Value,
        ["OnlyInTarget"] = T["SchemaCompare.Line.OnlyInTarget"].Value
    };

    var emptyHint = new EmptyStateViewModel(T["SchemaCompare.Message.EmptyHint"].Value, "git-compare");
    var equalState = new EmptyStateViewModel(T["SchemaCompare.Message.NoDifferences"].Value, "circle-check");
    var testConnectionUrl = Url.Action("TestConnection", "SchemaCompare") ?? string.Empty;
    var configJson = JsonSerializer.Serialize(new
    {
        urls = new
        {
            start = Url.Action("StartCompare", "SchemaCompare"),
            progress = Url.Action("Progress", "SchemaCompare"),
            toggle = Url.Action("ToggleInclude", "SchemaCompare"),
            detail = Url.Action("DiffDetail", "SchemaCompare"),
            script = Url.Action("GenerateScript", "SchemaCompare"),
            download = Url.Action("DownloadScript", "SchemaCompare"),
            cancel = Url.Action("CancelCompare", "SchemaCompare")
        },
        actions = actionLabels,
        lineStates = lineStateLabels,
        progressStates = new Dictionary<string, string>
        {
            ["Running"] = T["SchemaCompare.Progress.State.Running"].Value,
            ["Completed"] = T["SchemaCompare.Progress.State.Completed"].Value,
            ["Failed"] = T["SchemaCompare.Progress.State.Failed"].Value
        },
        columns = new
        {
            sourceName = T["SchemaCompare.Grid.SourceName"].Value,
            status = T["SchemaCompare.Grid.Status"].Value,
            targetName = T["SchemaCompare.Grid.TargetName"].Value,
            objectType = T["SchemaCompare.Grid.ObjectType"].Value,
            changes = T["SchemaCompare.Grid.ChangeCount"].Value
        },
        messages = new
        {
            comparing = T["SchemaCompare.Message.Comparing"].Value,
            genericError = T["SchemaCompare.Error.CompareFailed"].Value,
            networkError = T["SchemaCompare.Error.Network"].Value,
            bothSidesRequired = T["SchemaCompare.Message.BothSidesRequired"].Value,
            gridEmpty = T["SchemaCompare.Message.GridEmpty"].Value,
            noDifferences = T["SchemaCompare.Message.NoDifferences"].Value,
            detailHint = T["SchemaCompare.Message.DetailHint"].Value,
            detailEmpty = T["SchemaCompare.Message.DetailEmpty"].Value,
            copied = T["SchemaCompare.Message.Copied"].Value,
            copyFailed = T["SchemaCompare.Message.CopyFailed"].Value,
            summary = T["SchemaCompare.Message.Summary"].Value,
            blocked = T["SchemaCompare.Message.Blocked"].Value,
            destructiveDefault = T["SchemaCompare.Message.DestructiveDefault"].Value,
            scriptSelection = T["SchemaCompare.Message.ScriptSelection"].Value,
            scriptEmpty = T["SchemaCompare.Message.ScriptEmpty"].Value,
            allTypes = T["SchemaCompare.Result.AllTypes"].Value,
            elapsed = T["SchemaCompare.Message.Elapsed"].Value,
            mappedSame = T["SchemaCompare.Message.MappedSame"].Value,
            showMapped = T["SchemaCompare.Action.ShowMapped"].Value,
            hideMapped = T["SchemaCompare.Action.HideMapped"].Value,
            collapsedLines = T["SchemaCompare.Detail.CollapsedLines"].Value,
            expand = T["SchemaCompare.Detail.Expand"].Value,
            collapse = T["SchemaCompare.Detail.Collapse"].Value,
            mappingAutoFilled = T["SchemaCompare.Mapping.AutoFilled"].Value,
            mappingAutoFailed = T["SchemaCompare.Mapping.AutoFailed"].Value,
            cancelling = T["SchemaCompare.Message.Cancelling"].Value,
            showDetail = T["SchemaCompare.Result.ShowDetail"].Value,
            mappingCodeTitle = T["SchemaCompare.Mapping.CodeHelpTitle"].Value,
            mappingCodeSuffix = T["SchemaCompare.Mapping.CodeHelpSuffix"].Value,
            mappingCodeEmpty = T["SchemaCompare.Mapping.CodeHelpEmpty"].Value,
            toggleWorking = T["SchemaCompare.Message.ToggleWorking"].Value,
            toggleDone = T["SchemaCompare.Message.ToggleDone"].Value,
            detailLoading = T["SchemaCompare.Detail.Loading"].Value,
            scriptLoading = T["SchemaCompare.Script.Loading"].Value,
            swapped = T["SchemaCompare.Message.Swapped"].Value,
            readyMissing = T["SchemaCompare.Ready.Missing"].Value,
            readyTestSource = T["SchemaCompare.Ready.TestSource"].Value,
            readyTestTarget = T["SchemaCompare.Ready.TestTarget"].Value,
            readyChooseSource = T["SchemaCompare.Ready.ChooseSource"].Value,
            readyChooseTarget = T["SchemaCompare.Ready.ChooseTarget"].Value,
            readySameDatabase = T["SchemaCompare.Ready.SameDatabase"].Value,
            dropCount = T["SchemaCompare.Script.DropCount"].Value,
            warnDataLossGuard = T["SchemaCompare.Script.WarnDataLossGuard"].Value,
            warnRebuild = T["SchemaCompare.Script.WarnRebuild"].Value,
            confirmTitle = T["SchemaCompare.Script.ConfirmTitle"].Value,
            confirmMessage = T["SchemaCompare.Script.ConfirmMessage"].Value,
            confirmMore = T["SchemaCompare.Script.ConfirmMore"].Value,
            confirmDownload = T["SchemaCompare.Script.ConfirmDownload"].Value,
            confirmCopy = T["SchemaCompare.Script.ConfirmCopy"].Value,
            optionsReset = T["SchemaCompare.Options.ResetDone"].Value
        },
        stats = new
        {
            total = T["SchemaCompare.Stats.Total"].Value,
            onlyInSource = T["SchemaCompare.Stats.OnlyInSource"].Value,
            different = T["SchemaCompare.Stats.Different"].Value,
            onlyInTarget = T["SchemaCompare.Stats.OnlyInTarget"].Value
        }
    }, jsonOptions);
}

@section Styles {
    <link rel="stylesheet" href="~/vendor/tabulator/css/tabulator.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/vendor/kendo/theme/default-main.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sql-connection.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/schema-compare.css" asp-append-version="true" />
}

<div class="sc-page" id="sc-root">
    @Html.AntiForgeryToken()

    <ol class="tbx-steps sc-steps">
        @*
            Step 1: connections. Two mirrored cards so the eye can compare field by field, with
            the role and its consequence stated in the header rather than in a paragraph above.
        *@
        <li class="tbx-step" data-step="1">
            <div class="tbx-step-head sc-step-head">
                <span class="tbx-step-no" aria-hidden="true">1</span>
                <h2 class="tbx-step-title">@T["SchemaCompare.Step.Connections"]</h2>
                <button class="btn btn-outline-secondary btn-sm sc-swap" type="button" id="sc-swap">
                    <tbx-icon name="arrow-left-right" />
                    <span>@T["SchemaCompare.Action.Swap"]</span>
                </button>
            </div>

            <div class="sc-endpoints">
                @foreach (var side in new[]
                {
                    new { Key = "source", Title = T["SchemaCompare.Source"].Value, Hint = T["SchemaCompare.SourceHint"].Value },
                    new { Key = "target", Title = T["SchemaCompare.Target"].Value, Hint = T["SchemaCompare.TargetHint"].Value }
                })
                {
                    <partial name="_SqlConnectionForm" model="new SqlConnectionFormViewModel { IdPrefix = side.Key, Side = side.Key, Title = side.Title, Tag = side.Hint, TestUrl = testConnectionUrl }" />
                }
            </div>
        </li>

        @*
            Step 2: what to compare. Scope is the only thing most runs touch, so it stays open;
            noise reduction and name mapping are collapsed because they are set once and then
            left alone. Every choice here is remembered in the browser.
        *@
        <li class="tbx-step" data-step="2">
            <div class="tbx-step-head sc-step-head">
                <span class="tbx-step-no" aria-hidden="true">2</span>
                <h2 class="tbx-step-title">@T["SchemaCompare.Options.Title"]</h2>
                <span class="tbx-step-hint">@T["SchemaCompare.Options.ScopeHint"]</span>
                <button class="btn btn-link btn-sm sc-reset" type="button" id="sc-reset-options">@T["SchemaCompare.Options.ResetDefaults"]</button>
            </div>

            <div class="sc-scope-chips" role="group" aria-label="@T["SchemaCompare.Options.Scope"]">
                @foreach (var scope in new[]
                {
                    new { Key = "tables", Label = T["SchemaCompare.Scope.Tables"].Value, Checked = true },
                    new { Key = "views", Label = T["SchemaCompare.Scope.Views"].Value, Checked = true },
                    new { Key = "storedProcedures", Label = T["SchemaCompare.Scope.StoredProcedures"].Value, Checked = true },
                    new { Key = "functions", Label = T["SchemaCompare.Scope.Functions"].Value, Checked = true },
                    new { Key = "triggers", Label = T["SchemaCompare.Scope.Triggers"].Value, Checked = true },
                    new { Key = "tableTypes", Label = T["SchemaCompare.Scope.TableTypes"].Value, Checked = true },
                    new { Key = "sequences", Label = T["SchemaCompare.Scope.Sequences"].Value, Checked = true },
                    new { Key = "synonyms", Label = T["SchemaCompare.Scope.Synonyms"].Value, Checked = true },
                    new { Key = "fullText", Label = T["SchemaCompare.Scope.FullText"].Value, Checked = true },
                    new { Key = "extendedProperties", Label = T["SchemaCompare.Scope.ExtendedProperties"].Value, Checked = false },
                    new { Key = "securityObjects", Label = T["SchemaCompare.Scope.SecurityObjects"].Value, Checked = false }
                })
                {
                    <label class="tbx-chip sc-scope-chip" for="scope-@scope.Key">
                        <input class="form-check-input" id="scope-@scope.Key" data-scope="@scope.Key" type="checkbox"
                               checked="@scope.Checked" data-default="@(scope.Checked ? "true" : "false")" />
                        <span>@scope.Label</span>
                    </label>
                }
            </div>

            <button class="sc-advanced-toggle" type="button" id="sc-toggle-options" aria-expanded="false" aria-controls="sc-options">
                <tbx-icon name="chevron-right" class="sc-caret" />@T["SchemaCompare.Options.Advanced"]
            </button>

            <div class="sc-advanced" id="sc-options" hidden>
                <section class="sc-advanced-group">
                    <h3 class="sc-group-title">@T["SchemaCompare.Options.Noise"]</h3>
                    <div class="sc-check-grid">
                        @foreach (var option in new[]
                        {
                            new { Key = "ignoreWhitespace", Label = T["SchemaCompare.Options.IgnoreWhitespace"].Value, Checked = true },
                            new { Key = "ignoreComments", Label = T["SchemaCompare.Options.IgnoreComments"].Value, Checked = false },
                            new { Key = "ignoreKeywordCasing", Label = T["SchemaCompare.Options.IgnoreKeywordCasing"].Value, Checked = true },
                            new { Key = "ignoreColumnOrder", Label = T["SchemaCompare.Options.IgnoreColumnOrder"].Value, Checked = true },
                            new { Key = "ignoreIdentitySeed", Label = T["SchemaCompare.Options.IgnoreIdentitySeed"].Value, Checked = true },
                            new { Key = "ignoreFillFactor", Label = T["SchemaCompare.Options.IgnoreFillFactor"].Value, Checked = true },
                            new { Key = "ignoreFilegroupPlacement", Label = T["SchemaCompare.Options.IgnoreFilegroupPlacement"].Value, Checked = true },
                            new { Key = "ignoreIndexOptions", Label = T["SchemaCompare.Options.IgnoreIndexOptions"].Value, Checked = true },
                            new { Key = "ignoreExtendedProperties", Label = T["SchemaCompare.Options.IgnoreExtendedProperties"].Value, Checked = true }
                        })
                        {
                            <div class="form-check">
                                <input class="form-check-input" id="opt-@option.Key" data-option="@option.Key" type="checkbox"
                                       checked="@option.Checked" data-default="@(option.Checked ? "true" : "false")" />
                                <label class="form-check-label" for="opt-@option.Key">@option.Label</label>
                            </div>
                        }
                    </div>
                </section>

                <section class="sc-advanced-group sc-mapping" id="sc-mapping">
                    <div class="sc-group-head">
                        <h3 class="sc-group-title">@T["SchemaCompare.Mapping.Title"]</h3>
                        <button class="btn btn-outline-secondary btn-sm" type="button" id="sc-mapping-auto">
                            <tbx-icon name="wand-sparkles" />@T["SchemaCompare.Mapping.Auto"]
                        </button>
                    </div>

                    <div class="sc-map-row">
                        <div class="tbx-field sc-field-code">
                            <label class="tbx-field-label" for="sc-code-from">@T["SchemaCompare.Mapping.CodeFrom"]</label>
                            <input class="form-control sc-code-input" id="sc-code-from" autocomplete="off" placeholder="ORG" />
                        </div>
                        <span class="sc-map-arrow" aria-hidden="true"><tbx-icon name="chevron-right" /></span>
                        <div class="tbx-field sc-field-code">
                            <label class="tbx-field-label" for="sc-code-to">@T["SchemaCompare.Mapping.CodeTo"]</label>
                            <input class="form-control sc-code-input" id="sc-code-to" autocomplete="off" placeholder="FBU" />
                        </div>
                    </div>

                    @*
                        The examples are rebuilt from whatever codes are typed, so the box shows
                        the actual rewrite rather than a fixed sentence about it.
                    *@
                    <p class="sc-hint-box" aria-live="polite">
                        <tbx-icon name="info" />
                        <span data-role="code-preview"></span>
                    </p>

                    <div class="tbx-field">
                        <label class="tbx-field-label" for="sc-mapping-input">@T["SchemaCompare.Mapping.ExtraTitle"]</label>
                        <textarea class="form-control sc-mapping-input" id="sc-mapping-input" rows="2"
                                  placeholder="@T["SchemaCompare.Mapping.Placeholder"]" spellcheck="false"></textarea>
                    </div>

                    <p class="sc-hint-box">
                        <tbx-icon name="info" />
                        <span><strong>@T["SchemaCompare.Mapping.HelpSummary"]:</strong> @T["SchemaCompare.Mapping.Help"]</span>
                    </p>
                </section>
            </div>
        </li>

        @* Step 3: run, then read the result and the script in the same place. *@
        <li class="tbx-step" data-step="3">
            <div class="tbx-step-head sc-step-head">
                <span class="tbx-step-no" aria-hidden="true">3</span>
                <h2 class="tbx-step-title">@T["SchemaCompare.Step.Run"]</h2>
                <span class="tbx-step-hint">@T["SchemaCompare.Step.RunHint"]</span>
            </div>

            <div class="sc-run-bar">
                <button class="btn btn-primary sc-run-btn" type="button" id="sc-compare" disabled aria-describedby="sc-ready">
                    <tbx-icon name="loader-circle" class="sc-spinner tbx-spin" />
                    <tbx-icon name="git-compare" class="sc-run-icon" />
                    <span>@T["SchemaCompare.Action.Compare"]</span>
                </button>
                <button class="btn btn-outline-danger" type="button" id="sc-cancel" hidden>@T["SchemaCompare.Action.Cancel"]</button>
                <span class="sc-clock" id="sc-clock" hidden>00:00:00</span>
                <span class="sc-run-status" data-role="compare-status" role="status" aria-live="polite"></span>
                <div class="sc-quick-summary" data-role="quick-summary" hidden>
                    <span class="qs-item"><span class="qs-label">@T["SchemaCompare.Stats.Total"]</span><b data-count="all">0</b></span>
                    <span class="qs-item qs-change"><span class="qs-label">@T["SchemaCompare.Stats.Different"]</span><b data-count="Change">0</b></span>
                    <span class="qs-item qs-add"><span class="qs-label">@T["SchemaCompare.Stats.OnlyInSource"]</span><b data-count="Add">0</b></span>
                    <span class="qs-item qs-del"><span class="qs-label">@T["SchemaCompare.Stats.OnlyInTarget"]</span><b data-count="Delete">0</b></span>
                </div>
            </div>

            @* What still blocks the Compare button, in words; empty once both sides are ready. *@
            <p class="sc-ready" id="sc-ready" data-role="ready" aria-live="polite"></p>

            @if (Model.HostAllowlistEnabled)
            {
                <p class="sc-note">@T["SqlConnection.HostAllowlistNotice"]</p>
            }

            <div class="tbx-error-state sc-compare-error" data-role="compare-error" role="alert" hidden>
                <tbx-icon name="circle-alert" />
                <span data-role="compare-error-text"></span>
            </div>

            <div data-role="results-empty">
                <partial name="_EmptyState" model="emptyHint" />
            </div>

            <section class="sc-results" id="sc-results" hidden>
                <ul class="nav nav-tabs sc-tabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="sc-tab-progress" data-bs-toggle="tab" data-bs-target="#sc-pane-progress"
                                type="button" role="tab" aria-controls="sc-pane-progress" aria-selected="true">
                            @T["SchemaCompare.Tab.Progress"]
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="sc-tab-result" data-bs-toggle="tab" data-bs-target="#sc-pane-result"
                                type="button" role="tab" aria-controls="sc-pane-result" aria-selected="false">
                            @T["SchemaCompare.Tab.Result"]
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="sc-tab-script" data-bs-toggle="tab" data-bs-target="#sc-pane-script"
                                type="button" role="tab" aria-controls="sc-pane-script" aria-selected="false">
                            @T["SchemaCompare.Tab.Script"]
                        </button>
                    </li>
                </ul>

                <div class="tab-content">
                    <div class="tab-pane fade show active" id="sc-pane-progress" role="tabpanel" aria-labelledby="sc-tab-progress">
                        <div class="sc-progress-grid">
                            @foreach (var side in new[] { ("source", T["SchemaCompare.Source"].Value), ("target", T["SchemaCompare.Target"].Value) })
                            {
                                <div class="sc-progress-column">
                                    <h3 class="sc-group-title">@side.Item2</h3>
                                    <div class="sc-table-scroll">
                                        <table class="sc-progress-table">
                                            <thead>
                                                <tr>
                                                    <th class="sc-col-time">@T["SchemaCompare.Progress.Time"]</th>
                                                    <th>@T["SchemaCompare.Progress.Operation"]</th>
                                                    <th class="sc-col-state">@T["SchemaCompare.Progress.Status"]</th>
                                                </tr>
                                            </thead>
                                            <tbody data-role="progress-@side.Item1"></tbody>
                                        </table>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="tab-pane fade" id="sc-pane-result" role="tabpanel" aria-labelledby="sc-tab-result">
                        <div data-role="result-equal" hidden>
                            <partial name="_EmptyState" model="equalState" />
                        </div>

                        <div class="sc-result-layout" data-role="result-layout">
                            @* Desktop keeps the type list as a column; below 1024px it becomes the
                               horizontal chip strip further down, which is the same data. *@
                            <aside class="sc-type-panel">
                                <h3 class="sc-group-title">@T["SchemaCompare.Result.ObjectTypes"]</h3>
                                <ul class="sc-type-list" data-role="type-list"></ul>
                            </aside>

                            <div class="sc-result-main">
                                <div class="sc-type-strip" data-role="type-chips" role="group" aria-label="@T["SchemaCompare.Result.ObjectTypes"]"></div>

                                <div class="sc-grid-toolbar">
                                    <div class="sc-search-wrap">
                                        <label class="visually-hidden" for="sc-search">@T["SchemaCompare.Action.SearchPlaceholder"]</label>
                                        <tbx-icon name="search" class="sc-search-icon" />
                                        <input class="form-control sc-search" id="sc-search" type="search"
                                               placeholder="@T["SchemaCompare.Action.SearchPlaceholder"]" autocomplete="off" />
                                    </div>
                                    <div class="sc-bulk">
                                        <button class="btn btn-outline-secondary btn-sm" type="button" id="sc-check-all">@T["SchemaCompare.Action.CheckAll"]</button>
                                        <button class="btn btn-outline-secondary btn-sm" type="button" id="sc-uncheck-all">@T["SchemaCompare.Action.UncheckAll"]</button>
                                    </div>
                                </div>

                                <div class="sc-filter-row">
                                    <div class="sc-filter-chips" data-role="filters" role="group" aria-label="@T["SchemaCompare.Result.FilterLabel"]">
                                        <button class="tbx-chip sc-filter" type="button" data-filter="all" aria-pressed="true">
                                            <span>@T["SchemaCompare.Filter.All"]</span>
                                            <span class="tbx-chip-count" data-count="all">0</span>
                                        </button>
                                        <button class="tbx-chip sc-filter" type="button" data-filter="Change" aria-pressed="false">
                                            <span class="sc-filter-mark is-change" aria-hidden="true">&#8800;</span>
                                            <span>@T["SchemaCompare.Change.Different"]</span>
                                            <span class="tbx-chip-count" data-count="Change">0</span>
                                        </button>
                                        <button class="tbx-chip sc-filter" type="button" data-filter="Add" aria-pressed="false">
                                            <span class="sc-filter-mark is-add" aria-hidden="true">&plus;</span>
                                            <span>@T["SchemaCompare.Change.OnlyInSource"]</span>
                                            <span class="tbx-chip-count" data-count="Add">0</span>
                                        </button>
                                        <button class="tbx-chip sc-filter" type="button" data-filter="Delete" aria-pressed="false">
                                            <span class="sc-filter-mark is-del" aria-hidden="true">&minus;</span>
                                            <span>@T["SchemaCompare.Change.OnlyInTarget"]</span>
                                            <span class="tbx-chip-count" data-count="Delete">0</span>
                                        </button>
                                    </div>
                                    <span class="sc-keys">
                                        <kbd class="tbx-kbd">J</kbd><kbd class="tbx-kbd">K</kbd>
                                        @T["SchemaCompare.Result.Keys"]
                                    </span>
                                </div>

                                <div class="sc-mapped-note" data-role="mapped-note" hidden>
                                    <span data-role="mapped-text"></span>
                                    <button class="btn btn-link btn-sm" type="button" id="sc-toggle-mapped">@T["SchemaCompare.Action.ShowMapped"]</button>
                                </div>

                                @* Table on tablet and up; the card list below takes over under 600px. *@
                                <div class="sc-grid" id="sc-grid"></div>
                                <div class="sc-card-list" data-role="card-list"></div>

                                <div class="sc-detail" data-role="detail">
                                    <div class="sc-detail-header">
                                        <button class="btn btn-outline-secondary btn-sm sc-detail-back" type="button" data-role="detail-back">
                                            <tbx-icon name="arrow-left" />@T["SchemaCompare.Result.BackToList"]
                                        </button>
                                        <strong class="sc-detail-title" data-role="detail-title"></strong>
                                        <span class="sc-detail-summary" data-role="detail-summary"></span>
                                        <span class="sc-spacer"></span>
                                        <div class="form-check sc-detail-toggle" hidden data-role="only-changes-wrap">
                                            <input class="form-check-input" type="checkbox" id="sc-only-changes" checked />
                                            <label class="form-check-label" for="sc-only-changes">@T["SchemaCompare.Detail.OnlyChanges"]</label>
                                        </div>
                                        <button class="btn btn-sm tbx-icon-button" type="button" id="sc-prev-change" hidden
                                                title="@T["SchemaCompare.Detail.PrevChange"]" aria-label="@T["SchemaCompare.Detail.PrevChange"]">
                                            <tbx-icon name="chevron-up" />
                                        </button>
                                        <button class="btn btn-sm tbx-icon-button" type="button" id="sc-next-change" hidden
                                                title="@T["SchemaCompare.Detail.NextChange"]" aria-label="@T["SchemaCompare.Detail.NextChange"]">
                                            <tbx-icon name="chevron-down" />
                                        </button>
                                        <button class="btn btn-outline-secondary btn-sm" type="button" id="sc-expand-detail" hidden>@T["SchemaCompare.Detail.Expand"]</button>
                                    </div>
                                    <div class="sc-detail-body" data-role="detail-body"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="tab-pane fade" id="sc-pane-script" role="tabpanel" aria-labelledby="sc-tab-script">
                        <div class="sc-script-bar">
                            <a class="btn btn-primary btn-sm" id="sc-download-script" href="#">
                                <tbx-icon name="download" />@T["SchemaCompare.Action.DownloadScript"]
                            </a>
                            <button class="btn btn-outline-secondary btn-sm" type="button" id="sc-copy-script">
                                <tbx-icon name="copy" />@T["Action.Copy"]
                            </button>
                            <button class="btn btn-outline-secondary btn-sm" type="button" id="sc-refresh-script">
                                <tbx-icon name="refresh-cw" />@T["SchemaCompare.Action.GenerateScript"]
                            </button>
                            <span class="sc-run-status" data-role="script-status" role="status" aria-live="polite"></span>
                        </div>

                        <div class="sc-script-warn" data-role="script-warnings" hidden>
                            <div class="sc-script-warn-head">
                                <tbx-icon name="triangle-alert" />
                                <strong data-role="script-drop-count"></strong>
                                <button class="btn btn-outline-danger btn-sm" type="button" id="sc-next-drop" hidden>
                                    <tbx-icon name="chevron-down" />@T["SchemaCompare.Script.NextDrop"]
                                </button>
                            </div>
                            <p class="sc-script-warn-title">@T["SchemaCompare.Script.Warnings"]</p>
                            <ul data-role="script-warning-list"></ul>
                        </div>

                        <div class="sc-script-state" data-role="script-state"></div>
                        @* Read-only code view: one line per span so DROP lines can be marked. *@
                        <pre class="sc-script" id="sc-script" tabindex="0" role="region" aria-label="@T["SchemaCompare.Tab.Script"]" hidden><code data-role="script-code"></code></pre>
                    </div>
                </div>
            </section>
        </li>
    </ol>
</div>

<script id="sc-config" type="application/json">@Html.Raw(configJson)</script>

@section Scripts {
    <partial name="_KendoScripts" />
    <script src="~/vendor/tabulator/js/tabulator.min.js" asp-append-version="true"></script>
    <script src="~/js/sql-connection.js" asp-append-version="true"></script>
    <script src="~/js/schema-compare.js" asp-append-version="true"></script>
}
