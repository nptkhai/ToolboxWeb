@page
@model ToolboxWeb.Web.Areas.Identity.Pages.Account.Manage.IndexModel
@{
    ViewData["Title"] = T["Profile.Nav.Profile"];
}

<partial name="_StatusMessage" model="Model.StatusMessage" />

<section class="tbx-panel tbx-panel-body account-section" aria-labelledby="profile-title">
    <h2 class="account-section-title" id="profile-title"><tbx-icon name="user" />@T["Profile.SectionTitle"]</h2>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <form method="post" enctype="multipart/form-data" class="identity-profile-form">
        <div class="identity-profile-avatar">
            <partial name="/Views/Shared/Controls/_ImageUploadControl.cshtml" model="Model.AvatarControl" />
        </div>

        <div class="identity-profile-fields">
            <dl class="account-facts">
                <div>
                    <dt>@T["Profile.UserNameLabel"]</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.Profile.UserName) ? "-" : Model.Profile.UserName)</dd>
                </div>
                <div>
                    <dt>@T["Profile.EmailLabel"]</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.Profile.Email) ? "-" : Model.Profile.Email)</dd>
                </div>
            </dl>

            <p class="tbx-field-hint">@T["Profile.FormHelper"]</p>

            <div class="account-actions">
                <button type="submit" class="btn btn-primary">@T["Profile.SaveButton"]</button>
            </div>
        </div>
    </form>
</section>

<section class="tbx-panel tbx-panel-body account-section" aria-labelledby="display-settings-title">
    <h2 class="account-section-title" id="display-settings-title"><tbx-icon name="monitor" />@T["Profile.Display.Title"]</h2>
    <p class="account-lead">@T["Profile.Display.Description"]</p>
    <div class="form-check form-switch">
        <input class="form-check-input" type="checkbox" role="switch" id="display-background" data-display-setting="toolbox.background" aria-describedby="display-background-hint" />
        <label class="form-check-label" for="display-background">@T["Profile.Display.Background"]</label>
        <div class="tbx-field-hint" id="display-background-hint">@T["Profile.Display.BackgroundHint"]</div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
