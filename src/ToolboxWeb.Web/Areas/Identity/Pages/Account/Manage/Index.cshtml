@page
@model ToolboxWeb.Web.Areas.Identity.Pages.Account.Manage.IndexModel
@{
    ViewData["Title"] = T["Profile.PageTitle"];
}

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success" role="alert">@Model.StatusMessage</div>
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<div class="identity-profile-card">
    <div class="identity-profile-copy">
        <span class="identity-profile-kicker">@T["Profile.SectionKicker"]</span>
        <h3>@T["Profile.SectionTitle"]</h3>
        <p>@T["Profile.SectionDescription"]</p>
    </div>

    <form method="post" enctype="multipart/form-data" class="identity-profile-form">
        <div class="identity-profile-avatar">
            <partial name="/Views/Shared/Controls/_ImageUploadControl.cshtml" model="Model.AvatarControl" />
        </div>

        <div class="identity-profile-fields">
            <div class="form-grid">
                <div>
                    <label class="form-label">@T["Profile.UserNameLabel"]</label>
                    <input class="form-control" type="text" value="@Model.Profile.UserName" readonly />
                </div>
                <div>
                    <label class="form-label">@T["Profile.EmailLabel"]</label>
                    <input class="form-control" type="email" value="@Model.Profile.Email" readonly />
                </div>
            </div>

            <div class="helper">@T["Profile.FormHelper"]</div>

            <div class="inline-actions">
                <button type="submit" class="btn btn-primary">@T["Profile.SaveButton"]</button>
                <a asp-page="./PersonalData" class="btn btn-outline-secondary">@T["Profile.OpenPersonalData"]</a>
            </div>
        </div>
    </form>
</div>

<section class="identity-profile-card identity-display-card" aria-labelledby="display-settings-title">
    <div class="identity-profile-copy">
        <h3 id="display-settings-title">@T["Profile.Display.Title"]</h3>
        <p>@T["Profile.Display.Description"]</p>
    </div>
    <div class="identity-display-options">
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="display-background" data-display-setting="toolbox.background" aria-describedby="display-background-hint" />
            <label class="form-check-label" for="display-background">@T["Profile.Display.Background"]</label>
            <div class="tbx-field-hint" id="display-background-hint">@T["Profile.Display.BackgroundHint"]</div>
        </div>
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="display-weather" data-display-setting="toolbox.background.weather" data-display-requires="toolbox.background" aria-describedby="display-weather-hint" />
            <label class="form-check-label" for="display-weather">@T["Profile.Display.Weather"]</label>
            <div class="tbx-field-hint" id="display-weather-hint">@T["Profile.Display.WeatherHint"]</div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
