@page
@model ToolboxWeb.Web.Areas.Identity.Pages.Account.Manage.ChangePasswordModel
@{
    ViewData["Title"] = T["Profile.Nav.Password"];
}

<partial name="_StatusMessage" model="Model.StatusMessage" />

<section class="tbx-panel tbx-panel-body account-section">
    @if (Model.IsJiraUser)
    {
        <p class="account-note"><tbx-icon name="info" /><span>@T["Account.Password.JiraNote"]</span></p>
    }
    else
    {
        <form method="post" class="account-form">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="tbx-field">
                <label class="tbx-field-label" asp-for="Input.OldPassword">@T["Account.Field.CurrentPassword"]</label>
                <div class="tbx-password">
                    <input class="form-control" asp-for="Input.OldPassword" autocomplete="current-password" aria-required="true" />
                    <partial name="_PasswordToggle" />
                </div>
                <span class="tbx-field-error" asp-validation-for="Input.OldPassword"></span>
            </div>
            <div class="tbx-field">
                <label class="tbx-field-label" asp-for="Input.NewPassword">@T["Account.Field.NewPassword"]</label>
                <div class="tbx-password">
                    <input class="form-control" asp-for="Input.NewPassword" autocomplete="new-password" aria-required="true" aria-describedby="new-password-hint" />
                    <partial name="_PasswordToggle" />
                </div>
                <span class="tbx-field-hint" id="new-password-hint">@T["Account.Password.Rules"]</span>
                <span class="tbx-field-error" asp-validation-for="Input.NewPassword"></span>
            </div>
            <div class="tbx-field">
                <label class="tbx-field-label" asp-for="Input.ConfirmPassword">@T["Account.Field.ConfirmNewPassword"]</label>
                <div class="tbx-password">
                    <input class="form-control" asp-for="Input.ConfirmPassword" autocomplete="new-password" />
                    <partial name="_PasswordToggle" />
                </div>
                <span class="tbx-field-error" asp-validation-for="Input.ConfirmPassword"></span>
            </div>
            <div class="account-actions">
                <button type="submit" class="btn btn-primary">@T["Account.Password.Submit"]</button>
            </div>
        </form>
    }
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
