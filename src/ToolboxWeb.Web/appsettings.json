{
  "ConnectionStrings": {
    "DefaultConnection": "DataSource=app.db;Cache=Shared"
  },
  "Jira": {
    "DefaultBaseUrl": "https://task.ascvn.com.vn",
    "SessionTimeoutHours": 4
  },
  "SchemaCompare": {
    "AllowedHosts": [],
    "ConnectTimeoutSeconds": 10,
    "CommandTimeoutSeconds": 180,
    "DatabaseLockTimeoutSeconds": 60,
    "ExtractTimeoutSeconds": 900,
    "TotalTimeoutMinutes": 30,
    "MappingReconciliationTimeoutSeconds": 120,
    "ProgressHeartbeatSeconds": 30,
    "VerifyExtraction": false,
    "ResultTtlMinutes": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "File": {
      "Directory": "logs",
      "FileName": "toolboxweb",
      "MaxFileSizeMb": 32,
      "RetainedDays": 7,
      "LogLevel": {
        "Default": "Warning",
        "ToolboxWeb.Web.Infrastructure.DacFx": "Information",
        "ToolboxWeb.Web.Services.DacFxSchemaCompareService": "Information",
        "ToolboxWeb.Web.Services.SchemaCompareSessionStore": "Information"
      }
    }
  },
  "AllowedHosts": "*"
}
